---
export const prerender = false;

import { api, getCI, getToken, getUserIdFromToken } from '@/lib/api';

const token = getToken(Astro.cookies);
const userId = getUserIdFromToken(token);
const authCi = getCI(Astro.cookies)?.trim() || null;

const normalizeCi = (value: string | null | undefined) =>
	value
		? value.toString().trim().toUpperCase().replace(/^[VEJPG]-?/i, '').replace(/\s+/g, '')
		: '';

if (!userId || !authCi) {
	return Astro.redirect('/login');
}

try {
	const response = await api(`/medical/patient/user/${userId}`, { method: 'GET' }, Astro.cookies);
	if (!response.ok) {
		return Astro.redirect('/no-encontrado');
	}

	const json = await response.json();
	const patients = Array.isArray(json?.data) ? json.data : [];

	if (patients.length === 0) {
		return Astro.redirect('/no-encontrado');
	}

	const normalizedAuthCi = normalizeCi(authCi);
	const primaryPatient = patients.find((p: any) => {
		const patientCi = normalizeCi(p?.ci);
		const linkedUserCi = normalizeCi(p?.user?.ci);
		return patientCi === normalizedAuthCi || linkedUserCi === normalizedAuthCi;
	});

	if (!primaryPatient) {
		return Astro.redirect('/no-encontrado');
	}
	return Astro.redirect(`/modules/pacient/${primaryPatient.id}/overview`);
} catch (error) {
	console.error('[pacient/index] Error resolving patient by user:', error);
	return Astro.redirect('/error-servidor');
}
---

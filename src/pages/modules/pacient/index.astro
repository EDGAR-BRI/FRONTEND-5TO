---
export const prerender = false;

import { api, getToken, getUserIdFromToken } from '@/lib/api';

const token = getToken(Astro.cookies);
const userId = getUserIdFromToken(token);

if (!userId) {
  return Astro.redirect('/login');
}

try {
  const res = await api(`/medical/patient/user/${userId}`, { method: 'GET' }, Astro.cookies);

  if (!res.ok) {
    return Astro.redirect('/no-encontrado');
  }

  const json = await res.json();
  const patient = json?.data;

  if (!patient?.id) {
    return Astro.redirect('/no-encontrado');
  }

  return Astro.redirect(`/modules/pacient/${patient.id}/overview`);
} catch (error) {
  console.error('[pacient/index] Error resolving patient for user:', error);
  return Astro.redirect('/error-servidor');
}

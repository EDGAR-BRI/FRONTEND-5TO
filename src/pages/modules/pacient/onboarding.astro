---
import Layout from "@/layouts/Layout.astro";
import RegisterPatientForm from "@/components/react/RegisterPatientForm";


const userId = Astro.url.searchParams.get("userId");
---

<Layout title="Completar Ficha Médica">
    <main
        class="min-h-screen bg-[#f4f9ff] py-10 px-4 flex justify-center items-start overflow-y-auto"
    >
        <div class="w-full max-w-5xl">
            <RegisterPatientForm
                client:only="react"
                role="pacient"
                currentUserId={Number(userId)}
                onSuccessCallback={(newPatientId) => {
                    window.location.href = `/modules/pacient/${newPatientId}/overview`;
                }}
            />
        </div>
    </main>
</Layout>

---
import PacientLayout from "@/layouts/PacientLayout.astro";
import AppointmentBookingManager from "@/components/react/AppointmentBookingManager";
import { api, getCI, getToken, getUserIdFromToken } from "@/lib/api";

const pacient_id = Astro.params.pacient_id || "";

const coloresEstado: Record<string, string> = {
  Pendiente: "bg-amber-100 text-amber-700 border-amber-200",
  Confirmada: "bg-green-100 text-green-700 border-green-200",
  Cancelada: "bg-red-100 text-red-700 border-red-200",
  Finalizada: "bg-blue-100 text-blue-700 border-blue-200",
};

const token = getToken(Astro.cookies);
const userId = getUserIdFromToken(token);
const authCi = getCI(Astro.cookies)?.trim() || null;

const normalizeCi = (value: string | null | undefined) =>
  value
    ? value.toString().trim().toUpperCase().replace(/^[VEJPG]-?/i, "").replace(/\s+/g, "")
    : "";

if (!userId || !authCi) {
  return Astro.redirect('/login');
}

try {
  const selectedPatientRes = await api(`/medical/patient/${pacient_id}`, {}, Astro.cookies);

  if (!selectedPatientRes.ok) {
    return Astro.redirect('/no-encontrado');
  }

  const selectedPatientJson = await selectedPatientRes.json();
  const selectedPatient = selectedPatientJson?.data ?? null;

  if (!selectedPatient) {
    return Astro.redirect('/no-encontrado');
  }

  const selectedCi = normalizeCi(selectedPatient.ci || selectedPatient.user?.ci);
  const expectedCi = normalizeCi(authCi);

  if (selectedCi !== expectedCi) {
    const ownerPatientsRes = await api(`/medical/patient/user/${userId}`, {}, Astro.cookies);
    const ownerPatientsJson = ownerPatientsRes.ok ? await ownerPatientsRes.json() : null;
    const ownerPatients = Array.isArray(ownerPatientsJson?.data) ? ownerPatientsJson.data : [];
    const mainOwnerPatient = ownerPatients.find((patient: any) => {
      const patientCi = normalizeCi(patient?.ci);
      const linkedUserCi = normalizeCi(patient?.user?.ci);
      return patientCi === expectedCi || linkedUserCi === expectedCi;
    });

    if (!mainOwnerPatient) {
      return Astro.redirect('/no-encontrado');
    }

    return Astro.redirect(`/modules/pacient/${mainOwnerPatient.id}/schedule-appointment`);
  }
} catch (error) {
  console.error('[pacient/schedule-appointment] Error resolving patient by CI:', error);
  return Astro.redirect('/error-servidor');
}
---

<PacientLayout title="Agendar Cita | Paciente">
  <div class="p-6 md:p-8 space-y-6 min-w-0">
    <header
      class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
    >
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Agendamiento de Citas</h1>
        <p class="text-gray-500 mt-1">
          Gestiona y programa tus consultas médicas.
        </p>
      </div>

      <div
        class="flex flex-wrap gap-3 bg-white p-3 rounded-lg shadow-sm border border-gray-100"
      >
        <span class="text-sm text-gray-500 mr-2 font-medium">Estados:</span>
        {
          Object.keys(coloresEstado).map((estado) => (
            <div class="flex items-center gap-1.5">
              <div
                class={`w-3 h-3 rounded-full ${coloresEstado[estado].split(" ")[0]}`}
              />
              <span class="text-xs font-medium text-gray-600">{estado}</span>
            </div>
          ))
        }
      </div>
    </header>

    <AppointmentBookingManager 
      client:visible 
      role="pacient" 
      userId={pacient_id}
      context={{ patientId: pacient_id }}
    />
  </div>
</PacientLayout>

---
import PacientLayout from "@/layouts/PacientLayout.astro";
import AppointmentCalendar from "@/components/react/AppointmentCalendar";
import StaticCard from "@/components/react/primary/StaticCard";
import { FaCalendarPlus, FaCircleInfo } from "react-icons/fa6";
import AppointmentForm from "@/components/react/AppointmentForm";

const pacient_id = Astro.params.pacient_id || "";

const coloresEstado: Record<string, string> = {
  Pendiente: "bg-amber-100 text-amber-700 border-amber-200",
  Confirmada: "bg-green-100 text-green-700 border-green-200",
  Cancelada: "bg-red-100 text-red-700 border-red-200",
  Finalizada: "bg-blue-100 text-blue-700 border-blue-200",
};

const citas: any[] = [];
---

<PacientLayout title="Agendar Cita | Paciente">
  <div class="p-6 md:p-8 space-y-6 min-w-0">
    <header
      class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
    >
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Agendamiento de Citas</h1>
        <p class="text-gray-500 mt-1">
          Gestiona y programa tus consultas médicas.
        </p>
      </div>

      <div
        class="flex flex-wrap gap-3 bg-white p-3 rounded-lg shadow-sm border border-gray-100"
      >
        <span class="text-sm text-gray-500 mr-2 font-medium">Estados:</span>
        {
          Object.keys(coloresEstado).map((estado) => (
            <div class="flex items-center gap-1.5">
              <div
                class={`w-3 h-3 rounded-full ${coloresEstado[estado].split(" ")[0]}`}
              />
              <span class="text-xs font-medium text-gray-600">{estado}</span>
            </div>
          ))
        }
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 min-w-0">
      <StaticCard className="h-fit min-w-0">
        <h2
          class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2"
        >
          <FaCalendarPlus className="text-blue-600" /> Nueva Cita
        </h2>
        <AppointmentForm
          client:load
          createEndpoint="scheduling/appointment"
          role="pacient"
          userId={pacient_id}
          context={{ patientId: pacient_id }}
        />
      </StaticCard>

      <StaticCard
        className="lg:col-span-3 flex flex-col min-h-150 overflow-hidden"
      >
        <div class="overflow-x-auto w-full h-full">
          <div class="min-w-[800px] h-full">
            <AppointmentCalendar
              role="pacient"
              citas={citas}
              context={{ patientId: pacient_id }}
              client:load
              actions={[]}
            />
          </div>
        </div>
      </StaticCard>
    </div>
  </div>
</PacientLayout>

---
export const prerender = false;

import PacientLayout from '@/layouts/PacientLayout.astro';
import StaticCard from '@/components/react/primary/StaticCard';
import { Button } from '@/components/react/primary/Button';
import { Select } from '@/components/react/primary/Select';
import { Modal } from '@/components/react/primary/Modal';
import { FaPlus, FaUserPlus, FaUsers, FaUser, FaPhone, FaEnvelope, FaIdCard, FaTrash, FaEdit, FaCircleExclamation } from 'react-icons/fa6';
import { api, getUserIdFromToken, getToken } from '@/lib/api';

const inputClass = "w-full px-3 py-2 text-sm border border-primary-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white";
const labelClass = "text-xs font-semibold text-primary-700 uppercase mb-1 block";

const { pacient_id } = Astro.params;

let currentPatient: any = null;
let familyMembers: any[] = [];
let currentUserId: number | null = null;
let errorMessage: string | null = null;
let showError = false;
let hasLinkedAccount = false;

try {
    const token = getToken(Astro.cookies);
    if (token) {
        currentUserId = getUserIdFromToken(token);
    }
    
    // Obtener el paciente actual primero
    const patientRes = await api(`/medical/patient/${pacient_id}`, {}, Astro.cookies);
    if (patientRes.ok) {
        const patientJson = await patientRes.json();
        currentPatient = patientJson.data;
        
        // Si el paciente tiene un userId vinculado, buscar sus familiares
        const linkedUserId = currentPatient.userId;
        hasLinkedAccount = !!linkedUserId;
        
        if (linkedUserId) {
            const familyRes = await api(`/medical/patient/user/${linkedUserId}`, {}, Astro.cookies);
            if (familyRes.ok) {
                const familyJson = await familyRes.json();
                // Filtrar para excluir al paciente actual de la lista
                familyMembers = (familyJson.data || []).filter((p: any) => p.id !== currentPatient.id);
            }
        }
    }
} catch (error) {
    console.error("Error loading family:", error);
    errorMessage = "Error al cargar familiares";
    showError = true;
}

const currentPatientName = currentPatient?.user?.name || currentPatient?.info_patient?.name || currentPatient?.name || 'Paciente';
---

<PacientLayout title={`Mis Familiares - ${currentPatientName}`}>
    <div class="p-4 sm:p-6 lg:p-8 space-y-6 animate-fade-in">
        
        <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Mis Familiares</h1>
                <p class="text-gray-500 mt-1">Gestiona los pacientes vinculados a tu cuenta</p>
            </div>
            {hasLinkedAccount ? (
                <Button label="Agregar Familiar" variant="primary" id="openAddModal">
                    <FaPlus size={14} /> Agregar Familiar
                </Button>
            ) : (
                <div class="flex items-center gap-2 px-4 py-2 bg-amber-50 border border-amber-200 rounded-lg text-amber-700 text-sm">
                    <FaCircleExclamation size={16} />
                    <span>Cuenta no vinculada para gestionar familiares</span>
                </div>
            )}
        </header>

        {errorMessage && (
            <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
                {errorMessage}
            </div>
        )}

        <StaticCard className="bg-white! p-0! flex flex-col overflow-hidden">
            <div class="flex items-center justify-between px-5 py-4 border-b border-primary-200">
                <h2 class="text-heading-6 text-primary-800">
                    <FaUsers className="text-primary-500 mr-2 inline-block" />
                    Grupo Familiar
                </h2>
                <span class="text-body-xxs text-cool-gray-50">
                    {familyMembers.length} familiar{familyMembers.length !== 1 ? 'es' : ''}
                </span>
            </div>

            <div class="divide-y divide-primary-100">
                {familyMembers.length === 0 && (
                    <div class="p-8 text-center text-cool-gray-50">
                        <FaUser className="text-4xl mb-3 block mx-auto opacity-50" />
                        <p class="text-body-m">No tienes familiares registrados</p>
                        <p class="text-body-xs mt-1">Agrega familiares para gestionar sus citas y historial</p>
                    </div>
                )}

                {familyMembers.map((member: any) => (
                    <div class="px-5 py-4 hover:bg-primary-50 transition-colors">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center text-primary-600 font-bold text-lg">
                                    {member.info_patient?.name?.substring(0, 2).toUpperCase() || member.name?.substring(0, 2).toUpperCase() || 'XX'}
                                </div>
                                <div>
                                    <p class="text-body-m font-semibold text-primary-800">
                                        {member.info_patient?.name || member.name || 'Sin nombre'}
                                        {member.info_patient?.last_name ? ` ${member.info_patient.last_name}` : ''}
                                    </p>
                                    <div class="flex items-center gap-3 text-body-xxs text-cool-gray-50 mt-0.5">
                                        <span class="flex items-center gap-1">
                                            <FaIdCard className="inline" /> {member.info_patient?.ci || member.ci || 'Sin CI'}
                                        </span>
                                        {member.info_patient?.main_phone && (
                                            <span class="flex items-center gap-1">
                                                <FaPhone className="inline" /> {member.info_patient.main_phone}
                                            </span>
                                        )}
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <a href={`/modules/pacient/${member.id}/overview`} class="text-primary-600 hover:text-primary-800 text-body-xs font-medium">
                                    Ver perfil
                                </a>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </StaticCard>

    </div>

    <Modal id="addFamilyModal" title="Agregar Familiar" className="max-w-lg">
        <form id="addFamilyForm" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class={labelClass}>Nombre</label>
                    <input type="text" name="name" required placeholder="Nombre del familiar" class={inputClass} />
                </div>
                <div>
                    <label class={labelClass}>Apellido</label>
                    <input type="text" name="last_name" required placeholder="Apellido del familiar" class={inputClass} />
                </div>
            </div>
            
            <div>
                <label class={labelClass}>Cédula de Identidad</label>
                <input type="text" name="ci" required placeholder="V-12345678" class={inputClass} />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <Select 
                    label="Sexo" 
                    name="sex" 
                    required
                    options={[
                        { value: 'MALE', label: 'Masculino' },
                        { value: 'FEMALE', label: 'Femenino' }
                    ]}
                />
                <div>
                    <label class={labelClass}>Fecha de Nacimiento</label>
                    <input type="date" name="birth_date" required class={inputClass} />
                </div>
            </div>

            <div>
                <label class={labelClass}>Teléfono Principal</label>
                <input type="text" name="main_phone" placeholder="0412-123-4567" class={inputClass} />
            </div>

            <div>
                <label class={labelClass}>Teléfono Secundario</label>
                <input type="text" name="secondary_phone" placeholder="0414-123-4567" class={inputClass} />
            </div>

            <div>
                <label class={labelClass}>Correo Electrónico</label>
                <input type="email" name="email" placeholder="correo@ejemplo.com" class={inputClass} />
            </div>

            <div class="flex justify-end gap-3 mt-6">
                <Button label="Cancelar" variant="secondary" id="closeAddModal" />
                <Button label="Guardar" variant="primary" type="submit" />
            </div>
        </form>
    </Modal>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const openBtn = document.getElementById('openAddModal');
            const closeBtn = document.getElementById('closeAddModal');
            const modal = document.getElementById('addFamilyModal') as HTMLDialogElement;
            const form = document.getElementById('addFamilyForm') as HTMLFormElement;

            if (openBtn && modal) {
                openBtn.addEventListener('click', () => {
                    modal.showModal();
                });
            }

            if (closeBtn && modal) {
                closeBtn.addEventListener('click', () => {
                    modal.close();
                });
            }

            if (form) {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    
                    const formData = new FormData(form);
                    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Guardando...';
                    
                    const payload = {
                        infoPatient: {
                            ci: formData.get('ci'),
                            name: formData.get('name'),
                            last_name: formData.get('last_name'),
                            sex: formData.get('sex'),
                            birth_date: formData.get('birth_date'),
                            main_phone: formData.get('main_phone') || undefined,
                            secondary_phone: formData.get('secondary_phone') || undefined,
                            email: formData.get('email') || undefined,
                        }
                    };

                    try {
                        const token = document.cookie.split('; ').find(row => row.startsWith('auth_token='))?.split('=')[1];
                        
                        const response = await fetch('/api/v1/medical/patient', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${token}`
                            },
                            body: JSON.stringify(payload)
                        });

                        if (response.ok) {
                            window.location.reload();
                        } else {
                            const errorData = await response.json();
                            alert('Error al agregar familiar: ' + (errorData.message || errorData.error || 'Error desconocido'));
                        }
                    } catch (error) {
                        alert('Error al agregar familiar: ' + error);
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Guardar';
                    }
                });
            }
        });
    </script>
</PacientLayout>
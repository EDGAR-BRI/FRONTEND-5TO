---
import PacientLayout from "@/layouts/PatientLayout.astro";
import { BasicData } from "@/components/react/pacient/BasicData";
import { ProfileTabs } from "@/components/react/pacient/ProfileTabs";
import { FaCalendarDays, FaCircleExclamation, FaDroplet, FaPhone, FaUser, FaUserPen } from "react-icons/fa6";
import { api, getCI, getToken, getUserIdFromToken } from "@/lib/api";

const { pacient_id } = Astro.params;
const token = getToken(Astro.cookies);
const userId = getUserIdFromToken(token);
const authCi = getCI(Astro.cookies)?.trim() || null;

const normalizeCi = (value: string | null | undefined) =>
  value
    ? value.toString().trim().toUpperCase().replace(/^[VEJPG]-?/i, "").replace(/\s+/g, "")
    : "";

let patientData: any = null;
let infoPatientData: any = null;
let errorFetch = false;

try {
  const [patientRes, infoRes] = await Promise.all([
    api(`/medical/patient/${pacient_id}`, {}, Astro.cookies),
    api(`/medical/info-patient/patient/${pacient_id}`, {}, Astro.cookies),
  ]);

  if (patientRes.ok) {
    const json = await patientRes.json();
    patientData = json.data;
  }

  if (infoRes.ok) {
    const json = await infoRes.json();
    infoPatientData = json.data;
  }

  errorFetch = !patientData && !infoPatientData;

  if (errorFetch) {
    console.warn(`Paciente ${pacient_id} no encontrado en BD para el Perfil.`);
  }

  const selectedCi = normalizeCi(patientData?.ci || patientData?.user?.ci);
  const expectedCi = normalizeCi(authCi);

  if (!userId || !authCi || selectedCi !== expectedCi) {
    const ownerPatientsRes = await api(`/medical/patient/user/${userId}`, {}, Astro.cookies);
    const ownerPatientsJson = ownerPatientsRes.ok ? await ownerPatientsRes.json() : null;
    const raw = ownerPatientsJson?.data;
    const ownerPatients = Array.isArray(raw) ? raw : raw ? [raw] : [];
    const mainOwnerPatient = ownerPatients.find((patient: any) => {
      const patientCi = normalizeCi(patient?.ci);
      const linkedUserCi = normalizeCi(patient?.user?.ci);
      return patientCi === expectedCi || linkedUserCi === expectedCi;
    });

    if (!mainOwnerPatient) {
      return Astro.redirect('/no-encontrado');
    }

    return Astro.redirect(`/modules/pacient/${mainOwnerPatient.id}/profile`);
  }
} catch (error) {
  errorFetch = true;
  console.error("Error de conexión al cargar el perfil:", error);
}

const patientRecord = infoPatientData?.patient ?? patientData?.user ?? patientData ?? null;
const fullName = patientRecord?.name || "Paciente sin nombre";
const ci = patientRecord?.ci || patientData?.ci || "V-00000000";
const initials = fullName
  .split(" ")
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part[0]?.toUpperCase())
  .join("") || "P";

const birthDate = infoPatientData?.birth_date ? new Date(infoPatientData.birth_date) : null;
const age = birthDate
  ? Math.floor((Date.now() - birthDate.getTime()) / (365.25 * 24 * 60 * 60 * 1000))
  : null;

const formatDate = (value: string | Date | null | undefined) => {
  if (!value) return "No registrado";

  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) return "No registrado";

  return date.toLocaleDateString("es-VE", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
};

const profileStats = [
  { label: "Edad", value: age ?? "No registrada", icon: FaCalendarDays },
  { label: "Sexo", value: infoPatientData?.sex || "No registrado", icon: FaUser },
  { label: "Sangre", value: infoPatientData?.blood_type || "No registrada", icon: FaDroplet },
  { label: "Teléfono", value: infoPatientData?.main_phone || "No registrado", icon: FaPhone },
];
---

<PacientLayout title="Perfil del Paciente">
  <main class="min-h-screen w-full bg-[radial-gradient(circle_at_top_left,rgba(59,130,246,0.16),transparent_34%),linear-gradient(180deg,#f8fbff_0%,#eef4fb_100%)] px-4 py-6 md:px-6 md:py-8">
    <div class="mx-auto flex w-full max-w-350 flex-col gap-6">
      <header class="relative overflow-hidden rounded-[28px] border border-slate-200/80 bg-white/85 p-6 shadow-[0_18px_60px_rgba(15,23,42,0.08)] backdrop-blur md:p-8">
        <div class="absolute inset-0 bg-linear-to-r from-sky-50 via-transparent to-indigo-50 opacity-90" />
        <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex items-start gap-4 md:gap-5">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-sky-600 text-white shadow-lg shadow-sky-200">
              <FaUserPen className="h-8 w-8" />
            </div>

            <div class="space-y-2">
              <div class="flex flex-wrap items-center gap-2">
                <h1 class="text-3xl font-black tracking-tight text-slate-900 md:text-4xl">Mi Perfil</h1>
                {errorFetch && (
                  <span class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-amber-700">
                    <FaCircleExclamation className="h-3.5 w-3.5 text-amber-500" />
                    Sin datos completos
                  </span>
                )}
              </div>

              <div class="flex flex-wrap gap-2 text-xs font-semibold text-slate-500">
                <span class="rounded-full bg-slate-100 px-3 py-1">CI: {ci}</span>
                <span class="rounded-full bg-slate-100 px-3 py-1">Nacimiento: {formatDate(infoPatientData?.birth_date)}</span>
                <span class="rounded-full bg-slate-100 px-3 py-1">Última visita: {formatDate(patientData?.last_visit_at)}</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:w-auto lg:min-w-140">
            {profileStats.map((item) => {
              const Icon = item.icon;

              return (
                <div class="rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 shadow-sm">
                  <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.18em] text-slate-400">
                    <Icon className="h-3.5 w-3.5 text-sky-500" />
                    {item.label}
                  </div>
                  <p class="mt-2 text-sm font-bold text-slate-900">{item.value}</p>
                </div>
              );
            })}
          </div>
        </div>
      </header>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[390px_minmax(0,1fr)]">
        <aside class="flex flex-col">
          <BasicData client:visible patientId={pacient_id as string} initialData={infoPatientData} />
        </aside>

        <section class="flex flex-col">
          <ProfileTabs client:visible patientId={pacient_id as string} initialData={infoPatientData} />
        </section>
      </div>
    </div>
  </main>
</PacientLayout>

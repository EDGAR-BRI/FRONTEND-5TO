---
import PacientLayout from "@/layouts/PacientLayout.astro";
import { BasicData } from "@/components/react/pacient/BasicData";
import { ProfileTabs } from "@/components/react/pacient/ProfileTabs";
import { FaUserPen } from "react-icons/fa6";

const { pacient_id } = Astro.params;
---

<PacientLayout title="Perfil del Paciente">
  <main class="p-4 md:p-6 bg-[#f4f9ff] min-h-screen w-full">
    <header
      class="w-full mb-8 flex items-center gap-4 bg-white p-6 rounded-lg shadow-sm border border-primary-200 transition-all hover:border-primary-400"
    >
      <div class="bg-blue-100 p-3 rounded-xl">
        <FaUserPen className="w-8 h-8 text-blue-600" />
      </div>
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Mi Perfil</h1>
        <p class="text-slate-500 text-sm font-medium">
          Gestiona tu información personal y médica.
        </p>
      </div>
    </header>

    <div
      class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-8 w-full items-stretch"
    >
      <aside class="flex flex-col h-full">
        <BasicData client:load patientId={pacient_id as string} />
      </aside>

      <section class="flex flex-col h-full">
        <ProfileTabs client:load patientId={pacient_id as string} />
      </section>
    </div>
  </main>
</PacientLayout>

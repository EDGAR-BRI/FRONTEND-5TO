---
import PacientLayout from "@/layouts/PacientLayout.astro";
import { BasicData } from "@/components/react/pacient/BasicData";
import { ProfileTabs } from "@/components/react/pacient/ProfileTabs";
import { FaUserPen, FaCircleExclamation } from "react-icons/fa6";
import { api } from "@/lib/api";

const { pacient_id } = Astro.params;

let patientData: any = null;
let errorFetch = false;

// 1. Buscamos los datos reales del paciente en el servidor
try {
  const res = await api(`/medical/patient/${pacient_id}`, {}, Astro.cookies);
  if (res.ok) {
    const json = await res.json();
    patientData = json.data;
  } else {
    errorFetch = true;
    console.warn(`Paciente ${pacient_id} no encontrado en BD para el Perfil.`);
  }
} catch (error) {
  errorFetch = true;
  console.error("Error de conexión al cargar el perfil:", error);
}

// 2. Preparamos el objeto con Fallbacks por si la BD está vacía (Mock)
const patientInfo = {
  id: pacient_id,
  userId: patientData?.userId || null,
  name: patientData?.user?.name || "Usuario de Prueba",
  ci: patientData?.user?.ci || "V-00000000",
  bloodType: patientData?.tipo_sangre || "",
  medicalHistory: patientData?.medical_history || "",
  email: patientData?.user?.email || "", 
  phone: patientData?.user?.phone || "",
};
---

<PacientLayout title="Perfil del Paciente">
  <main class="p-4 md:p-6 bg-[#f4f9ff] min-h-screen w-full">
    
    <header class="w-full mb-8 flex items-center gap-4 bg-white p-6 rounded-lg shadow-sm border border-primary-200 transition-all hover:border-primary-400">
      <div class="bg-blue-100 p-3 rounded-xl shrink-0">
        <FaUserPen className="w-8 h-8 text-blue-600" />
      </div>
      <div class="flex-1">
        <h1 class="text-2xl font-bold text-slate-800">Mi Perfil</h1>
        <p class="text-slate-500 text-sm font-medium">
          Gestiona tu información personal y médica.
        </p>
      </div>
      
      {/* Aviso visual si estamos usando Mock Data */}
      {errorFetch && (
        <div class="hidden sm:flex items-center gap-2 bg-amber-50 text-amber-700 px-4 py-2 rounded-lg border border-amber-200 text-sm font-medium">
          <FaCircleExclamation className="text-amber-500" />
          Modo Prueba (Sin BD)
        </div>
      )}
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-8 w-full items-stretch">
      <aside class="flex flex-col h-full">
        <BasicData client:load patientId={pacient_id as string} />
      </aside>

      <section class="flex flex-col h-full">
        <ProfileTabs client:load patientId={pacient_id as string} />
      </section>
    </div>
  </main>
</PacientLayout>
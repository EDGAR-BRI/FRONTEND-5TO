---
import ReceptionistLayout from "@/layouts/ReceptionistLayout.astro";
import AppointmentBookingManager from "@/components/react/AppointmentBookingManager";
import { FaCalendarPlus } from "react-icons/fa6";

const { receptionist_id } = Astro.params;

const coloresEstado: Record<string, string> = {
  Pendiente: "bg-amber-100 text-amber-700 border-amber-200",
  Confirmada: "bg-green-100 text-green-700 border-green-200",
  Cancelada: "bg-red-100 text-red-700 border-red-200",
  Finalizada: "bg-blue-100 text-blue-700 border-blue-200",
};
---

<ReceptionistLayout title="Agendar Cita | Paciente">
  <div class="p-6 md:p-8 space-y-6 min-w-0">
    <header
      class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
    >
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Agendamiento de Citas</h1>
        <p class="text-gray-500 mt-1">
          Gestiona y programa tus consultas médicas.
        </p>
      </div>

      <div class="flex items-center gap-4">
        <a 
          href={`/modules/receptionist/${receptionist_id}/register-patient`}
          class="inline-flex items-center justify-center gap-2 bg-primary text-white hover:bg-primary-600 px-4 py-2.5 rounded-xl text-sm font-medium transition-all shadow-sm whitespace-nowrap focus-visible:ring-[3px] focus-visible:ring-primary-300"
        >
          <FaCalendarPlus />
          Agregar Paciente
        </a>
      </div>

      <div
        class="flex flex-wrap gap-3 bg-white p-3 rounded-lg shadow-sm border border-gray-100"
      >
        <span class="text-sm text-gray-500 mr-2 font-medium">Estados:</span>
        {
          Object.keys(coloresEstado).map((estado) => (
            <div class="flex items-center gap-1.5">
              <div
                class={`w-3 h-3 rounded-full ${coloresEstado[estado].split(" ")[0]}`}
              />
              <span class="text-xs font-medium text-gray-600">{estado}</span>
            </div>
          ))
        }
      </div>
    </header>

    <AppointmentBookingManager 
      client:visible 
      role="receptionist" 
      context={{ receptionist_id }} 
    />
  </div>
</ReceptionistLayout>

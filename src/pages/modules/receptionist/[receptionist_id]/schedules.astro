---

<script>
  function scrollToCalendar() {
    const params = new URLSearchParams(window.location.search);
    if (params.get("view") !== "day") return;
    const el = document.getElementById("calendar");
    if (!el) return;
    // getBoundingClientRect().top is viewport-relative. Add window.scrollY to get absolute document position.
    const absoluteTop = el.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({ top: absoluteTop, behavior: "smooth" });
  }

  // After Astro ClientRouter navigation (view transitions)
  document.addEventListener("astro:page-load", () =>
    setTimeout(scrollToCalendar, 200),
  );
  // On direct page load, wait for full render+hydration before computing positions
  window.addEventListener("load", () => setTimeout(scrollToCalendar, 200));
</script>

<ReceptionistLayout title="Horarios – Recepción">

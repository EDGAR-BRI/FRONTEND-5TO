    >
      <h2 class="text-heading-6 text-primary-800">
        <FaTableCellsLarge className="text-primary-500 mr-2 inline-block" />
        Turnos de la semana
      </h2>
      <span class="text-body-xxs text-cool-gray-50">Ciclo semanal vigente</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-body-xs">
        <thead>
          <tr
            class="text-left text-cool-gray-50 border-b border-primary-100 bg-primary-50"
          >
            <th class="px-4 py-2.5 font-semibold">Médico</th>
            <th class="px-4 py-2.5 font-semibold">Especialidad</th>
            <th class="px-4 py-2.5 font-semibold">Lun</th>
            <th class="px-4 py-2.5 font-semibold">Mar</th>
            <th class="px-4 py-2.5 font-semibold">Mié</th>
            <th class="px-4 py-2.5 font-semibold">Jue</th>
            <th class="px-4 py-2.5 font-semibold">Vie</th>
            {Object.values(shiftsByDoctorId).some(sh => sh.some(s => s.dayOfWeek === 6)) && (
              <th class="px-4 py-2.5 font-semibold">Sáb</th>
            )}
            {Object.values(shiftsByDoctorId).some(sh => sh.some(s => s.dayOfWeek === 0)) && (
              <th class="px-4 py-2.5 font-semibold">Dom</th>
            )}
          </tr>
        </thead>
        <tbody class="divide-y divide-primary-100">
          {
            (() => {
              const allShifts = Object.values(shiftsByDoctorId).flat();
              const hasSat = allShifts.some(s => s.dayOfWeek === 6);
              const hasSun = allShifts.some(s => s.dayOfWeek === 0);
              const daysToRender = [1, 2, 3, 4, 5];
              if (hasSat) daysToRender.push(6);
              if (hasSun) daysToRender.push(0);

              return doctors.map((doc) => {
                const shifts = shiftsByDoctorId[doc.id] ?? [];
                const byDay: { [key: number]: string } = {};
                for (const s of shifts) {
                  byDay[s.dayOfWeek] = `${s.startsAt}–${s.endsAt}`;
                }

                return (
                  <tr class="hover:bg-primary-50 transition-colors">
                    <td class="px-4 py-3 font-semibold text-primary-800">
                      {doc.user.name}
                    </td>
                    <td class="px-4 py-3 text-cool-gray-60">{doc.specialty.name}</td>
                    {daysToRender.map((d) => (
                      <td class="px-4 py-3">
                        {byDay[d] ? (
                          <span class="font-mono text-primary-700 text-body-xxs">
                            {byDay[d]}
                          </span>
                        ) : (
                          <span class="text-cool-gray-30">—</span>
                        )}
                      </td>
                    ))}
                  </tr>
                );
              });
            })()
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- ─── Interactive calendar ────────────────────────────────────────────── -->
  <div
    id="calendar"
    class="bg-white rounded-xl border border-primary-200 shadow-sm p-5 mt-4"
  >
    <div class="mb-4">
      <h2 class="text-heading-6 text-primary-800">
        <FaCalendarWeek className="text-primary-500 mr-2 inline-block" />
        Vista de citas por médico
      </h2>
      <p class="text-body-xs text-cool-gray-50 mt-0.5">
        Las franjas azules representan el turno programado. Haz clic en una cita
        para ver detalles.
      </p>
    </div>

    <DoctorScheduleCalendar
      client:only="react"
      doctors={doctors}
      allSchedules={allDoctorsSchedules}
      allAvailabilities={allAvailabilities}
      heightPx={620}
      initialView={initialView}
    />
  </div>
</div>
</ReceptionistLayout>

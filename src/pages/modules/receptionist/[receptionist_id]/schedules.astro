---
import ReceptionistLayout from '@/layouts/ReceptionistLayout.astro';
import { ReceptionistStatsSummary } from '@/components/react/receptionist/ReceptionistStatsSummary';
import DoctorScheduleCalendarWrapper from '@/components/react/DoctorScheduleCalendarWrapper';
import {
  FaArrowLeft,
  FaCalendarPlus,
  FaSliders,
} from 'react-icons/fa6';

const { receptionist_id: _receptionist_id } = Astro.params;
const viewParam = Astro.url.searchParams.get('view');
const initialView =
  viewParam === 'day' || viewParam === 'agenda' ? viewParam : 'week';
---

<script>
  function scrollToCalendar() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('view') !== 'day') return;
    const el = document.getElementById('calendar');
    if (!el) return;
    const absoluteTop = el.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({ top: absoluteTop, behavior: 'smooth' });
  }

  document.addEventListener('astro:page-load', () =>
    setTimeout(scrollToCalendar, 200),
  );
  window.addEventListener('load', () => setTimeout(scrollToCalendar, 200));
</script>

<ReceptionistLayout title="Horarios – Recepción">
  <div class="p-4 sm:p-6 lg:p-8 space-y-6 animate-fade-in w-full min-w-0 overflow-x-hidden">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="overview" class="text-primary-500 hover:text-primary-700 text-body-xs font-medium transition-colors">
            <FaArrowLeft className="mr-1 inline-block" />Dashboard
          </a>
          <span class="text-cool-gray-30">/</span>
          <span class="text-body-xs text-cool-gray-50">Horarios</span>
        </div>
        <h1 class="text-heading-4 text-primary-800">Gestión de Horarios</h1>
        <p class="text-body-s text-cool-gray-50 mt-0.5">
          Turnos programados por médico · Ciclo activo de la semana
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <a
          href="manage-schedules"
          class="shrink-0 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-white border border-primary-200 text-primary-700 text-button-s font-semibold hover:bg-primary-50 transition-colors shadow-sm"
        >
          <FaSliders />
          Configurar ciclos
        </a>
        <a
          href="appointments"
          class="shrink-0 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-primary-600 text-white text-button-s font-semibold hover:bg-primary-700 transition-colors shadow-sm"
        >
          <FaCalendarPlus />
          Nueva cita
        </a>
      </div>
    </div>

    <ReceptionistStatsSummary client:visible />
    <br>
    <DoctorScheduleCalendarWrapper client:load initialView={initialView} />
  </div>
</ReceptionistLayout>

    client:load
  />
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- ─── Doctor shift reference table ──────────────────────────────────── -->
  <div
    class="bg-white rounded-xl border mt-4 border-primary-200 shadow-sm overflow-hidden"
  >

// ─── Mock data based on DB schema ───────────────────────────────────────────
// UserDoctor → User join gives us name + specialty
// ScheduleCycle → ScheduleWeek → ScheduleDay gives us shift windows per employee
// Appoinment + Form → User gives us booked appointments per doctor

const doctors = await getActuallyAvailableDrs();

const allDoctorsSchedulesNested = await Promise.all(doctors.map(d => getDoctorSchedules(d.id)));
const allDoctorsSchedules = allDoctorsSchedulesNested.flat();

const allAvailabilitiesNested = await Promise.all(
  allDoctorsSchedules.map(s => getDoctorAvailabilitiesByScheduleId(s.id))
);
const allAvailabilities = allAvailabilitiesNested.flat();

const today = new Date();
const currentDayOfWeek = today.getDay();
const diffToMonday = currentDayOfWeek === 0 ? -6 : 1 - currentDayOfWeek;
const monday = new Date(today);
monday.setDate(today.getDate() + diffToMonday);
monday.setHours(0,0,0,0);

const datesOfWeek = Array.from({ length: 7 }).map((_, i) => {
    const d = new Date(monday);
    d.setDate(monday.getDate() + i);
    return d;
});

const shiftsByDoctorId: Record<number, { dayOfWeek: number; startsAt: string; endsAt: string }[]> = {};

for (const doc of doctors) {
    const schedules = allDoctorsSchedules.filter(s => s.doctorId === doc.id);
    const docShifts: { dayOfWeek: number; startsAt: string; endsAt: string }[] = [];

    for (let i = 0; i < 7; i++) {
        const date = datesOfWeek[i];
        const dateUTC = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate(), 0, 0, 0, 0));
        const dayOfWeek = date.getDay();

        const activeSchedule = schedules
            .map(s => ({ ...s, _start: new Date(s.period_start), _end: s.period_end ? new Date(s.period_end) : null }))
            .filter(s => s._start <= dateUTC && (s._end === null || s._end >= dateUTC))
            .sort((a, b) => b._start.getTime() - a._start.getTime())[0];

        if (activeSchedule) {
            const availabilities = allAvailabilities.filter(a => a.doctorScheduleId === activeSchedule.id && a.day_of_week === dayOfWeek);
            availabilities.forEach(a => {
                docShifts.push({
                    dayOfWeek: a.day_of_week,
                    startsAt: convertirAHHMM(a.start_time),
                    endsAt: convertirAHHMM(a.end_time)
                });
            });
        }
    }
    shiftsByDoctorId[doc.id] = docShifts;
}


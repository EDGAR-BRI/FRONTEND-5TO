---
import ReceptionistLayout from '@/layouts/ReceptionistLayout.astro';
import { InvoiceManagement } from '@/components/react/receptionist/InvoiceManagement';
import { getInvoices } from '@/lib/services/finance/invoice/invoice.service'

const { receptionist_id } = Astro.params;
const facturas = await getInvoices().catch(() => []);

---

<ReceptionistLayout title="Facturación">
    <InvoiceManagement 
        client:load 
        receptionistId={receptionist_id!} 
        initialInvoices={facturas} 
    />
</ReceptionistLayout>
const quickActions = [
  { label: 'Registrar paciente', icon: FaUserPlus, href: 'register-patient', color: 'from-primary-500 to-primary-700' },
  { label: 'Agendar cita', icon: FaCalendarPlus, href: 'appointments', color: 'from-teal-500 to-teal-700' },
  { label: 'Gestionar pagos', icon: FaCreditCard, href: 'payment', color: 'from-violet-500 to-violet-700' },
  { label: 'Configurar horarios', icon: FaClock, href: 'manage-schedules', color: 'from-orange-400 to-orange-600' },

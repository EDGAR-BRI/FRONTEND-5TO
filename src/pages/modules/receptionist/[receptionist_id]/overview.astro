---
import ReceptionistLayout from '@/layouts/ReceptionistLayout.astro';
import {
	ReceptionistStatsSummary,
	type StatItem,
} from '@/components/react/receptionist/ReceptionistStatsSummary';
import StaticCard from '@/components/react/primary/StaticCard';


const quickActions = [
  { label: 'Registrar paciente', icon: 'fa-solid fa-user-plus', href: 'register-patient', color: 'from-primary-500 to-primary-700' },
  { label: 'Agendar cita', icon: 'fa-solid fa-calendar-plus', href: 'appointments', color: 'from-teal-500 to-teal-700' },
  { label: 'Gestionar pagos', icon: 'fa-solid fa-credit-card', href: 'payment', color: 'from-violet-500 to-violet-700' },
  { label: 'Configurar horarios', icon: 'fa-solid fa-clock', href: 'manage-schedules', color: 'from-orange-400 to-orange-600' },
];

const paymentBreakdown = [
  { method: 'Efectivo (USD)', amount: '$540', pct: 44, color: 'bg-primary-500' },
  { method: 'Tarjeta débito', amount: '$380', pct: 31, color: 'bg-teal-500' },
  { method: 'Pago Móvil (VES)', amount: '$200', pct: 16, color: 'bg-violet-500' },
  { method: 'Zelle', amount: '$120', pct: 9, color: 'bg-orange-400' },
];
---

<ReceptionistLayout title={`Dashboard – ${receptionist.fullName}`}>
  <div class="p-4 sm:p-6 lg:p-8 space-y-10 animate-fade-in">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-gradient-to-br from-teal-500 to-teal-700 flex items-center justify-center text-white font-bold text-xl shadow-md select-none flex-shrink-0">
          {receptionist.avatarInitials}
        </div>
        <div>
          <p class="text-body-s text-primary-700 font-medium">Panel de recepción</p>
          <h1 class="text-heading-4 text-primary-800 leading-tight">{receptionist.fullName}</h1>
          <p class="text-body-xs text-cool-gray-50 mt-0.5">
            <i class="fa-solid fa-id-card mr-1"></i>{receptionist.ci}
            &nbsp;·&nbsp;
            <i class="fa-solid fa-user-tie mr-1"></i>{receptionist.role}
            &nbsp;·&nbsp;
            <i class="fa-regular fa-clock mr-1"></i>Turno: {receptionist.shift}
          </p>
        </div>
      </div>

      <div class="flex-shrink-0 flex items-center gap-2 bg-white border border-primary-200 rounded-xl px-4 py-3 shadow-sm">
        <i class="fa-solid fa-calendar-day text-primary-500 text-lg"></i>
        <div>
          <p class="text-body-xxs text-cool-gray-50 leading-none">Hoy</p>
          <p class="text-subtitle-s text-primary-800 font-semibold">{todayStr}</p>
        </div>
      </div>
    </div>

    <ReceptionistStatsSummary client:load stats={stats} />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-8">
      
      <div class="lg:col-span-2 space-y-6">
        <StaticCard>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-heading-6 text-primary-800">Agenda de hoy</h2>
            <a href="/appointments" class="text-body-xs font-medium text-primary-600 hover:underline">Ver todo</a>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-body-xs font-semibold text-cool-gray-50 uppercase tracking-wider border-b border-primary-100">
                  <th class="pb-3 px-2">Hora</th>
                  <th class="pb-3 px-2">Paciente</th>
                  <th class="pb-3 px-2">Especialidad</th>
                  <th class="pb-3 px-2 text-right">Estado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-primary-50">
                {agenda.map((item) => (
                  <tr class="text-body-s hover:bg-primary-50/50 transition-colors">
                    <td class="py-3 px-2 font-medium text-primary-700">{item.time}</td>
                    <td class="py-3 px-2 text-primary-800">{item.patient}</td>
                    <td class="py-3 px-2 text-cool-gray-60">{item.specialty}</td>
                    <td class="py-3 px-2 text-right">
                      <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${item.statusClass}`}>
                        {item.status.toUpperCase()}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </StaticCard>
      </div>

      <div class="space-y-6">
        <StaticCard>
          <h3 class="text-subtitle-m text-primary-800 mb-4">Acciones rápidas</h3>
          <div class="grid grid-cols-2 gap-3">
            {quickActions.map(action => (
              <a href={action.href} class="flex flex-col items-center p-3 rounded-lg bg-white border border-primary-100 hover:border-primary-300 transition-colors group">
                <i class={`${action.icon} text-xl mb-2 text-primary-500 group-hover:scale-110 transition-transform`}></i>
                <span class="text-body-xxs text-center font-medium text-primary-700">{action.label}</span>
              </a>
            ))}
          </div>
        </StaticCard>

        <StaticCard>
          <h3 class="text-subtitle-m text-primary-800 mb-4">Métodos de pago (Hoy)</h3>
          <div class="space-y-4">
            {paymentBreakdown.map(item => (
              <div>
                <div class="flex justify-between text-body-xs mb-1">
                  <span class="text-cool-gray-60">{item.method}</span>
                  <span class="font-semibold text-primary-800">{item.amount}</span>
                </div>
                <div class="w-full bg-primary-50 rounded-full h-1.5">
                  <div class={`${item.color} h-1.5 rounded-full`} style={`width: ${item.pct}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </StaticCard>
      </div>
    </div>
  </div>
</ReceptionistLayout>

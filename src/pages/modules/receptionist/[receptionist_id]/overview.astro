    statusClass: 'bg-yellow-100 text-warning border-yellow-200',
    price: '$60',
    paid: false,
  },
  {
    id: 'APT-024',
    time: '09:30',
    patient: 'Ramón Díaz Solano',
    specialty: 'Traumatología',
    doctor: 'Dr. Héctor Torres',
    reason: 'Dolor lumbar persistente',
    type: 'Presencial',
    status: 'Confirmada',
    statusClass: 'bg-yellow-100 text-warning border-yellow-200',
    price: '$55',
    paid: false,
  },
  {
    id: 'APT-025',
    time: '10:00',
    patient: 'Carmen Rosa Fuentes',
    specialty: 'Pediatría',
    doctor: 'Dra. Valentina Ríos',
    reason: 'Vacunación',
    type: 'Presencial',
    status: 'Sin Confirmar',
    statusClass: 'bg-cool-gray-10 text-cool-gray-60 border-cool-gray-30',
    price: '$30',
    paid: false,
  },
  {
    id: 'APT-026',
    time: '10:30',
    patient: 'Luis Eduardo Blanco',
    specialty: 'Medicina General',
    doctor: 'Dr. Carlos Méndez',
    reason: 'Revisión de exámenes',
    type: 'Presencial',
    status: 'Sin Confirmar',
    statusClass: 'bg-cool-gray-10 text-cool-gray-60 border-cool-gray-30',
    price: '$40',
    paid: false,
  },

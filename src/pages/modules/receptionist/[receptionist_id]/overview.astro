---
import ReceptionistLayout from '@/layouts/ReceptionistLayout.astro';
import PaymentMethodsBox from '@/components/astro/PaymentMethodsBox.astro';
import TodaysScheduleTable from '@/components/react/receptionist/TodaysScheduleTable';
import { getUserName, getCI } from "@/lib/api";
import { getInitials } from "@/utils/helper_functions"
import {
	ReceptionistStatsSummary,
	type StatItem,
} from '@/components/react/receptionist/ReceptionistStatsSummary';
import StaticCard from '@/components/react/primary/StaticCard';
import { // Eliminable?
  FaCalendarCheck,
  FaUserPlus,
  FaMoneyBillWave,
  FaFileInvoiceDollar,
  FaIdCard,
  FaUserTie,
  FaRegClock,
  FaCalendarDay,
  FaCalendarPlus,
  FaCreditCard,
  FaClock,
} from 'react-icons/fa6';

const { receptionist_id } = Astro.params;
const receptionist = {
  id: receptionist_id ?? '008',
  fullName: getUserName(Astro.cookies),
  ci: getCI(Astro.cookies),
  role: 'Recepcionista',
  avatarInitials: getInitials(getUserName(Astro.cookies)),
};

const todayStr = new Date().toISOString().split('T')[0];

const quickActions = [
  { label: 'Registrar paciente', icon: FaUserPlus, href: 'register-patient', color: 'from-primary-500 to-primary-700' },
  { label: 'Agendar cita', icon: FaCalendarPlus, href: 'appointments', color: 'from-teal-500 to-teal-700' },
  { label: 'Gestionar pagos', icon: FaCreditCard, href: 'payment', color: 'from-violet-500 to-violet-700' },
  { label: 'Configurar horarios', icon: FaClock, href: 'manage-schedules', color: 'from-orange-400 to-orange-600' },
];
---

<ReceptionistLayout title={`Dashboard – ${receptionist.fullName}`}>
  <div class="p-4 sm:p-6 lg:p-8 space-y-10 animate-fade-in">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-linear-to-br from-teal-500 to-teal-700 flex items-center justify-center text-white font-bold text-xl shadow-md select-none shrink-0">
          {receptionist.avatarInitials}
        </div>
        <div>
          <p class="text-body-s text-primary-700 font-medium">Panel de recepción</p>
          <h1 class="text-heading-4 text-primary-800 leading-tight">{receptionist.fullName}</h1>
          <p class="text-body-xs text-cool-gray-50 mt-0.5">
            <FaIdCard className="mr-1 inline-block" />{receptionist.ci}
            &nbsp;·&nbsp;
            <FaUserTie className="mr-1 inline-block" />{receptionist.role}
          </p>
        </div>
      </div>

      <div class="shrink-0 flex items-center gap-2 bg-white border border-primary-200 rounded-xl px-4 py-3 shadow-sm">
        <FaCalendarDay className="text-primary-500 text-lg" />
        <div>
          <p class="text-body-xxs text-cool-gray-50 leading-none">Hoy</p>
          <p class="text-subtitle-s text-primary-800 font-semibold">{todayStr}</p>
        </div>
      </div>
    </div>

    <ReceptionistStatsSummary client:visible/>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-8">
      
      <div class="lg:col-span-2 space-y-6 border border-primary-100 rounded-xl">
        <StaticCard>
          <TodaysScheduleTable client:visible />
        </StaticCard>
      </div>

      <div class="space-y-6">
        <StaticCard>
          <h3 class="text-subtitle-m text-primary-800 mb-4">Acciones rápidas</h3>
          <div class="grid grid-cols-2 gap-3">
            {quickActions.map(({ icon: Icon, ...action }) => (
              <a href={action.href} class="flex flex-col items-center p-3 rounded-lg bg-white border border-primary-100 hover:border-primary-300 transition-colors group">
                <Icon className="text-xl mb-2 text-primary-500 group-hover:scale-110 transition-transform" />
                <span class="text-body-xxs text-center font-medium text-primary-700">{action.label}</span>
              </a>
            ))}
          </div>
        </StaticCard>

        <PaymentMethodsBox>
        </PaymentMethodsBox>
      </div>
    </div>
  </div>
</ReceptionistLayout>

// Recent payments — from Invoice + InvoicePayment + PaymentMethod tables
const recentPayments = [
  { id: 'INV-201', patient: 'Ana Sofía Parra', amount: '$40.00', method: 'Efectivo', currency: 'USD', date: '08:12 AM', status: 'Pagado', statusClass: 'bg-green-100 text-success' },
  { id: 'INV-202', patient: 'Jorge Luis Rivas', amount: '$80.00', method: 'Tarjeta débito', currency: 'USD', date: '08:47 AM', status: 'Pagado', statusClass: 'bg-green-100 text-success' },

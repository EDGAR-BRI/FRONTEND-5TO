---
import ReceptionistLayout from '@/layouts/ReceptionistLayout.astro';
import DoctorScheduleManager from '@/components/react/DoctorScheduleManager';
import { FaArrowLeft, FaSliders } from 'react-icons/fa6';

---

<ReceptionistLayout title="Configurar Horarios – Recepción">
  <div class="p-4 sm:p-6 lg:p-8 space-y-6 animate-fade-in">

    <!-- ─── Header ─────────────────────────────────────────────────────────── -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="schedules" class="text-primary-500 hover:text-primary-700 text-body-xs font-medium transition-colors">
            <FaArrowLeft className="mr-1 inline-block" />Vista global
          </a>
          <span class="text-cool-gray-30">/</span>
          <span class="text-body-xs text-cool-gray-50">Configurar</span>
        </div>
        <h1 class="text-heading-4 text-primary-800">
          <FaSliders className="text-primary-500 mr-2 inline-block" />
          Configurar Calendario Médico
        </h1>
        <p class="text-body-s text-cool-gray-50 mt-0.5">
          Define los ciclos semanales y días feriados por doctor.
        </p>
      </div>
    </div>

    <!-- ─── React Schedule Manager ────────────────────────────────────────── -->
    <DoctorScheduleManager
      client:only="react"
    />

  </div>
</ReceptionistLayout>

---
import MainLayout from "@/layouts/DoctorLayout.astro";

import { DoctorFinanceSummary } from "@/components/react/doctor/DoctorFinanceSummary";
import DashboardActions from "@/components/react/doctor/DashboardActions";
import UpcomingAppointments from "@/components/react/doctor/UpcomingAppointments";
import RecentResults from "@/components/react/doctor/RecentResults";
import SpecialtyChart from "@/components/react/doctor/ActivityChart";
import PatientStats from "@/components/react/doctor/PatientStats";


import { Avatar, AvatarFallback, AvatarImage } from "@/components/react/primary/Avatar";
import { Badge } from "@/components/react/primary/Badge";
import StaticCard from "@/components/react/primary/StaticCard";

import { FaArrowRight, FaHeart, FaIdCard, FaStar, FaUsers } from "react-icons/fa6";

const summary = {
  totalIncome: 15420.5,
  totalExpenses: 3240.2,
  netBalance: 12180.3,
  pendingPayments: 5,
};
---

<MainLayout>
  <div class="bg-slate-50 min-h-screen p-8 font-sans">

    <div class="mb-10">
      <StaticCard className="p-6">
        <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start">
          
          <Avatar className="w-20 h-20 sm:w-28 sm:h-28 shadow-md border-2 border-slate-100 shrink-0">
            <AvatarImage src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?q=80&w=256&auto=format&fit=crop" alt="Dra. Andrea Pérez" />
            <AvatarFallback className="bg-[#1e3a8a] text-white font-black text-3xl">AP</AvatarFallback>
          </Avatar>

          <div class="flex-1 text-center sm:text-left">
            <p class="text-[10px] sm:text-[11px] text-slate-400 font-black uppercase tracking-[0.2em] mb-1">
              Panel Médico Oficial
            </p>
            <h1 class="text-3xl sm:text-4xl font-black text-[#1e293b] leading-none mb-4">
              Dra. Andrea Pérez
            </h1>

            <div class="flex flex-wrap justify-center sm:justify-start gap-3">
              <Badge styles={{ bg: "bg-white", text: "text-slate-600", border: "border-slate-200" }} className="gap-2 px-4 py-1.5 shadow-sm">
				<FaIdCard size={16} className="text-blue-500 shrink-0" />
                <span class="font-bold">V-12.345.678</span>
              </Badge>
              <Badge styles={{ bg: "bg-white", text: "text-slate-600", border: "border-slate-200" }} className="gap-2 px-4 py-1.5 shadow-sm">
				<FaHeart size={16} className="text-red-500 shrink-0" />
                <span class="font-bold">O POSITIVO</span>
              </Badge>
              <Badge styles={{ bg: "bg-white", text: "text-slate-600", border: "border-slate-200" }} className="gap-2 px-4 py-1.5 shadow-sm">
				<FaStar size={16} className="text-yellow-500 shrink-0" />
                <span class="font-bold">CARDIÓLOGA</span>
              </Badge>
            </div>
          </div>
        </div>
      </StaticCard>
    </div>

    <DoctorFinanceSummary client:visible summary={summary} />
    
    <div class="mb-10">
      <h3 class="text-[11px] font-black text-slate-400 uppercase tracking-[0.3em] mb-6">
        Gestión de Consultorio
      </h3>
      <DashboardActions client:visible />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-8">

        <StaticCard className="overflow-hidden">
          <UpcomingAppointments client:visible />
        </StaticCard>

        <StaticCard className="overflow-hidden">
          <RecentResults client:visible />
        </StaticCard>

      </div>

      <div class="space-y-8">
        
        <StaticCard className="p-8">
          <div class="flex justify-between items-center mb-8">
            <h3 class="font-bold text-slate-700 text-sm flex items-center gap-2 uppercase tracking-wide">
				<FaUsers size={18} className="text-emerald-500" /> Resumen de Pacientes
            </h3>
          </div>

          <PatientStats client:visible />

          <button class="w-full mt-8 py-4 rounded-2xl bg-slate-50 text-slate-500 text-[10px] font-black uppercase tracking-widest hover:bg-[#1e3a8a] hover:text-white transition-all border border-dashed border-slate-300 flex items-center justify-center gap-2 group">
			Descargar Reporte Mensual <FaArrowRight size={14} className="group-hover:translate-x-1 transition-transform" />
          </button>
        </StaticCard>

        <StaticCard className="p-8">
          <SpecialtyChart client:visible />
        </StaticCard>

      </div>
    </div>
  </div>
</MainLayout>
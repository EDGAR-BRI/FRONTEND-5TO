---
import MainLayout from '@/layouts/DoctorLayout.astro';
import AppointmentCalendar from '@/components/react/AppointmentCalendar';
import ActionCard from "@/components/react/primary/ActionCard"; 
import StaticCard from "@/components/react/primary/StaticCard";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { 
  FaCalendarCheck, 
  FaUsers, 
  FaClock, 
  FaFileMedical, 
  FaChevronRight,
  FaUserInjured
} from "react-icons/fa6";

const { doctor_id } = Astro.params;
const today = new Date();
const todayIso = today.toISOString().split('T')[0];

const citasMock = [
  { id: 1, patientName: 'Juan Pérez', id_paciente: '1', hora: '09:00 AM', motivo: 'Control anual', doctor: 'Dr. Local', especialidad: 'General', fecha: todayIso, estado: 'completada' as const },
  { id: 2, patientName: 'Ana García', id_paciente: '2', hora: '10:30 AM', motivo: 'Revisión post-op', doctor: 'Dr. Local', especialidad: 'General', fecha: todayIso, estado: 'programada' as const },
  { id: 3, patientName: 'Luis Rodríguez', id_paciente: '3', hora: '11:15 AM', motivo: 'Consulta general', doctor: 'Dr. Local', especialidad: 'General', fecha: todayIso, estado: 'cancelada' as const },
];
---

<MainLayout title="Agenda Médica">
  <main class="p-4 md:p-6 bg-[#f4f9ff] min-h-screen w-full flex flex-col gap-6">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <StatsCard title="Citas Hoy" value={citasMock.length} color="primary" />
      <StatsCard title="Pacientes Atendidos" value="24" color="success" />
      <StatsCard title="Tiempo Promedio" value="25 min" color="warning" />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_350px] gap-6 flex-1">
      
      <section class="bg-white p-4 rounded-xl border border-primary-200 shadow-sm flex flex-col min-h-[600px]">
        <h2 class="text-xl font-bold text-slate-800 mb-6">Calendario de Consultas</h2>
        <div class="flex-1">
          <AppointmentCalendar
            role="doctor"
            citas={citasMock}
            context={{ doctorId: doctor_id }}
            actions={[
              {
                id: 'historial',
                label: 'Ver Historial Clínico',
                kind: 'link',
                variant: 'primary',
                hrefTemplate: '/modules/pacient/{id_paciente}/history'
              }
            ]}
            client:load
          />
        </div>
      </section>

      <aside class="flex flex-col gap-6">
        <StaticCard className="bg-white flex-1 flex flex-col">
          <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
           <FaUserInjured className="text-primary-600"></FaUserInjured>
            Pacientes del Día
          </h3>
          <div class="space-y-3 overflow-y-auto max-h-[450px] pr-1">
            {
              citasMock.map((cita) => (
                <a href={`modules/pacient/${cita.id_paciente}/history`} class="block no-underline">
                  <ActionCard 
                    className="bg-slate-50/50 hover:bg-white border-slate-200"
                  >
                    <div class="flex flex-col gap-1">
                      <span class="text-sm font-bold text-slate-700">{cita.patientName}</span>
                      <div class="flex items-center gap-2 text-[11px] text-slate-500 font-medium">
                        <span class="bg-primary-50 text-primary-700 px-1.5 py-0.5 rounded">
                          {cita.hora}
                        </span>
                        <span class="truncate max-w-[120px]">{cita.motivo}</span>
                      </div>
                    </div>
                    <FaChevronRight className="text-slate-300 w-3 h-3 group-hover:text-primary-600 transition-colors" />
                  </ActionCard>
                </a>
              ))
            }
          </div>
        </StaticCard>

        <StaticCard className="bg-primary-600 text-white border-none shadow-lg">
           <h3 class="font-bold mb-4">Herramientas Rápidas</h3>
           <nav class="grid gap-2">
              <button class="flex items-center gap-3 p-3 bg-white/10 rounded-lg hover:bg-white/20 transition-all text-sm font-medium w-full">
                <FaFileMedical /> Nueva Receta
              </button>
              <button class="flex items-center gap-3 p-3 bg-white/10 rounded-lg hover:bg-white/20 transition-all text-sm font-medium w-full">
                <FaUsers /> Ver Lista Completa
              </button>
           </nav>
        </StaticCard>
      </aside>

    </div>
  </main>
</MainLayout>
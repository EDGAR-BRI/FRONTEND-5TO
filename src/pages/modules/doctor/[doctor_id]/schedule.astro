---
import MainLayout from "@/layouts/DoctorLayout.astro";
import DoctorStats from "@/components/react/doctor/DoctorStats";
import DoctorSchedule from "@/components/react/doctor/DoctorSchedule";
import PatientsOfDay from "@/components/react/doctor/PatientsOfDay";
import { getDoctorByUserId } from "@/lib/services/medical/doctor/doctor.service";

const { doctor_id } = Astro.params;
const userId = Number(doctor_id);
let doctorId = 0;

if (Number.isFinite(userId) && userId > 0) {
  try {
    const doctor = await getDoctorByUserId(userId);
    doctorId = doctor?.id ?? 0;
  } catch (error) {
    console.error("Error al obtener doctor por userId:", error);
  }
}
---

<MainLayout title="Agenda Médica">
  <main class="pt-4 md:p-0 md:py-6 min-h-screen w-full flex flex-col gap-6 @container">
    <div class="mb-8">
      <h1 class="text-3xl font-black text-slate-800">Agendas y Consultas</h1>
      <p class="text-sm text-slate-500 mt-2">Gestiona todas las citas programadas y el historial de consultas médicas.</p>
    </div>

    <DoctorStats doctorId={doctorId} client:visible />

    <div class="flex flex-col @[900px]:flex-row gap-6">
      <div class="overflow-hidden flex-2">
        <DoctorSchedule doctorId={doctorId} userId={userId} client:visible />
      </div>
      
        <PatientsOfDay ClassName=" flex-1" doctorId={userId} client:visible />
    </div>
  </main>
</MainLayout>

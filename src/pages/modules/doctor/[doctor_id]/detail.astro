---
import MainLayout from '@/layouts/DoctorLayout.astro';
import ActionCard from '@/components/react/primary/ActionCard';
import StaticCard from '@/components/react/primary/StaticCard';

const { doctor_id } = Astro.params;

const pacienteMock = {
  id: 298,
  nombre: 'Christofer el maldito',
  edad: 25,
  genero: 'Masculino',
  historiaClinica: 'pajuo-012345',
  tipoSangre: 'O+',
  alergias: 'Mujeres y sociedad en general',
};

const fechaHoy = "2026-03-14";
---

<MainLayout>
  <section class="p-6 md:p-8 min-h-[calc(100vh-4rem)]">
    
    <header class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold text-primary-800 mb-1">Consulta Activa</h1>
        <p class="text-sm text-slate-500">
          Registrando atención médica para <span class="font-semibold">{pacienteMock.nombre}</span>
        </p>
      </div>
      <div class="flex gap-3">
        <button type="button" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors">
          Cancelar
        </button>
        <button type="button" class="px-6 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors shadow-sm flex items-center gap-2">
          <i class="fa-solid fa-floppy-disk"></i> Guardar Consulta
        </button>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <div class="lg:col-span-1 space-y-6">
        <StaticCard className="sticky top-24">
          <h2 class="text-lg font-bold text-slate-700 mb-4 border-b border-primary-200/60 pb-2">
            Datos del Paciente
          </h2>
          <div class="space-y-3 text-sm text-slate-600">
            <p><span class="font-semibold text-slate-700">Nombre:</span> {pacienteMock.nombre}</p>
            <p><span class="font-semibold text-slate-700">Edad:</span> {pacienteMock.edad} años</p>
            <p><span class="font-semibold text-slate-700">Género:</span> {pacienteMock.genero}</p>
            <p><span class="font-semibold text-slate-700">Historia clínica:</span> {pacienteMock.historiaClinica}</p>
            <p><span class="font-semibold text-slate-700">Fecha:</span> {fechaHoy}</p>
            
            <div class="pt-3 mt-3 border-t border-primary-200/60">
              <span class="font-semibold text-slate-700 block mb-1">Alergias Registradas:</span>
              <span class="inline-block bg-red-100 text-red-700 text-xs px-2 py-1 rounded-md font-semibold">
                <i class="fa-solid fa-triangle-exclamation mr-1"></i> {pacienteMock.alergias}
              </span>
            </div>
          </div>
        </StaticCard>
      </div>

      <div class="lg:col-span-2 space-y-4">
        
        <ActionCard>
          <div class="w-full">
            <h3 class="text-base font-bold text-slate-700 mb-3">Motivo de consulta</h3>
            <textarea 
              rows="2" 
              class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary-500 outline-none" 
              placeholder="Describa el motivo principal por el que acude el paciente..."
            ></textarea>
          </div>
        </ActionCard>

        <ActionCard>
          <div class="w-full">
            <h3 class="text-base font-bold text-slate-700 mb-3">Antecedentes Relevantes</h3>
            <textarea 
              rows="2" 
              class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary-500 outline-none" 
              placeholder="Antecedentes familiares o personales relevantes para esta consulta..."
            ></textarea>
          </div>
        </ActionCard>

        <ActionCard>
          <div class="w-full">
            <h3 class="text-base font-bold text-slate-700 mb-3">Exploración física</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-3">
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1">Tensión (mmHg)</label>
                <input type="text" placeholder="120/80" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1">FC (lpm)</label>
                <input type="text" placeholder="75" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1">Temp (°C)</label>
                <input type="text" placeholder="37.0" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1">Peso (kg)</label>
                <input type="text" placeholder="70" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
              </div>
            </div>
            <textarea 
              rows="2" 
              class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary-500 outline-none" 
              placeholder="Detalles adicionales de la exploración..."
            ></textarea>
          </div>
        </ActionCard>

        <ActionCard>
          <div class="w-full">
            <h3 class="text-base font-bold text-slate-700 mb-3">Diagnóstico y Recomendaciones</h3>
            <div class="space-y-3">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Diagnóstico Principal</label>
                <input type="text" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500 font-medium text-slate-800" placeholder="Ej: Migraña tensional leve" />
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Recomendaciones</label>
                <textarea 
                  rows="2" 
                  class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary-500 outline-none" 
                  placeholder="Reposo, dieta, cuidados generales..."
                ></textarea>
              </div>
            </div>
          </div>
        </ActionCard>

        <ActionCard>
          <div class="w-full flex justify-between items-center mb-3">
            <h3 class="text-base font-bold text-slate-700">Tratamiento (Récipe Médico)</h3>
            <button type="button" class="text-xs font-semibold text-primary-600 hover:text-primary-800 bg-primary-100 hover:bg-primary-200 transition-colors px-3 py-1.5 rounded-lg">
              + Añadir Medicamento
            </button>
          </div>
          <div class="w-full">
            <div class="flex flex-col sm:flex-row gap-2 mb-2 bg-slate-50 p-3 rounded-lg border border-slate-200">
              <input type="text" placeholder="Medicamento (Ej: Paracetamol 500mg)" class="flex-2 border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
              <input type="text" placeholder="Dosis/Frecuencia" class="flex-1 border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
              <input type="text" placeholder="Duración" class="w-24 border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary-500" />
            </div>
          </div>
        </ActionCard>

        <ActionCard>
          <div class="w-full">
            <h3 class="text-base font-bold text-slate-700 mb-3">Notas adicionales (Privadas)</h3>
            <textarea 
              rows="2" 
              class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary-500 outline-none" 
              placeholder="Notas internas para el historial, referimientos futuros..."
            ></textarea>
          </div>
        </ActionCard>

      </div>
    </div>
  </section>
</MainLayout>
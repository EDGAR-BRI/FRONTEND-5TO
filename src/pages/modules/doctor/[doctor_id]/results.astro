---
import MainLayout from "@/layouts/DoctorLayout.astro";
import StaticCard from "@/components/react/primary/StaticCard";
import LaboratoryResults from "@/components/react/doctor/LaboratoryResults";

import { FaFlask } from "react-icons/fa6";
---

<MainLayout>
  <div class="bg-slate-50 min-h-screen p-8 font-sans">
    
    <div class="mb-8 flex justify-between items-center gap-4">
      <div>
        <h1 class="text-3xl font-black text-slate-800">Módulo de Resultados</h1>
        <p class="text-sm text-slate-500 mt-2">Visualiza, analiza y gestiona los reportes de laboratorio de tus pacientes.</p>
      </div>
      
      <button class="px-5 py-3 text-sm font-bold text-white bg-[#1e3a8a] rounded-lg hover:bg-blue-800 transition-colors shadow-sm flex items-center gap-2">
		<FaFlask size={16} /> Solicitar Nueva Prueba
      </button>
    </div>

    <StaticCard className="p-0 bg-transparent border-none shadow-none">
      <LaboratoryResults client:load />
    </StaticCard>
    
  </div>
</MainLayout>
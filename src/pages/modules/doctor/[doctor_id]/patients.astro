---
import MainLayout from "@/layouts/DoctorLayout.astro";
import StaticCard from "@/components/react/primary/StaticCard";
import PatientAgenda from "@/components/react/doctor/PatientAgenda";
---

<MainLayout>
  <div class="bg-slate-50 min-h-screen p-8 font-sans">
    
    <div class="mb-8">
      <h1 class="text-3xl font-black text-slate-800">Agendas y Consultas</h1>
      <p class="text-sm text-slate-500 mt-2">Gestiona todas las citas programadas y el historial de consultas médicas.</p>
    </div>

    <StaticCard className="p-2 sm:p-6 bg-transparent border-none shadow-none">
      <PatientAgenda client:load />
    </StaticCard>
    
  </div>
</MainLayout>
---
import MainLayout from "@/layouts/DoctorLayout.astro";
import { PatientHistoryModal } from "@/components/react/doctor/PatientHistoryModal";

const { doctor_id, patient_id } = Astro.params;
const patientId = Number(patient_id);
const doctorId = doctor_id as string;
---

<MainLayout title="Resumen clínico">
  <main class="bg-slate-50 min-h-screen p-4 md:px-0 md:py-6 font-sans">
    <div class="mb-6">
      <a href={`/modules/doctor/${doctorId}/patients`} data-astro-reload class="text-sm font-medium text-primary-600 hover:text-primary-700 flex items-center gap-2 mb-2 transition-colors">
        &larr; Volver a pacientes
      </a>
      <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Resumen clínico del paciente</h1>
      <p class="text-sm text-slate-500 mt-1">Panel de historial, diagnósticos y tratamientos activos.</p>
    </div>

    <PatientHistoryModal client:load patientId={Number.isFinite(patientId) ? patientId : null} doctorId={doctorId} />
  </main>
</MainLayout>

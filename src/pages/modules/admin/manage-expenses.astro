---
import MainLayout from '@/layouts/AdminLayout.astro';
---

<MainLayout title="Admin | Gastos e Ingresos">
    <section class="p-8 bg-slate-50 min-h-screen">
        <header class="mb-8">
            <h1 class="text-3xl font-bold text-slate-800">Gestión de Gastos e Ingresos</h1>
            <p class="text-slate-500">Monitorea el flujo de caja, registra movimientos y revisa el balance general.</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <div class="flex items-center gap-4">
                    <div class="bg-green-100 p-3 rounded-xl text-green-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Ingresos del Mes</p>
                        <p class="text-2xl font-bold text-slate-800">$45.200,00</p>
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <div class="flex items-center gap-4">
                    <div class="bg-red-100 p-3 rounded-xl text-red-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Gastos del Mes</p>
                        <p class="text-2xl font-bold text-slate-800">$12.350,00</p>
                    </div>
                </div>
            </div>

            <div class="bg-slate-800 p-6 rounded-2xl shadow-lg border border-slate-700">
                <div class="flex items-center gap-4">
                    <div class="bg-blue-500/20 p-3 rounded-xl text-blue-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-slate-400 font-medium">Balance Disponible</p>
                        <p class="text-2xl font-bold text-white">$32.850,00</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="p-6 border-b border-slate-50 flex flex-col md:flex-row justify-between items-center gap-4">
                    <h2 class="text-lg font-bold text-slate-800">Movimientos Recientes</h2>
                    <div class="flex items-center gap-2">
                        <select class="text-sm border-slate-200 rounded-lg bg-slate-50 text-slate-600 p-2 outline-none">
                            <option>Este mes</option>
                            <option>Mes pasado</option>
                            <option>Año actual</option>
                        </select>
                        <button class="p-2 hover:bg-slate-100 rounded-lg transition-colors text-slate-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 text-slate-400 text-[11px] uppercase tracking-wider">
                            <tr>
                                <th class="px-6 py-4 font-semibold">Concepto / Categoría</th>
                                <th class="px-6 py-4 font-semibold text-center">Fecha</th>
                                <th class="px-6 py-4 font-semibold text-center">Estado</th>
                                <th class="px-6 py-4 font-semibold text-right">Monto</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-700 text-sm">Pago Consulta: Susej Viscaya</span>
                                        <span class="text-[11px] text-blue-500 font-bold uppercase tracking-tighter">Servicios Médicos</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center text-sm text-slate-500">Hoy, 09:00 AM</td>
                                <td class="px-6 py-4 text-center">
                                    <span class="px-2 py-1 rounded-md bg-green-100 text-green-700 text-[10px] font-bold uppercase">Pagado</span>
                                </td>
                                <td class="px-6 py-4 text-right font-bold text-green-600">+$60.00</td>
                            </tr>
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-700 text-sm">Reparación Aire Acondicionado</span>
                                        <span class="text-[11px] text-orange-500 font-bold uppercase tracking-tighter">Mantenimiento</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center text-sm text-slate-500">Ayer, 03:45 PM</td>
                                <td class="px-6 py-4 text-center">
                                    <span class="px-2 py-1 rounded-md bg-slate-100 text-slate-500 text-[10px] font-bold uppercase">Pendiente</span>
                                </td>
                                <td class="px-6 py-4 text-right font-bold text-red-600">-$120.00</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="space-y-6">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <h3 class="text-sm font-bold text-slate-800 mb-4 uppercase tracking-widest">Operaciones</h3>
                    <div class="grid grid-cols-1 gap-3">
                        <button class="flex items-center justify-center gap-2 w-full py-3 bg-blue-600 text-white rounded-xl font-bold text-sm hover:bg-blue-700 transition-all shadow-sm shadow-blue-200">
                            <span>+</span> Registrar Ingreso
                        </button>
                        <button class="flex items-center justify-center gap-2 w-full py-3 bg-white text-red-600 border border-red-100 rounded-xl font-bold text-sm hover:bg-red-50 transition-all">
                            <span>-</span> Registrar Gasto
                        </button>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <h3 class="text-sm font-bold text-slate-800 mb-4 uppercase tracking-widest">Gastos por Categoría</h3>
                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between text-xs mb-1 font-medium">
                                <span class="text-slate-500">Insumos Médicos</span>
                                <span class="text-slate-800 font-bold">45%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-1.5">
                                <div class="bg-blue-500 h-1.5 rounded-full" style="width: 45%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs mb-1 font-medium">
                                <span class="text-slate-500">Servicios Públicos</span>
                                <span class="text-slate-800 font-bold">20%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-1.5">
                                <div class="bg-orange-400 h-1.5 rounded-full" style="width: 20%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs mb-1 font-medium">
                                <span class="text-slate-500">Nómina</span>
                                <span class="text-slate-800 font-bold">35%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-1.5">
                                <div class="bg-purple-500 h-1.5 rounded-full" style="width: 35%"></div>
                            </div>
                        </div>
                    </div>
                    <button class="w-full mt-6 text-xs text-blue-600 font-bold hover:underline">Ver reporte detallado →</button>
                </div>
            </div>

        </div>
    </section>
</MainLayout>
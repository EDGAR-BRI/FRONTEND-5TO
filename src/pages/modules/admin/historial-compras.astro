---
import MainLayout from '@/layouts/AdminLayout.astro';
import { PurchaseHistoryDashboard } from '@/components/react/admin/procurement/PurchaseHistoryDashboard';
---

<MainLayout title="Admin | Historial de compras">
	<section class="p-8 space-y-6">
		<header class="space-y-3 sm:space-y-0 sm:flex sm:items-center sm:justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-2xl font-semibold text-primary-800">Historial de compras</h1>
				<p class="text-sm text-cool-gray-70">
					Consulta compras de insumos, pagos asociados, impuestos y detalle por ítem.
				</p>
			</div>
			<a
				href="/modules/admin/compras"
				class="inline-flex items-center justify-center rounded-xl h-10 px-4 bg-primary text-white text-sm font-medium hover:bg-primary-600 transition-colors"
			>
				Registrar compra
			</a>
		</header>

		<PurchaseHistoryDashboard client:only="react" />
	</section>
</MainLayout>
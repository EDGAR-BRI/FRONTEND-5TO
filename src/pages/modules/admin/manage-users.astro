---
import MainLayout from "@/layouts/AdminLayout.astro";
import UsersDashboard from "@/components/react/admin/UsersDashboard";
---

<MainLayout title="Admin | Gestionar usuarios">
	<section class="p-8 space-y-6">
		<header
			class="flex items-center justify-between pb-4 border-b border-primary-200"
		>
			<div>
				<h1 class="text-2xl font-semibold text-primary-800">
					Gestionar Usuarios
				</h1>
				<p class="text-primary-600 mt-1 text-sm">
					Administra los accesos, roles y estados del personal
					administrativo, médico y pacientes.
				</p>
			</div>
		</header>

		<UsersDashboard client:load />
	</section>
</MainLayout>

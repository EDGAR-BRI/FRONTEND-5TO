---
import MainLayout from "@/layouts/AdminLayout.astro";
import UsersTable from "@/components/react/admin/UsersTable";
import CreateUserModalTrigger from "@/components/react/admin/CreateUserModalTrigger";
---

<MainLayout title="Admin | Gestionar usuarios">
	<section class="p-8">
		<div
			class="flex items-center justify-between mb-8 pb-4 border-b border-primary-200"
		>
			<div>
				<h1 class="text-2xl font-semibold text-primary-800">
					Gestionar usuarios
				</h1>
				<p class="text-primary-600 mt-1 text-sm">
					Administra los accesos, roles y estados del personal
					administrativo, médico y pacientes.
				</p>
			</div>
			<div>
				<CreateUserModalTrigger client:load />
			</div>
		</div>

		<div class="mt-6">
			<UsersTable client:load />
		</div>
	</section>
</MainLayout>

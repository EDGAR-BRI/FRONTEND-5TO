---
import AdminLayout from "@/layouts/AdminLayout.astro";

//datos Mock bruh
const usuariosRecientes = [
	{
		id: 1,
		nombre: "Juan Sun",
		rol: "Doctor",
		estado: "Activo",
		fecha: "Hoy, 10:30 AM",
	},
	{
		id: 2,
		nombre: "Edgar Briceno",
		rol: "Paciente",
		estado: "Pendiente",
		fecha: "Ayer, 15:45 PM",
	},
	{
		id: 3,
		nombre: "Samuel Rosales",
		rol: "Doctor",
		estado: "Inactivo",
		fecha: "Ayer, 08:15 AM",
	},
	{
		id: 4,
		nombre: "Susej Viscaya",
		rol: "Recepcionista",
		estado: "Activo",
		fecha: "Hoy, 09:00 AM",
	},
];
// Colores para los estados
const coloresEstado: Record<string, string> = {
    "Activo": "bg-green-100 text-green-700",
    "Pendiente": "bg-amber-100 text-amber-700",
    "Inactivo": "bg-red-100 text-red-700",
};
---

<AdminLayout title="Dashboard General | Admin">
	<div class="p-6 md:p-8 space-y-8">
		<header>
			<h1 class="text-3xl font-bold text-gray-800">Resumen General</h1>
			<p class="text-gray-500 mt-1">
				Bienvenido al panel de control. Así van las métricas.
			</p>
		</header>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
			<div
				class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4 hover:shadow-md transition-shadow"
			>
				<div
					class="w-14 h-14 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl"
				>
					<i class="fa-solid fa-users"></i>
				</div>
				<div>
					<h3 class="text-sm font-medium text-gray-500">Pacientes</h3>
					<p class="text-2xl font-bold text-gray-800">8249</p>
				</div>
			</div>

			<div
				class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4 hover:shadow-md transition-shadow"
			>
				<div
					class="w-14 h-14 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center text-2xl"
				>
					<i class="fa-solid fa-boxes-stacked"></i>
				</div>
				<div>
					<h3 class="text-sm font-medium text-gray-500">
						Insumos Críticos
					</h3>
					<p class="text-2xl font-bold text-gray-800">12</p>
				</div>
			</div>

			<div
				class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4 hover:shadow-md transition-shadow"
			>
				<div
					class="w-14 h-14 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl"
				>
					<i class="fa-solid fa-money-bill-wave"></i>
				</div>
				<div>
					<h3 class="text-sm font-medium text-gray-500">
						Ingresos del Mes
					</h3>
					<p class="text-2xl font-bold text-gray-800">$45.200</p>
				</div>
			</div>

			<div
				class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4 hover:shadow-md transition-shadow"
			>
				<div
					class="w-14 h-14 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-2xl"
				>
					<i class="fa-solid fa-file-waveform"></i>
				</div>
				<div>
					<h3 class="text-sm font-medium text-gray-500">
						Nuevos Reportes
					</h3>
					<p class="text-2xl font-bold text-gray-800">34</p>
				</div>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<div
				class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-6"
			>
				<div class="flex justify-between items-center mb-6">
					<h2 class="text-lg font-bold text-gray-800">
						Usuarios Recientes
					</h2>
					<button
						class="text-sm text-blue-600 font-medium hover:underline"
						>Ver todos</button
					>
				</div>

				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse">
						<thead>
							<tr
								class="border-b border-gray-100 text-sm text-gray-500"
							>
								<th class="pb-3 font-medium">Nombre</th>
								<th class="pb-3 font-medium">Rol</th>
								<th class="pb-3 font-medium">Estado</th>
								<th class="pb-3 font-medium">Fecha</th>
							</tr>
						</thead>
						<tbody class="text-sm">
							{
								usuariosRecientes.map((usuario) => (
									<tr class="border-b border-gray-50 last:border-0 hover:bg-gray-50 transition-colors">
										<td class="py-4 text-gray-800 font-medium">
											{usuario.nombre}
										</td>
										<td class="py-4 text-gray-500">
											{usuario.rol}
										</td>

										<td class="py-4">
											<span
												class={`px-2 py-1 rounded-full text-xs font-semibold ${coloresEstado[usuario.estado] || "bg-gray-100 text-gray-700"}`}
											>
												{usuario.estado}
											</span>
										</td>

										<td class="py-4 text-gray-500">
											{usuario.fecha}
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>

			<div
				class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col justify-between"
			>
				<div>
					<h2 class="text-lg font-bold text-gray-800 mb-4">
						Acciones Rápidas
					</h2>
					<div class="space-y-3">
						<button
							class="w-full text-left px-4 py-3 rounded-xl bg-gray-50 hover:bg-gray-100 text-gray-700 font-medium transition-colors flex items-center gap-3"
						>
							<i class="fa-solid fa-plus text-blue-500"></i> Registrar
							Usuario
						</button>
						<button
							class="w-full text-left px-4 py-3 rounded-xl bg-gray-50 hover:bg-gray-100 text-gray-700 font-medium transition-colors flex items-center gap-3"
						>
							<i class="fa-solid fa-box text-amber-500"></i> Actualizar
							Insumos
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</AdminLayout>

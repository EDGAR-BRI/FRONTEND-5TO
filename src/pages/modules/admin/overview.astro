---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { OverviewStats } from "@/components/react/admin/OverviewStats";
import { Button } from "@/components/react/primary/Button";

//datos Mock bruh
const usuariosRecientes = [
	{
		id: 1,
		nombre: "Juan Sun",
		rol: "Doctor",
		estado: "Activo",
		fecha: "Hoy, 10:30 AM",
	},
	{
		id: 2,
		nombre: "Edgar Briceno",
		rol: "Paciente",
		estado: "Pendiente",
		fecha: "Ayer, 15:45 PM",
	},
	{
		id: 3,
		nombre: "Samuel Rosales",
		rol: "Doctor",
		estado: "Inactivo",
		fecha: "Ayer, 08:15 AM",
	},
	{
		id: 4,
		nombre: "Susej Viscaya",
		rol: "Recepcionista",
		estado: "Activo",
		fecha: "Hoy, 09:00 AM",
	},
];
// Colores para los estados
const coloresEstado: Record<string, string> = {
	Activo: "bg-green-100 text-green-700",
	Pendiente: "bg-amber-100 text-amber-700",
	Inactivo: "bg-red-100 text-red-700",
};
---

<AdminLayout title="Dashboard General | Admin">
	<div class="p-6 md:p-8 space-y-8">
		<header>
			<h1 class="text-3xl font-bold text-gray-800">Resumen General</h1>
			<p class="text-gray-500 mt-1">
				Bienvenido al panel de control. Así van las métricas.
			</p>
		</header>

		<OverviewStats client:load />

		<div class="mt-4 grid grid-cols-1 lg:grid-cols-3 gap-6">
			<div
							
				class="lg:col-span-2 bg-primary-100 rounded-xl  border border-primary-200 p-6"
							
			>
				<div class="flex justify-between items-center mb-6">
					<h2 class="text-lg font-bold text-gray-800">
						Usuarios Recientes
					</h2>
				</div>

				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse">
						<thead>
							<tr
								class="border-b border-gray-100 text-sm text-gray-500"
							>
								<th class="pb-3 font-medium">Nombre</th>
								<th class="pb-3 font-medium">Rol</th>
								<th class="pb-3 font-medium">Estado</th>
								<th class="pb-3 font-medium">Fecha</th>
							</tr>
						</thead>
						<tbody class="text-sm">
							{
								usuariosRecientes.map((usuario) => (
									<tr class="border-b border-gray-50 last:border-0 hover:bg-gray-50 transition-colors">
										<td class="py-4 text-gray-800 font-medium">
											{usuario.nombre}
										</td>
										<td class="py-4 text-gray-500">
											{usuario.rol}
										</td>

										<td class="py-4">
											<span
												class={`px-2 py-1 rounded-full text-xs font-semibold ${coloresEstado[usuario.estado] || "bg-gray-100 text-gray-700"}`}
											>
												{usuario.estado}
											</span>
										</td>

										<td class="py-4 text-gray-500">
											{usuario.fecha}
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>

			<div
				class="bg-primary-100 rounded-xl border border-primary-200 p-6 flex flex-col justify-between"
			>
				<div>
					<h2 class="text-lg font-bold text-gray-800 mb-4">
						Acciones Rápidas
					</h2>
					<div class="space-y-3">
						<Button
							label="Usuario"
							adaptive={true}
						>
							<i class="fa-solid fa-user text-blue-500"></i>
							Crear Nuevo Usuario
						</Button>
						<Button
							label="Insumos"
							variant="secondary"
							adaptive={true}
						>
							<i class="fa-solid fa-box text-amber-500"></i> Actualizar
							Insumos
						</Button>
					</div>
				</div>
			</div>
		</div>
	</div>
</AdminLayout>

---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaCoins, FaMoneyCheckDollar, FaScaleBalanced } from "react-icons/fa6";
import { getIncomeSummary } from "@/lib/services/report/income.service";

const from = Astro.url.searchParams.get("from") ?? undefined;
const to = Astro.url.searchParams.get("to") ?? undefined;
const period = Astro.url.searchParams.get("period") ?? undefined;
const preset = Astro.url.searchParams.get("preset") ?? undefined;
const incomeSummary = await getIncomeSummary({ from, to });
const filterQuery = new URLSearchParams();
if (from) filterQuery.set("from", from);
if (to) filterQuery.set("to", to);
if (period) filterQuery.set("period", period);
if (preset) filterQuery.set("preset", preset);
const filterSuffix = filterQuery.toString() ? `?${filterQuery.toString()}` : "";
const currency = new Intl.NumberFormat("es-VE", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 2,
});

const conciliacionMedios = incomeSummary.data.collectionByPaymentMethod.map((item) => ({
  medio: item.paymentMethod,
  sistema: currency.format(item.amountUsd),
  igtf: currency.format(item.igtfUsd),
  pagos: item.payments,
  estado: item.amountUsd > 0 ? "Registrado" : "Sin movimiento",
}));
---

<AdminLayout title="Ingresos - Recaudación y Caja | Admin">
  <div class="p-6 md:p-8 space-y-8">
    
    <a href={`/modules/admin/reports/ingresos${filterSuffix}`} class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a ingresos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Recaudación y Disponibilidad</h1>
      <p class="text-gray-500 font-medium">Resumen de pagos recibidos, medios de cobro e IGTF registrado.</p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatsCard title="Efectivo y Equivalentes" value={currency.format(incomeSummary.data.summary.collectedUsd)} trend={`${Math.abs(incomeSummary.data.summary.collectedTrendPct).toFixed(1)}%`} trendUp={incomeSummary.data.summary.collectedTrendPct >= 0} color="success">
        <FaCoins slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Eficiencia de Recaudo" value={`${incomeSummary.data.summary.collectionRate.toFixed(1)}%`} subText="Conversión factura -> cobro" color="primary">
        <FaMoneyCheckDollar slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Partidas Pendientes" value={currency.format(incomeSummary.data.summary.pendingBalanceUsd)} subText="Saldo por cobrar" color="danger">
        <FaScaleBalanced slot="icon" size={20} />
      </StatsCard>
    </section>

    <ReportTimeframeFilters client:load title="Libro Auxiliar de Caja" subtitle="Cruce de movimientos contables contra depósitos efectivos en cuentas bancarias." initialPeriod={(Astro.url.searchParams.get("period") as "day" | "week" | "month" | "year") ?? "month"} initialPreset={Astro.url.searchParams.get("preset") ?? undefined} />

    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xl font-semibold text-gray-800">Recaudación por Medio de Pago</h2>
        <span class="px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20 shadow-sm">
            Disponibilidad Real
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Medio de Recepción</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Monto Recibido</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">IGTF</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Pagos</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {conciliacionMedios.map((m) => (
              <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                <td class="px-4 py-4 text-sm text-gray-700 font-bold group-hover:text-primary-900">{m.medio}</td>
                <td class="px-4 py-4 text-sm text-right text-gray-600 font-medium">{m.sistema}</td>
                <td class="px-4 py-4 text-sm text-right text-gray-800 font-bold">{m.igtf}</td>
                <td class="px-4 py-4 text-sm text-right text-gray-600 font-medium">{m.pagos}</td>
                <td class="px-4 py-4 text-sm text-right font-bold text-emerald-600">
                  {m.estado}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AdminLayout>

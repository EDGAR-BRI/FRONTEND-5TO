---
export const prerender = true;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaChartLine, FaCoins, FaWallet } from "react-icons/fa6";

const services = [
  { service: "Consulta general", income: "$12,400", margin: "31%", target: "98%" },
  { service: "Cardiologia", income: "$9,200", margin: "28%", target: "92%" },
  { service: "Pediatria", income: "$7,850", margin: "25%", target: "96%" },
  { service: "Laboratorio", income: "$6,130", margin: "22%", target: "89%" },
];
---

<AdminLayout title="Resultados - Financieros | Admin">
  <div class="p-6 md:p-8 space-y-8">
    
    <a href="/modules/admin/reports/resultados" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a resultados
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Resultado financiero</h1>
      <p class="text-gray-500 font-medium">Desempeño económico por servicio y avance contra objetivos.</p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatsCard title="Ingreso mensual" value="$35,580" trend="6.1%" trendUp={true} color="success">
        <FaWallet slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Margen operativo" value="27%" trend="1.0%" trendUp={true} color="primary">
        <FaCoins slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Cumplimiento de meta" value="94%" trend="2.6%" trendUp={true} color="warning">
        <FaChartLine slot="icon" size={20} />
      </StatsCard>
    </section>

    <ReportTimeframeFilters client:load title="Filtro financiero" subtitle="Compara resultados financieros por día, semana, mes o año y sigue el avance contra metas." />

    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xl font-semibold text-gray-800">Rentabilidad por servicio</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            Mes actual
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Servicio</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Ingreso</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Margen</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Meta</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {
              services.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                  <td class="px-4 py-3 text-sm text-gray-700 font-medium group-hover:text-primary-900">{item.service}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{item.income}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{item.margin}</td>
                  <td class="px-4 py-3 text-sm text-right text-emerald-600 font-bold">{item.target}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>
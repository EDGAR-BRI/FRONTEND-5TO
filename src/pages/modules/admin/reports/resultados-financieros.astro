---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Badge } from "@/components/react/primary/Badge";
import StaticCard from "@/components/react/primary/StaticCard";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaChartLine, FaCoins, FaWallet } from "react-icons/fa6";

const services = [
  { service: "Consulta general", income: "$12,400", margin: "31%", target: "98%" },
  { service: "Cardiologia", income: "$9,200", margin: "28%", target: "92%" },
  { service: "Pediatria", income: "$7,850", margin: "25%", target: "96%" },
  { service: "Laboratorio", income: "$6,130", margin: "22%", target: "89%" },
];
---

<AdminLayout title="Resultados - Financieros | Admin">
  <div class="space-y-6">
    <a href="/modules/admin/reports/resultados" class="inline-flex items-center gap-2 text-sm text-primary-700 hover:underline">
      <FaArrowLeft size={12} /> Volver a resultados
    </a>

    <header class="space-y-2">
      <h1 class="text-2xl font-bold text-gray-800">Resultado financiero</h1>
      <p class="text-gray-500">Desempeno economico por servicio y avance contra objetivos.</p>
    </header>

    <ReportTimeframeFilters client:visible title="Filtro financiero" subtitle="Compara resultados financieros por día, semana, mes o año y sigue el avance contra metas." />

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <StatsCard title="Ingreso mensual" value="$35,580" trend="6.1%" trendUp={true} color="success"><FaWallet slot="icon" size={18} /></StatsCard>
      <StatsCard title="Margen operativo" value="27%" trend="1.0%" trendUp={true} color="primary"><FaCoins slot="icon" size={18} /></StatsCard>
      <StatsCard title="Cumplimiento de meta" value="94%" trend="2.6%" trendUp={true} color="warning"><FaChartLine slot="icon" size={18} /></StatsCard>
    </section>

    <StaticCard>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-800">Rentabilidad por servicio</h2>
          <Badge>Mes actual</Badge>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-primary-300">
            <thead class="bg-primary-300">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Servicio</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Ingreso</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Margen</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Meta</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary-300">
              {services.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors">
                  <td class="px-4 py-3 text-sm text-cool-gray-90">{item.service}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.income}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.margin}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.target}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </StaticCard>
  </div>
</AdminLayout>

---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Badge } from "@/components/react/primary/Badge";
import StaticCard from "@/components/react/primary/StaticCard";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaClipboardCheck, FaClock, FaHandshakeSimple } from "react-icons/fa6";

const providers = [
  { name: "Medisupply", avgOrder: "$540", onTime: "96%", variation: "+2.1%" },
  { name: "LabStore", avgOrder: "$620", onTime: "89%", variation: "+6.5%" },
  { name: "BioCare", avgOrder: "$470", onTime: "92%", variation: "-1.4%" },
  { name: "Clinix", avgOrder: "$510", onTime: "87%", variation: "+4.3%" },
];
---

<AdminLayout title="Gastos - Proveedores | Admin">
  <div class="space-y-6">
    <a href="/modules/admin/reports/gastos" class="inline-flex items-center gap-2 text-sm text-primary-700 hover:underline">
      <FaArrowLeft size={12} /> Volver a gastos
    </a>

    <header class="space-y-2">
      <h1 class="text-2xl font-bold text-gray-800">Rendimiento de proveedores</h1>
      <p class="text-gray-500">Control de costo por orden y nivel de cumplimiento en entregas.</p>
    </header>

    <ReportTimeframeFilters client:visible title="Filtro de proveedores" subtitle="Consulta rendimiento y puntualidad por día, semana, mes o año para detectar variaciones de abastecimiento." />

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <StatsCard title="Proveedores activos" value="14" trend="0.0%" trendUp={true} color="primary"><FaHandshakeSimple slot="icon" size={18} /></StatsCard>
      <StatsCard title="Cumplimiento promedio" value="91%" trend="1.6%" trendUp={true} color="success"><FaClipboardCheck slot="icon" size={18} /></StatsCard>
      <StatsCard title="Retraso promedio" value="2.3 dias" trend="0.8%" trendUp={false} color="warning"><FaClock slot="icon" size={18} /></StatsCard>
    </section>

    <StaticCard>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-800">Top proveedores</h2>
          <Badge>Ordenado por costo</Badge>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-primary-300">
            <thead class="bg-primary-300">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Proveedor</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Costo promedio</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Cumplimiento</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Variacion</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary-300">
              {providers.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors">
                  <td class="px-4 py-3 text-sm text-cool-gray-90">{item.name}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.avgOrder}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.onTime}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.variation}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </StaticCard>
  </div>
</AdminLayout>

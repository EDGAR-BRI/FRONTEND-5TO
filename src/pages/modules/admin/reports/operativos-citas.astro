---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Badge } from "@/components/react/primary/Badge";
import StaticCard from "@/components/react/primary/StaticCard";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaCalendarCheck, FaClock, FaUserClock } from "react-icons/fa6";

const agenda = [
  { day: "Lunes", scheduled: 36, attended: 31, noShow: 5 },
  { day: "Martes", scheduled: 42, attended: 39, noShow: 3 },
  { day: "Miercoles", scheduled: 38, attended: 34, noShow: 4 },
  { day: "Jueves", scheduled: 44, attended: 40, noShow: 4 },
];
---

<AdminLayout title="Operativos - Citas | Admin">
  <div class="space-y-6">
    <a href="/modules/admin/reports/operativos" class="inline-flex items-center gap-2 text-sm text-primary-700 hover:underline">
      <FaArrowLeft size={12} /> Volver a operativos
    </a>

    <header class="space-y-2">
      <h1 class="text-2xl font-bold text-gray-800">Carga y puntualidad de citas</h1>
      <p class="text-gray-500">Monitoreo diario de agenda para reducir ausencias y tiempos muertos.</p>
    </header>

    <ReportTimeframeFilters client:visible title="Filtro de citas" subtitle="Mira la agenda por día, semana, mes o año para detectar ausencias y horas pico." />

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <StatsCard title="Citas semanales" value="160" trend="4.3%" trendUp={true} color="primary"><FaCalendarCheck slot="icon" size={18} /></StatsCard>
      <StatsCard title="No show" value="10%" trend="1.1%" trendUp={false} color="warning"><FaUserClock slot="icon" size={18} /></StatsCard>
      <StatsCard title="Puntualidad" value="88%" trend="2.0%" trendUp={true} color="success"><FaClock slot="icon" size={18} /></StatsCard>
    </section>

    <StaticCard>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-800">Resumen por dia</h2>
          <Badge>Semana actual</Badge>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-primary-300">
            <thead class="bg-primary-300">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Dia</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Programadas</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Atendidas</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Ausencias</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary-300">
              {agenda.map((row) => (
                <tr class="hover:bg-primary-500/20 transition-colors">
                  <td class="px-4 py-3 text-sm text-cool-gray-90">{row.day}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{row.scheduled}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{row.attended}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{row.noShow}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </StaticCard>
  </div>
</AdminLayout>

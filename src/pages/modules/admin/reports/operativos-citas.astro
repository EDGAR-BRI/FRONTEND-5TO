---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaCalendarCheck, FaClock, FaUserClock } from "react-icons/fa6";
import CitasBarChart from "@/components/react/admin/CitasBarChart";
import { getOperativosCitas } from "@/lib/services/report/operativos.service";

const from = Astro.url.searchParams.get("from") ?? undefined;
const to = Astro.url.searchParams.get("to") ?? undefined;
const period = (Astro.url.searchParams.get("period") as "day" | "week" | "month" | "year") ?? undefined;
const preset = Astro.url.searchParams.get("preset") ?? undefined;
const report = await getOperativosCitas({ from, to, period });

const filterQuery = new URLSearchParams();
if (from) filterQuery.set("from", from);
if (to) filterQuery.set("to", to);
if (period) filterQuery.set("period", period);
if (preset) filterQuery.set("preset", preset);
const filterSuffix = filterQuery.toString() ? `?${filterQuery.toString()}` : "";

const agenda = report.data.dailyData.map((item) => ({
  day: new Date(`${item.date}T00:00:00Z`).toLocaleDateString("es-VE", { weekday: "long", timeZone: "UTC" }),
  attended: item.attended,
  noShow: item.cancelled,
}));
---

<AdminLayout title="Operativos - Citas | Admin">
  <div class="p-6 md:p-8 space-y-8">
    
    <a href={`/modules/admin/reports/operativos${filterSuffix}`} class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a operativos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Carga y puntualidad de citas</h1>
      <p class="text-gray-500 font-medium">Monitoreo diario de agenda para reducir ausencias.</p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatsCard title="Citas semanales" value={report.data.stats.totalAppointments} trend="4.3%" trendUp={true} color="primary">
        <FaCalendarCheck slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Canceladas" value={`${report.data.stats.cancellationRate.toFixed(1)}%`} trend="1.1%" trendUp={false} color="warning">
        <FaUserClock slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Cumplimiento" value={`${report.data.stats.completionRate.toFixed(1)}%`} trend="2.0%" trendUp={true} color="success">
        <FaClock slot="icon" size={20} />
      </StatsCard>
    </section>

    <ReportTimeframeFilters client:load title="Filtro de citas" initialPeriod={(Astro.url.searchParams.get("period") as "day" | "week" | "month" | "year") ?? "month"} initialPreset={Astro.url.searchParams.get("preset") ?? undefined} />

    <div class="mt-8">
      <section class="bg-white rounded-xl border border-primary-200 p-8 shadow-sm">
        <div class="mb-6">
          <h2 class="text-xl font-bold text-gray-800">Tendencia Diaria</h2>
        </div>
        
        <CitasBarChart client:load data={agenda} />
      </section>
    </div>

    {/* TABLA */}
    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <h2 class="text-xl font-semibold text-gray-800">Resumen por día</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-primary-900">Día</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-primary-900">Atendidas</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-primary-900">Canceladas</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {agenda.map((row) => (
              <tr class="hover:bg-primary-500/20 transition-colors">
                <td class="px-4 py-3 text-sm font-medium">{row.day}</td>
                <td class="px-4 py-3 text-sm text-right font-bold">{row.attended}</td>
                <td class="px-4 py-3 text-sm text-right font-bold text-red-600">{row.noShow}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>

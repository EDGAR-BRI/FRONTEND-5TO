---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaCartFlatbed, FaBoxesStacked, FaTruckFast } from "react-icons/fa6";
import { getExpenseSummary } from "@/lib/services/report/expense.service";

const from = Astro.url.searchParams.get("from") ?? undefined;
const to = Astro.url.searchParams.get("to") ?? undefined;
const period = (Astro.url.searchParams.get("period") ?? "week") as "day" | "week" | "month" | "year";
const preset = Astro.url.searchParams.get("preset") ?? undefined;
const expenseSummary = await getExpenseSummary({ from, to, period });
const filterQuery = new URLSearchParams();
if (from) filterQuery.set("from", from);
if (to) filterQuery.set("to", to);
if (period) filterQuery.set("period", period);
if (preset) filterQuery.set("preset", preset);
const filterSuffix = filterQuery.toString() ? `?${filterQuery.toString()}` : "";
const currency = new Intl.NumberFormat("es-VE", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 2,
});

const percentFormatter = new Intl.NumberFormat("es-VE", {
  maximumFractionDigits: 1,
});

const purchasesByCategory = expenseSummary.data.purchasesByCategory ?? [];
const periodLabels: Record<"day" | "week" | "month" | "year", string> = {
  day: "Días",
  week: "Semanas",
  month: "Meses",
  year: "Años",
};

const breakdownLabels = purchasesByCategory[0]?.breakdown.map((item) => item.label) ?? [];
const hasBreakdown = breakdownLabels.length > 0;

const rows = purchasesByCategory.map((item, index) => ({
  category: item.category,
  breakdown: item.breakdown,
  code: `CMP-${String(index + 1).padStart(3, "0")}`,
}));
---

<AdminLayout title="Gastos - Compras por categoria | Admin">
  <div class="p-6 md:p-8 space-y-8">
    
    <a href={`/modules/admin/reports/gastos${filterSuffix}`} class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a gastos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Compras por categoría</h1>
      <p class="text-gray-500 font-medium">Comparativo semanal de compras para detectar desviaciones tempranas.</p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <StatsCard title="Total mensual" value={currency.format(expenseSummary.data.summary.purchasesUsd)} trend={`${expenseSummary.data.summary.purchaseCount} órdenes`} trendUp={true} color="danger">
        <FaCartFlatbed slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Ordenes generadas" value={expenseSummary.data.summary.purchaseCount} trend={`${purchasesByCategory.length} categorías`} trendUp={true} color="primary">
        <FaBoxesStacked slot="icon" size={20} />
      </StatsCard>
    </section>

    <ReportTimeframeFilters client:load title="Filtro de compras" subtitle="Alterna entre periodos diarios, semanales, mensuales y anuales para revisar la compra de insumos." initialPeriod={(Astro.url.searchParams.get("period") as "day" | "week" | "month" | "year") ?? "month"} initialPreset={Astro.url.searchParams.get("preset") ?? undefined} />

    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xl font-semibold text-gray-800">Detalle por {periodLabels[period].toLowerCase()}</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            {period === "week" ? "Últimas semanas" : period === "month" ? "Mes actual" : period === "day" ? "Rango diario" : "Año seleccionado"}
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Categoría</th>
              {hasBreakdown && breakdownLabels.map((label) => (
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">{label}</th>
              ))}
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Variación</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {
              rows.map((row) => (
                <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                  <td class="px-4 py-3 text-sm text-gray-700 font-medium group-hover:text-primary-900">{row.category}</td>
                  {hasBreakdown && row.breakdown.map((bucket, index) => {
                    const prev = row.breakdown[index - 1]?.amountUsd ?? 0;
                    const variation = index === 0 || !prev ? 0 : ((bucket.amountUsd - prev) / prev) * 100;
                    return (
                      <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">
                        <div class="flex flex-col items-end gap-1">
                          <span>{currency.format(bucket.amountUsd)}</span>
                          {index > 0 && (
                            <span class={variation >= 0 ? "text-emerald-600 text-[11px] font-semibold" : "text-rose-600 text-[11px] font-semibold"}>
                              {variation >= 0 ? "+" : ""}{percentFormatter.format(variation)}%
                            </span>
                          )}
                        </div>
                      </td>
                    );
                  })}
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">
                    {row.breakdown.length > 1 ? `${row.breakdown[row.breakdown.length - 1].amountUsd >= row.breakdown[0].amountUsd ? "+" : ""}${percentFormatter.format(((row.breakdown[row.breakdown.length - 1].amountUsd - row.breakdown[0].amountUsd) / (row.breakdown[0].amountUsd || 1)) * 100)}%` : "—"}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>

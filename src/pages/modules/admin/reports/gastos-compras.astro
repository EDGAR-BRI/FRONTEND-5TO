---
import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaCartFlatbed, FaBoxesStacked, FaTruckFast } from "react-icons/fa6";

const rows = [
  { category: "Insumos medicos", week1: "$1,120", week2: "$1,340", week3: "$1,210", week4: "$1,310" },
  { category: "Material descartable", week1: "$520", week2: "$680", week3: "$590", week4: "$640" },
  { category: "Laboratorio", week1: "$860", week2: "$910", week3: "$940", week4: "$1,020" },
];
---

<AdminLayout title="Gastos - Compras por categoria | Admin">
  <div class="p-6 md:p-8 space-y-8">
    
    <a href="/modules/admin/reports/gastos" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a gastos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Compras por categoría</h1>
      <p class="text-gray-500 font-medium">Comparativo semanal de compras para detectar desviaciones tempranas.</p>
    </header>

    <ReportTimeframeFilters client:visible title="Filtro de compras" subtitle="Alterna entre periodos diarios, semanales, mensuales y anuales para revisar la compra de insumos." />

    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xl font-semibold text-gray-800">Detalle semanal</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            Ultimas 4 semanas
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Categoría</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Semana 1</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Semana 2</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Semana 3</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Semana 4</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {
              rows.map((row) => (
                <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                  <td class="px-4 py-3 text-sm text-gray-700 font-medium group-hover:text-primary-900">{row.category}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{row.week1}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{row.week2}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{row.week3}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{row.week4}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>
---
export const prerender = true;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaFaceSmile, FaStar, FaUserCheck } from "react-icons/fa6";

const ratings = [
  { area: "Recepcion", score: "4.6/5", nps: "72", comments: "Atencion agil" },
  { area: "Consulta", score: "4.7/5", nps: "78", comments: "Explicaciones claras" },
  { area: "Caja", score: "4.2/5", nps: "61", comments: "Tiempo de espera" },
  { area: "Farmacia", score: "4.5/5", nps: "69", comments: "Stock estable" },
];
---

<AdminLayout title="Resultados - Satisfaccion | Admin">
  <div class="p-6 md:p-8 space-y-8">
    
    <a href="/modules/admin/reports/resultados" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a resultados
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Satisfacción de pacientes</h1>
      <p class="text-gray-500 font-medium">Análisis de experiencia en cada punto del flujo de atención.</p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatsCard title="Satisfacción global" value="89%" trend="1.7%" trendUp={true} color="success">
        <FaFaceSmile slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="NPS general" value="70" trend="1.2%" trendUp={true} color="primary">
        <FaStar slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Encuestas respondidas" value="386" trend="3.3%" trendUp={true} color="warning">
        <FaUserCheck slot="icon" size={20} />
      </StatsCard>
    </section>

    <ReportTimeframeFilters client:load title="Filtro de satisfacción" subtitle="Evalúa la experiencia por día, semana, mes o año y detecta cambios en la percepción del paciente." />

    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xl font-semibold text-gray-800">Percepción por área</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            Encuesta post consulta
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Area</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Calificación</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">NPS</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Comentario recurrente</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {
              ratings.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                  <td class="px-4 py-3 text-sm text-gray-700 font-medium group-hover:text-primary-900">{item.area}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{item.score}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{item.nps}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-600 italic font-medium">{item.comments}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>
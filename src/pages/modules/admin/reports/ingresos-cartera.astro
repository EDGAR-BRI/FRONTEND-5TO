---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaFileInvoiceDollar, FaHourglassHalf, FaCircleExclamation } from "react-icons/fa6";
import { getIncomeSummary } from "@/lib/services/report/income.service";

const incomeSummary = await getIncomeSummary();
const currency = new Intl.NumberFormat("es-VE", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 2,
});

const carteraAseguradoras = incomeSummary.data.receivables.items.slice(0, 8).map((item) => ({
  ente: `${item.patientName} / ${item.specialty}`,
  dias: item.daysOutstanding,
  pendiente: currency.format(item.pendingUsd),
  estado: item.daysOutstanding > 60 ? "Vencida" : item.daysOutstanding > 30 ? "Por vencer" : "Corriente",
}));
---

<AdminLayout title="Ingresos - Cartera de Activos | Admin">
  <div class="p-6 md:p-8 space-y-8">
    <a href="/modules/admin/reports/ingresos" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline">
      <FaArrowLeft size={12} /> Volver a ingresos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Cuentas por Cobrar (Activos)</h1>
      <p class="text-gray-500 font-medium">Análisis de saldo pendiente y antigüedad de facturas clínicas.</p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatsCard title="Cartera Total" value={currency.format(incomeSummary.data.receivables.totalOutstandingUsd)} trend={`${incomeSummary.data.receivables.overdueCount} vencidas`} trendUp={false} color="warning">
        <FaFileInvoiceDollar slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Antigüedad Promedio" value={`${incomeSummary.data.receivables.averageAgeDays.toFixed(0)} Días`} trend={`${incomeSummary.data.receivables.overdueCount} vencidas`} trendUp={false} color="success">
        <FaHourglassHalf slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Facturas Vencidas" value={incomeSummary.data.receivables.overdueCount} subText="Más de 60 días" color="danger">
        <FaCircleExclamation slot="icon" size={20} />
      </StatsCard>
    </section>

    <ReportTimeframeFilters client:load title="Análisis de Cartera" subtitle="Revisa los saldos deudores para asegurar la liquidez del patrimonio." />

    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xl font-semibold text-gray-800">Cuentas Pendientes por Paciente</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            Saldos Deudores
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-primary-900">Paciente / Especialidad</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-primary-900">Días</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-primary-900">Saldo Pendiente</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-primary-900">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {carteraAseguradoras.map((c) => (
              <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                <td class="px-4 py-3 text-sm text-gray-700 font-bold group-hover:text-primary-900">{c.ente}</td>
                <td class="px-4 py-3 text-sm text-right text-gray-700 font-medium">{c.dias}</td>
                <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{c.pendiente}</td>
                <td class="px-4 py-3 text-sm text-right font-black text-gray-900">{c.estado}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AdminLayout>

---
export const prerender = true;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { Button } from "@/components/react/primary/Button";
import { Badge } from "@/components/react/primary/Badge";
import { PieChartReport } from "@/components/react/admin/PieChartReport";

import {
    FaFilePdf,
    FaPrint,
    FaMobileScreenButton,
    FaBuildingColumns,
    FaFileInvoiceDollar,
    FaArrowTrendUp,
    FaMoneyBill1Wave,
    FaCreditCard,
    FaWallet,
    FaFileExcel,
    FaScaleBalanced,
    FaChartLine,
} from "react-icons/fa6";

// Datos para Cierre de Caja
const cajaMetodosPago = [
    { metodo: "Efectivo (USD)", monto: 540, ops: 12, percentage: 35, color: "#3b82f6", icon: FaMoneyBill1Wave }, 
    { metodo: "Tarjeta Débito", monto: 380, ops: 8, percentage: 25, color: "#10b981", icon: FaCreditCard }, 
    { metodo: "Pago Móvil (VES)", monto: 200, ops: 15, percentage: 13, color: "#f59e0b", icon: FaMobileScreenButton }, 
    { metodo: "Zelle", monto: 120, ops: 2, percentage: 8, color: "#94a3b8", icon: FaWallet }, 
    { metodo: "Transferencia", monto: 300, ops: 5, percentage: 19, color: "#6366f1", icon: FaBuildingColumns }, 
];

// Datos para Libro de Ventas
const facturasRecientes = [
    { numero: "FAC-001", fecha: "2026-04-05", cliente: "Juan Pérez", base: 100.00, iva: 16.00, total: 116.00, status: "Pagado" },
    { numero: "FAC-002", fecha: "2026-04-05", cliente: "María García", base: 250.00, iva: 40.00, total: 290.00, status: "Pagado" },
    { numero: "FAC-003", fecha: "2026-04-05", cliente: "Clínica San José", base: 1200.00, iva: 192.00, total: 1392.00, status: "Pendiente" },
];

const totalCaja = cajaMetodosPago.reduce((acc, curr) => acc + curr.monto, 0);
---

<AdminLayout title="Reportes Financieros | Admin">
    <div class="p-6 md:p-8 space-y-8">
        <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Reporte de Caja y Facturación</h1>
                <p class="text-gray-500 mt-1 font-medium">Análisis consolidado de ingresos y salud financiera.</p>
            </div>
            <div class="flex gap-3">
                <Button label="Exportar PDF" variant="secondary"><FaFilePdf size={14} /> Exportar PDF</Button>
                <Button label="Imprimir Reporte" variant="primary"><FaPrint size={14} /> Imprimir Reporte</Button>
            </div>
        </header>

        {/* Tarjetas de Resumen */}
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <StatsCard title="Recaudado Hoy" value={`$${totalCaja.toLocaleString()}`} trend="15%" trendUp={true} color="success"><FaFileInvoiceDollar slot="icon" size={20} /></StatsCard>
            <StatsCard title="Transacciones" value="42" trend="8%" trendUp={true} color="primary"><FaMobileScreenButton slot="icon" size={20} /></StatsCard>
            <StatsCard title="Pendiente Conciliar" value="$45.00" trend="Sincronizado" trendUp={true} color="warning"><FaBuildingColumns slot="icon" size={20} /></StatsCard>
            <StatsCard title="Utilidad Bruta" value="82%" trend="1.2%" trendUp={true} color="primary"><FaArrowTrendUp slot="icon" size={20} /></StatsCard>
        </section>

        {/* 1. SECCIÓN: CIERRE DE CAJA (Gráfico) */}
        <section class="bg-primary-100 rounded-2xl border border-primary-200 p-8 shadow-sm">
            <h2 class="text-lg font-bold text-gray-800 mb-10">Distribución de Ingresos por Canal</h2>
            <div class="flex flex-col lg:flex-row items-center justify-around gap-12">
                <div class="relative w-full max-w-md">
                    <PieChartReport client:load data={cajaMetodosPago} />
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                        <span class="text-[10px] uppercase font-bold text-gray-400 tracking-[0.2em] mb-1">Cierre Total</span>
                        <span class="text-4xl font-black text-gray-800 leading-none">${totalCaja.toLocaleString()}</span>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4 w-full lg:max-w-md">
                    {cajaMetodosPago.map((item) => (
                        <article class="bg-white p-4 rounded-xl border border-gray-100 shadow-sm flex items-center justify-between group transition-all duration-300">
                            <div class="flex items-center gap-4">
                                <div class="p-2.5 rounded-lg text-white shadow-sm" style={`background-color: ${item.color}`}><item.icon size={18} /></div>
                                <div>
                                    <h3 class="text-sm font-medium text-gray-700">{item.metodo}</h3>
                                    <p class="text-[10px] text-gray-400 font-medium uppercase tracking-wider">{item.ops} transacciones</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-base font-black text-gray-800">${item.monto}</p>
                                <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-gray-50 text-gray-500 border border-gray-200">{item.percentage}%</span>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        {/* 2. SECCIÓN: LIBRO DE VENTAS */}
        <section class="bg-primary-100 rounded-2xl border border-primary-200 p-8 shadow-sm">
            <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
                <div>
                    <h2 class="text-lg font-bold text-gray-800">Libro de Ventas Diario</h2>
                    <p class="text-sm text-gray-500 font-medium tracking-tight">Registro contable para declaración de impuestos e IVA.</p>
                </div>
            </header>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-separate border-spacing-y-2">
                    <thead>
                        <tr class="text-[10px] uppercase font-bold text-gray-400 tracking-widest">
                            <th class="px-4 py-2 text-center">Nro.</th><th class="px-4 py-2">Cliente</th><th class="px-4 py-2 text-right">Base</th><th class="px-4 py-2 text-right">IVA</th><th class="px-4 py-2 text-right">Total</th><th class="px-4 py-2 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {facturasRecientes.map((fac) => (
                            <tr class="bg-white hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-4 rounded-l-xl border-y border-l border-gray-100 text-sm font-bold text-primary-600">{fac.numero}</td>
                                <td class="px-4 py-4 border-y border-gray-100 text-sm font-medium text-gray-700">{fac.cliente}</td>
                                <td class="px-4 py-4 border-y border-gray-100 text-sm font-medium text-gray-600 text-right">${fac.base.toFixed(2)}</td>
                                <td class="px-4 py-4 border-y border-gray-100 text-sm font-medium text-gray-400 text-right">${fac.iva.toFixed(2)}</td>
                                <td class="px-4 py-4 border-y border-gray-100 text-sm font-black text-gray-800 text-right">${fac.total.toFixed(2)}</td>
                                <td class="px-4 py-4 rounded-r-xl border-y border-r border-gray-100 text-center">
    							<span class={`text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-tighter ${
        							fac.status === 'Pagado' 
        							? 'bg-emerald-100 text-emerald-600' 
        							: 'bg-amber-100 text-amber-600'
    								}`}>
        							{fac.status}
    							</span>
								</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

		{/* 3. SECCIÓN: BALANCE Y ESTADO DE RESULTADOS*/}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            
            {/* Balance General */}
            <section class="bg-primary-100 rounded-2xl border border-primary-200 p-8 flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold text-gray-800 mb-6 flex items-center gap-2">
                        <FaScaleBalanced size={18} className="text-primary-500" /> Balance General
                    </h2>
                    <div class="space-y-4">
                        <div class="bg-white p-4 rounded-xl border border-gray-100 flex justify-between items-center text-sm">
                            <span class="font-medium text-gray-500 tracking-tight">Activos (Caja/Bancos)</span>
                            <span class="font-bold text-success">+$24,500.00</span>
                        </div>
                        <div class="bg-white p-4 rounded-xl border border-gray-100 flex justify-between items-center text-sm">
                            <span class="font-medium text-gray-500 tracking-tight">Pasivos (Honorarios)</span>
                            <span class="font-bold text-gray-800">-$12,200.00</span>
                        </div>
                        <div class="p-4 opacity-0 select-none">Espaciador</div>
                    </div>
                </div>

                <div class="pt-6 border-t border-primary-200 flex justify-between items-center mt-4">
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest leading-none">Patrimonio Neto</span>
                        <span class="text-3xl font-black text-primary-600 tracking-tight leading-none mt-2">$12,300.00</span>
                    </div>
                    <div class="p-3 bg-primary-500/10 rounded-xl">
                        <FaBuildingColumns className="text-primary-600" size={20} />
                    </div>
                </div>
            </section>

            {/* Estado de Resultados */}
            <section class="bg-primary-100 rounded-2xl border border-primary-200 p-8 flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold text-gray-800 mb-6 flex items-center gap-2">
                        <FaChartLine size={18} className="text-primary-500" /> Estado de Resultados
                    </h2>
                    <div class="space-y-4 px-2">
                        <div class="flex justify-between items-center text-sm font-medium text-gray-600">
                            <span>Ingresos Operativos</span>
                            <span>$45,200</span>
                        </div>
                        <div class="flex justify-between items-center text-sm font-normal text-gray-400">
                            <span>Gastos Administrativos</span>
                            <span>-$8,400</span>
                        </div>
                        <div class="flex justify-between items-center text-sm font-normal text-gray-400">
                            <span>Mantenimiento</span>
                            <span>-$2,100</span>
                        </div>
                    </div>
                </div>

                <div class="pt-6 border-t border-primary-200 flex justify-between items-center mt-4">
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest leading-none">Utilidad Neta</span>
                        <span class="text-3xl font-black text-gray-800 tracking-tight leading-none mt-2">$34,700.00</span>
                    </div>
                    <div class="p-3 bg-success/10 rounded-xl">
                        <FaArrowTrendUp className="text-success" size={20} />
                    </div>
                </div>
            </section>
        </div>

    </div>
</AdminLayout>
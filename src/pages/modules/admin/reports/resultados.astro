<AdminLayout title="Reporte de Resultados | Admin">
	<div class="space-y-8">
		<header class="space-y-2">
			<h1 class="text-3xl font-bold text-gray-800">Reporte de Resultados</h1>
			<p class="text-gray-500">KPIs de calidad asistencial y desempeno economico con reportes especializados.</p>

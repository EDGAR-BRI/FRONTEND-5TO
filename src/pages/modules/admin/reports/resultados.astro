---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ActionCard from "@/components/react/primary/ActionCard";
import { Badge } from "@/components/react/primary/Badge";
import StaticCard from "@/components/react/primary/StaticCard";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { Button } from "@/components/react/primary/Button";
import {
    FaArrowRight,
    FaArrowTrendUp,
    FaChartLine,
    FaFileCircleCheck,
    FaUserCheck,
    FaFilePdf,
    FaPrint
} from "react-icons/fa6";

const concreteReports = [
    {
        title: "Resultados clínicos",
        description: "Evolución de casos cerrados, seguimiento y efectividad de tratamientos.",
        href: "/modules/admin/reports/resultados-clinicos",
        badge: "Calidad",
    },
    {
        title: "Satisfacción de pacientes",
        description: "NPS, recomendaciones y nivel de conformidad por área.",
        href: "/modules/admin/reports/resultados-satisfaccion",
        badge: "Experiencia",
    },
    {
        title: "Resultado financiero",
        description: "Margen operativo, cumplimiento de metas y desempeño por servicio.",
        href: "/modules/admin/reports/resultados-financieros",
        badge: "Rentabilidad",
    },
];

const goals = [
    { metric: "Adherencia a protocolos", goal: "90%", real: "94%", gap: "+4%", status: "Excedido" },
    { metric: "Satisfacción post consulta", goal: "85%", real: "89%", gap: "+4%", status: "Excedido" },
    { metric: "Recurrencia no planificada", goal: "<10%", real: "8%", gap: "-2%", status: "Normal" },
];
---

<AdminLayout title="Reporte de Resultados | Admin">
    <div class="p-6 md:p-8 space-y-8">
        <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Reporte de Resultados</h1>
                <p class="text-gray-500 mt-1">KPIs de calidad asistencial y desempeño económico.</p>
            </div>
            <div class="flex gap-3">
                <Button label="Exportar PDF" variant="secondary"><FaFilePdf size={14} /> Exportar PDF</Button>
                <Button label="Imprimir Reporte" variant="primary"><FaPrint size={14} /> Imprimir Reporte</Button>
            </div>
        </header>

        {/* TARJETAS DE ESTADÍSTICAS AL TOPE */}
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <StatsCard title="Atenciones Exitosas" value="94%" trend="2.3%" trendUp={true} color="success">
                <FaFileCircleCheck slot="icon" size={20} />
            </StatsCard>
            <StatsCard title="Pacientes Satisfechos" value="89%" trend="1.7%" trendUp={true} color="primary">
                <FaUserCheck slot="icon" size={20} />
            </StatsCard>
            <StatsCard title="Crecimiento Mensual" value="11.2%" trend="0.9%" trendUp={true} color="success">
                <FaArrowTrendUp slot="icon" size={20} />
            </StatsCard>
            <StatsCard title="Meta Cumplida" value="92%" trend="3.0%" trendUp={true} color="warning">
                <FaChartLine slot="icon" size={20} />
            </StatsCard>
        </section>

        {/* FILTROS CON ESPACIO */}
        <ReportTimeframeFilters client:load title="Filtros de resultados" subtitle="Mueve los indicadores clínicos y financieros entre cortes temporales." />

        <div class="space-y-8 mt-8">
            <section class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                <div class="xl:col-span-2 space-y-6">
    <div class="flex items-center justify-between px-1">
        <h2 class="text-2xl font-bold text-gray-800">Reportes concretos de resultados</h2>
        
        <span class="px-4 py-1.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-primary-100 text-primary-600 border border-primary-200 shadow-sm">
            Cierre semanal
        </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        {
            concreteReports.map((report) => (
                <a href={report.href} class="block group">
                    <ActionCard className="h-full p-6 items-start justify-between border-primary-100 hover:border-primary-500 transition-all shadow-sm hover:shadow-md">
                        <div class="space-y-4">
                            <span class="inline-block px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-tight bg-primary-50 text-primary-600 border border-primary-100 group-hover:bg-primary-600 group-hover:text-white transition-colors">
                                {report.badge}
                            </span>

                            <h3 class="text-xl font-bold text-gray-800 group-hover:text-primary-600 transition-colors leading-tight">
                                {report.title}
                            </h3>
                            
                            {/* Descripción*/}
                            <p class="text-sm text-gray-500 leading-relaxed font-medium">
                                {report.description}
                            </p>
                        </div>
						<div class="text-primary-400 mt-4 group-hover:text-primary-600 group-hover:translate-x-1 transition-all">
							<FaArrowRight size={18} />
							</div>
							</ActionCard>
							</a>
							))
						}
					</div>
				</div>

                <div class="h-full">
                    <StaticCard className="h-full border-primary-200 flex flex-col justify-center p-6">
                        <div class="space-y-6">
                            <h2 class="text-base font-black text-gray-400 uppercase tracking-[0.15em]">
                                Resumen de impacto
                            </h2>
                            <div class="space-y-4">
                                <p class="text-base text-gray-700 font-semibold leading-relaxed">
                                    Las tres metas clínicas principales cerraron arriba de objetivo.
                                </p>
                                <div class="flex items-center gap-3">
                                     <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-green-600 border border-green-100 shadow-sm">
                                        <FaFileCircleCheck size={20} />
                                     </div>
                                     <span class="text-sm font-bold text-green-700 bg-green-50 px-3 py-1 rounded-lg border border-green-200">
                                        Desempeño sostenido
                                     </span>
                                </div>
                            </div>
                        </div>
                    </StaticCard>
                </div>
            </section>

            {/* TABLA DE CUMPLIMIENTO */}
            <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4">
                <h2 class="text-xl font-semibold text-gray-800">Cumplimiento de objetivos</h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-primary-300">
                        <thead class="bg-primary-300">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Indicador</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Meta</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Real</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Estado</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-primary-300">
                            {goals.map((row) => (
                                <tr class="hover:bg-primary-500/20 transition-colors cursor-default">
                                    <td class="px-4 py-3 text-sm text-cool-gray-90 font-medium">{row.metric}</td>
                                    <td class="px-4 py-3 text-sm text-right text-cool-gray-90 font-bold">{row.goal}</td>
                                    <td class="px-4 py-3 text-sm text-right text-cool-gray-90 font-bold">{row.real}</td>
                                    <td class="px-4 py-3 text-sm text-right">
                                        <span class={`font-semibold ${
                                            row.status === 'Excedido' ? 'text-green-600' : 'text-primary-600'
                                        }`}>
                                            {row.status}
                                        </span>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</AdminLayout>
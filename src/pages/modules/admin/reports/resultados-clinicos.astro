---
export const prerender = true;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaFileCircleCheck, FaHeartPulse, FaShieldHeart } from "react-icons/fa6";

const metrics = [
  { indicator: "Casos cerrados", goal: "320", actual: "338", status: "Sobre meta" },
  { indicator: "Complicaciones", goal: "< 5%", actual: "3.8%", status: "Controlado" },
  { indicator: "Seguimientos completos", goal: "85%", actual: "88%", status: "Sobre meta" },
];
---

<AdminLayout title="Resultados - Clínicos | Admin">
  <div class="p-6 md:p-8 space-y-8">
    <a href="/modules/admin/reports/resultados" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a resultados
    </a>
    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Resultados clínicos</h1>
      <p class="text-gray-500 font-medium">Calidad asistencial, efectividad y seguimiento de casos cerrados.</p>
    </header>
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatsCard title="Casos exitosos" value="94%" trend="2.2%" trendUp={true} color="success">
        <FaFileCircleCheck slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Eventos adversos" value="3.8%" trend="0.7%" trendUp={false} color="danger">
        <FaHeartPulse slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Adherencia protocolo" value="92%" trend="1.5%" trendUp={true} color="primary">
        <FaShieldHeart slot="icon" size={20} />
      </StatsCard>
    </section>

    <ReportTimeframeFilters client:load title="Filtro clínico" subtitle="Revisa resultados clínicos por día, semana, mes o año para comparar calidad y seguimiento." />
    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-gray-800">Panel de indicadores</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            Cierre mensual
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Indicador</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Meta</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Real</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {
              metrics.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                  <td class="px-4 py-3 text-sm text-gray-700 font-medium group-hover:text-primary-900">{item.indicator}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-700 font-bold">{item.goal}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-700 font-bold">{item.actual}</td>
                  <td class="px-4 py-3 text-sm text-right font-bold">
                    <span class={item.status === "Sobre meta" ? "text-emerald-600" : "text-primary-600"}>
                      {item.status}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>
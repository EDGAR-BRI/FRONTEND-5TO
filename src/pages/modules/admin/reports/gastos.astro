---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ActionCard from "@/components/react/primary/ActionCard";
import { Button } from "@/components/react/primary/Button";
import StaticCard from "@/components/react/primary/StaticCard";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { getExpenseSummary } from "@/lib/services/report/expense.service";
import {
    FaArrowRight,
    FaCartFlatbed,
    FaFileInvoiceDollar,
    FaUsersGear,
    FaHandHoldingDollar,
    FaTriangleExclamation,
    FaFilePdf,
    FaPrint,
    FaScaleBalanced,
    FaMoneyBillTransfer
} from "react-icons/fa6";

const from = Astro.url.searchParams.get("from") ?? undefined;
const to = Astro.url.searchParams.get("to") ?? undefined;
const period = Astro.url.searchParams.get("period") ?? undefined;
const preset = Astro.url.searchParams.get("preset") ?? undefined;
const expenseSummary = await getExpenseSummary({ from, to });
const filterQuery = new URLSearchParams();
if (from) filterQuery.set("from", from);
if (to) filterQuery.set("to", to);
if (period) filterQuery.set("period", period);
if (preset) filterQuery.set("preset", preset);
const filterSuffix = filterQuery.toString() ? `?${filterQuery.toString()}` : "";
const currency = new Intl.NumberFormat("es-VE", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 2,
});

const expenseBreakdown = expenseSummary.data.breakdownByCategory.map((item) => ({
    category: item.category,
    amount: currency.format(item.amountUsd),
    weight: `${item.percentage.toFixed(1)}%`,
}));

const coreExpenseModules = [
        {
        title: "Compras e Insumos",
        description: "Control de inventario médico, reactivos y materiales descartables.",
        href: `/modules/admin/reports/gastos-compras${filterSuffix}`,
        badge: "Operativo",
        icon: FaCartFlatbed
    },
    {
        title: "Servicios y Terceros",
        description: "Gastos en servicios públicos, mantenimiento y proveedores externos.",
        href: `/modules/admin/reports/gastos-servicios${filterSuffix}`,
        badge: "Contratos",
        icon: FaHandHoldingDollar
    },
    {
        title: "Gestión de Nómina",
        description: "Desglose de honorarios médicos, personal administrativo y cargas sociales.",
        href: `/modules/admin/reports/gastos-nomina${filterSuffix}`,
        badge: "Recursos Humanos",
        icon: FaUsersGear
    },
];
---

<AdminLayout title="Reporte de Gastos | Admin">
    <div class="p-6 md:p-8 space-y-8">
        
        <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Reporte de Gastos</h1>
                <p class="text-gray-500 mt-1">Vista general de egresos y reportes financieros concretos.</p>
            </div>
            <div class="flex gap-3">
                <Button label="Exportar PDF" variant="secondary"><FaFilePdf size={14} /> Exportar PDF</Button>
                <Button label="Imprimir Reporte" variant="primary"><FaPrint size={14} /> Imprimir Reporte</Button>
            </div>
        </header>

        {/* TARJETAS DE ESTADÍSTICAS */}
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <StatsCard title="Gasto Total" value={currency.format(expenseSummary.data.summary.totalExpenseUsd)} trend={`${Math.abs(expenseSummary.data.summary.expenseTrendPct).toFixed(1)}%`} trendUp={expenseSummary.data.summary.expenseTrendPct >= 0} color="warning">
                <FaCartFlatbed slot="icon" size={20} />
            </StatsCard>
            
            <StatsCard title="Facturas de Gasto" value={expenseSummary.data.summary.invoiceExpenseCount} trend={`${expenseSummary.data.summary.opexUsd.toFixed(1)} USD`} trendUp={true} color="primary">
                <FaFileInvoiceDollar slot="icon" size={20} />
            </StatsCard>

            <StatsCard title="Nómina Total" value={currency.format(expenseSummary.data.summary.payrollUsd + expenseSummary.data.summary.salaryAdminUsd)} trend={`${expenseSummary.data.summary.payrollDoctorCount + expenseSummary.data.summary.payrollSalaryCount} registros`} trendUp={true} color="success">
                <FaScaleBalanced slot="icon" size={20} />
            </StatsCard>
        </section>

        {/* FILTROS */}
        <ReportTimeframeFilters client:load title="Filtros de gastos" subtitle="Revisa egresos por días, semanas, mes o años y cambia rápidamente entre rangos." initialPeriod={(Astro.url.searchParams.get("period") as "day" | "week" | "month" | "year") ?? "month"} initialPreset={Astro.url.searchParams.get("preset") ?? undefined} />

        <div class="space-y-8 mt-8">
            <section class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                <div class="xl:col-span-2 space-y-6">
                    <div class="flex items-center justify-between px-1">
                        <h2 class="text-2xl font-bold text-gray-800">Módulos de Egresos</h2>
                        <span class="px-4 py-1.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-primary-100 text-primary-600 border border-primary-200 shadow-sm">
                            Control Interno
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                        {coreExpenseModules.map((report) => (
                            <a href={report.href} class="block group">
                                <ActionCard className="h-full p-6 items-start justify-between border-primary-100 hover:border-primary-500 transition-all shadow-sm hover:shadow-md">
                                    <div class="space-y-4">
                                        <div class="flex justify-between items-start">
                                            <span class="inline-block px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-tight bg-primary-50 text-primary-600 border border-primary-100 group-hover:bg-primary-600 group-hover:text-white transition-colors">
                                                {report.badge}
                                            </span>
                                            <report.icon className="text-primary-300 group-hover:text-primary-500 transition-colors" size={22} />
                                        </div>
                                        
                                        <h3 class="text-xl font-bold text-gray-800 group-hover:text-primary-600 transition-colors leading-tight">
                                            {report.title}
                                        </h3>
                                        
                                        <p class="text-sm text-gray-500 leading-relaxed font-medium">
                                            {report.description}
                                        </p>
                                    </div>
                                    
                                    <div class="text-primary-400 mt-4 group-hover:text-primary-600 group-hover:translate-x-1 transition-all">
                                        <FaArrowRight size={18} />
                                    </div>
                                </ActionCard>
                            </a>
                        ))}
                    </div>
                </div>

                {/* ALERTAS DE COSTO */}
                <div class="h-full">
                    <StaticCard className="h-full border-primary-200 flex flex-col justify-center p-6">
                        <div class="space-y-6">
                            <h2 class="text-base font-black text-gray-400 uppercase tracking-[0.15em]">
                                Alertas de costo
                            </h2>
                            <div class="space-y-4">
                                {expenseSummary.data.alerts.map((alert) => (
                                <div class={`p-3 rounded-xl border text-sm flex gap-3 items-start shadow-sm ${alert.severity === 'danger' ? 'border-red-200 bg-red-50 text-red-700' : alert.severity === 'warning' ? 'border-amber-200 bg-amber-50 text-amber-700' : alert.severity === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-blue-200 bg-blue-50 text-blue-700'}`}>
                                    <FaTriangleExclamation className="mt-1 shrink-0" size={16} />
                                    <span class="font-medium leading-tight">{alert.message}</span>
                                </div>
                                ))}
                            </div>
                        </div>
                    </StaticCard>
                </div>
            </section>

            {/* TABLA DE EGRESOS */}
            <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4">
                <h2 class="text-xl font-semibold text-gray-800">Desglose rápido de egresos</h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-primary-300">
                        <thead class="bg-primary-300">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Categoría</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Monto</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Participación</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-primary-300">
                            {expenseBreakdown.map((item) => (
                                <tr class="hover:bg-primary-500/20 transition-colors cursor-default">
                                    <td class="px-4 py-3 text-sm text-cool-gray-90 font-medium">{item.category}</td>
                                    <td class="px-4 py-3 text-sm text-right text-cool-gray-90 font-bold">{item.amount}</td>
                                    <td class="px-4 py-3 text-sm text-right text-cool-gray-60 font-bold">{item.weight}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</AdminLayout>

---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ActionCard from "@/components/react/primary/ActionCard";
import { Button } from "@/components/react/primary/Button";
import StaticCard from "@/components/react/primary/StaticCard";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { getIncomeSummary } from "@/lib/services/report/income.service";
import {
    FaArrowRight,
    FaStethoscope,
    FaChartLine,
    FaFilePdf,
    FaPrint,
    FaSackDollar,
    FaMoneyCheckDollar
} from "react-icons/fa6";

const from = Astro.url.searchParams.get("from") ?? undefined;
const to = Astro.url.searchParams.get("to") ?? undefined;
const period = Astro.url.searchParams.get("period") ?? undefined;
const preset = Astro.url.searchParams.get("preset") ?? undefined;
const incomeSummary = await getIncomeSummary({ from, to });
const filterQuery = new URLSearchParams();
if (from) filterQuery.set("from", from);
if (to) filterQuery.set("to", to);
if (period) filterQuery.set("period", period);
if (preset) filterQuery.set("preset", preset);
const filterSuffix = filterQuery.toString() ? `?${filterQuery.toString()}` : "";

const currency = new Intl.NumberFormat("es-VE", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 2,
});

const revenueBreakdown = incomeSummary.data.breakdownBySpecialty.map((item) => ({
    category: item.specialty,
    amount: currency.format(item.incomeUsd),
    weight: `${item.percentage.toFixed(1)}%`,
}));

const coreRevenueModules = [
        {
        title: "Ventas por Servicio",
        description: "Desglose de ingresos operativos por especialidad médica y consultas facturadas.",
        href: `/modules/admin/reports/ingresos-servicios${filterSuffix}`,
        badge: "Ingreso Bruto",
        icon: FaStethoscope
    },
    {
        title: "Recaudación y Caja",
        description: "Liquidación de pagos recibidos, medios de pago y saldo pendiente de facturas.",
        href: `/modules/admin/reports/ingresos-recaudacion${filterSuffix}`,
        badge: "Flujo Efectivo",
        icon: FaMoneyCheckDollar
    },
];
---

<AdminLayout title="Gestión de Ingresos | Admin">
    <div class="p-6 md:p-8 space-y-8">
        
        <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Reporte de Ingresos</h1>
                <p class="text-gray-500 mt-1">Análisis de facturación, recaudo y realización del ingreso por consultas.</p>
            </div>
            <div class="flex gap-3">
                <Button label="Exportar PDF" variant="secondary"><FaFilePdf size={14} /> Exportar PDF</Button>
                <Button label="Imprimir Reporte" variant="primary"><FaPrint size={14} /> Imprimir Reporte</Button>
            </div>
        </header>

        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6">
            <StatsCard title="Ingreso Bruto Total" value={currency.format(incomeSummary.data.summary.grossIncomeUsd)} trend={`${Math.abs(incomeSummary.data.summary.grossIncomeTrendPct).toFixed(1)}%`} trendUp={incomeSummary.data.summary.grossIncomeTrendPct >= 0} color="success">
                <FaSackDollar slot="icon" size={20} />
            </StatsCard>

            <StatsCard title="Tasa de Recaudo" value={`${incomeSummary.data.summary.collectionRate.toFixed(1)}%`} trend={`${Math.abs(incomeSummary.data.summary.collectedTrendPct).toFixed(1)}%`} trendUp={incomeSummary.data.summary.collectedTrendPct >= 0} color="primary">
                <FaChartLine slot="icon" size={20} />
            </StatsCard>
        </section>

        <ReportTimeframeFilters client:load title="Filtros de Ingresos" subtitle="Auditoría de ingresos por ciclo contable: diario, semanal, mensual o anual." initialPeriod={(Astro.url.searchParams.get("period") as "day" | "week" | "month" | "year") ?? "month"} initialPreset={Astro.url.searchParams.get("preset") ?? undefined} />

        <div class="space-y-8 mt-8">
            <section class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                <div class="xl:col-span-2 space-y-6">
                    <div class="flex items-center justify-between px-1">
                        <h2 class="text-2xl font-bold text-gray-800">Ciclo de Ingresos Operativos</h2>
                        <span class="px-4 py-1.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-primary-100 text-primary-600 border border-primary-200 shadow-sm">
                            Consultas facturadas
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-5">
                        {coreRevenueModules.map((report) => (
                            <a href={report.href} class="block group">
                                <ActionCard className="h-full p-6 items-start justify-between border-primary-100 hover:border-primary-500 transition-all shadow-sm hover:shadow-md">
                                    <div class="space-y-4">
                                        <div class="flex justify-between items-start">
                                            <span class="inline-block px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-tight bg-primary-50 text-primary-600 border border-primary-100 group-hover:bg-primary-600 group-hover:text-white transition-colors">
                                                {report.badge}
                                            </span>
                                            <report.icon className="text-primary-300 group-hover:text-primary-500 transition-colors" size={22} />
                                        </div>
                                        
                                        <h3 class="text-xl font-bold text-gray-800 group-hover:text-primary-600 transition-colors leading-tight">
                                            {report.title}
                                        </h3>
                                        
                                        <p class="text-sm text-gray-500 leading-relaxed font-medium">
                                            {report.description}
                                        </p>
                                    </div>
                                    
                                    <div class="text-primary-400 mt-4 group-hover:text-primary-600 group-hover:translate-x-1 transition-all">
                                        <FaArrowRight size={18} />
                                    </div>
                                </ActionCard>
                            </a>
                        ))}
                    </div>
                </div>

                {/* ALERTAS DE INGRESOS */}
                <div class="h-full">
                    <StaticCard className="h-full border-primary-200 flex flex-col justify-center p-6">
                        <div class="space-y-6">
                            <h2 class="text-base font-black text-gray-400 uppercase tracking-[0.15em]">
                                Alertas de Cobro
                            </h2>
                            <div class="space-y-4">
                                {incomeSummary.data.alerts.map((alert) => (
                                    <div class={`p-3 rounded-xl border text-sm flex gap-3 items-start shadow-sm ${alert.severity === 'danger' ? 'border-red-200 bg-red-50 text-red-700' : alert.severity === 'warning' ? 'border-amber-200 bg-amber-50 text-amber-700' : alert.severity === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-blue-200 bg-blue-50 text-blue-700'}`}>
                                        <FaMoneyCheckDollar className="mt-1 shrink-0" size={16} />
                                        <span class="font-medium leading-tight">{alert.message}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </StaticCard>
                </div>
            </section>

            <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4">
                <h2 class="text-xl font-semibold text-gray-800">Composición del Ingreso Operativo</h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-primary-300">
                        <thead class="bg-primary-300">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Especialidad</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Ingreso Facturado</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Peso en Ingresos</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-primary-300">
                            {revenueBreakdown.map((item) => (
                                <tr class="hover:bg-primary-500/20 transition-colors cursor-default">
                                    <td class="px-4 py-3 text-sm text-cool-gray-90 font-medium">{item.category}</td>
                                    <td class="px-4 py-3 text-sm text-right text-cool-gray-90 font-bold">{item.amount}</td>
                                    <td class="px-4 py-3 text-sm text-right text-cool-gray-60 font-bold">{item.weight}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</AdminLayout>

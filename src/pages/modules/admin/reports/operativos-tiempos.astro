---
export const prerender = true;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaArrowsLeftRight, FaClock, FaHourglassHalf } from "react-icons/fa6";
import TiemposBarChart from "@/components/react/admin/TiemposRadarChart";

const durations = [
  { area: "Medicina general", consult: "18 min", wait: "12 min", transfer: "4 min" },
  { area: "Pediatria", consult: "22 min", wait: "15 min", transfer: "5 min" },
  { area: "Cardiologia", consult: "28 min", wait: "19 min", transfer: "6 min" },
  { area: "Dermatologia", consult: "16 min", wait: "9 min", transfer: "3 min" },
];
---

<AdminLayout title="Operativos - Tiempos | Admin">
  <div class="p-6 md:p-8 space-y-8">
    <a href="/modules/admin/reports/operativos" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700">
      <FaArrowLeft size={12} /> Volver a operativos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800">Tiempos de atención</h1>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatsCard title="Espera" value="14 min" trend="1.3%" trendUp={false} color="warning"><FaHourglassHalf slot="icon" size={20} /></StatsCard>
      <StatsCard title="Consulta" value="21 min" trend="0.4%" trendUp={true} color="primary"><FaClock slot="icon" size={20} /></StatsCard>
      <StatsCard title="Transfer" value="4.5 min" trend="0.2%" trendUp={false} color="danger"><FaArrowsLeftRight slot="icon" size={20} /></StatsCard>
    </section>

    <ReportTimeframeFilters client:load title="Filtro de tiempos" />
    <div class="mt-8">
      <section class="bg-white rounded-xl border border-primary-200 p-8 shadow-sm">
        <h2 class="text-xl font-bold text-gray-800 mb-6">Comparativa de Tiempos</h2>
        <TiemposBarChart client:only="react" data={durations} />
      </section>
    </div>

    {/* TABLA */}
    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
       <h2 class="text-xl font-semibold text-gray-800">Detalle por área</h2>
       <div class="overflow-x-auto">
         <table class="min-w-full divide-y divide-primary-300">
           <thead class="bg-primary-300">
             <tr>
               <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-primary-900">Área</th>
               <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-primary-900">Consulta</th>
               <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-primary-900">Espera</th>
               <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-primary-900">Transferencia</th>
             </tr>
           </thead>
           <tbody class="divide-y divide-primary-300">
             {durations.map((item) => (
               <tr class="hover:bg-primary-500/20 transition-colors">
                 <td class="px-4 py-3 text-sm font-medium">{item.area}</td>
                 <td class="px-4 py-3 text-sm text-right font-bold">{item.consult}</td>
                 <td class="px-4 py-3 text-sm text-right font-bold">{item.wait}</td>
                 <td class="px-4 py-3 text-sm text-right font-bold">{item.transfer}</td>
               </tr>
             ))}
           </tbody>
         </table>
       </div>
    </section>
  </div>
</AdminLayout>
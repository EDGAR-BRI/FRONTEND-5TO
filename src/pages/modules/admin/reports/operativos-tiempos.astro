---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaClock, FaHourglassHalf, FaStethoscope } from "react-icons/fa6";
import TiemposAreaChart from "@/components/react/admin/TiemposAreaChart";
import { getOperativosTiempos } from "@/lib/services/report/operativos.service";

const from = Astro.url.searchParams.get("from") ?? undefined;
const to = Astro.url.searchParams.get("to") ?? undefined;
const period = (Astro.url.searchParams.get("period") as "day" | "week" | "month" | "year") ?? undefined;
const preset = Astro.url.searchParams.get("preset") ?? undefined;
const report = await getOperativosTiempos({ from, to, period });

const filterQuery = new URLSearchParams();
if (from) filterQuery.set("from", from);
if (to) filterQuery.set("to", to);
if (period) filterQuery.set("period", period);
if (preset) filterQuery.set("preset", preset);
const filterSuffix = filterQuery.toString() ? `?${filterQuery.toString()}` : "";

const durations = report.data.bySpecialty.map((item) => ({
  area: item.area,
  consult: `${item.consult.toFixed(1)} min`,
  consultations: item.consultations,
}));
---

<AdminLayout title="Operativos - Tiempos | Admin">
  <div class="p-6 md:p-8 space-y-8">
    

    <a href={`/modules/admin/reports/operativos${filterSuffix}`} class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a operativos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Tiempos de atención</h1>
      <p class="text-gray-500 font-medium">Análisis de flujo y tiempos de espera por especialidad médica.</p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatsCard title="Consulta promedio" value={`${report.data.stats.avgConsultTime.toFixed(1)} min`} trend="1.3%" trendUp={false} color="warning">
        <FaHourglassHalf slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Consultas" value={report.data.stats.totalConsultations} trend="0.4%" trendUp={true} color="primary">
        <FaClock slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Hora pico" value={report.data.stats.peakHour} trend="0.2%" trendUp={false} color="danger">
        <FaStethoscope slot="icon" size={20} />
      </StatsCard>
    </section>
    <ReportTimeframeFilters client:load title="Filtro de tiempos" subtitle="Ajusta el rango para visualizar la eficiencia operativa por áreas." initialPeriod={(Astro.url.searchParams.get("period") as "day" | "week" | "month" | "year") ?? "month"} initialPreset={Astro.url.searchParams.get("preset") ?? undefined} />

    <div class="mt-8">
      <section class="bg-white rounded-xl border border-primary-200 p-8 shadow-sm">
        <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
            <div>
                <h2 class="text-xl font-bold text-gray-800">Curva de Permanencia</h2>
                <p class="text-sm text-gray-500 font-medium">Comparativa visual entre tiempo de consulta y volumen de consultas por especialidad.</p>
            </div>
            <div class="flex gap-4 text-[10px] font-black uppercase tracking-widest">
                <span class="flex items-center gap-2 text-blue-600">
                    <span class="w-3 h-3 rounded-full bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.5)]"></span> 
                    Tiempo promedio
                </span>
                <span class="flex items-center gap-2 text-red-500">
                    <span class="w-3 h-3 rounded-full bg-red-400 shadow-[0_0_8px_rgba(248,113,113,0.5)]"></span> 
                    Consultas realizadas
                </span>
            </div>
        </div>
        
        <TiemposAreaChart client:only="react" data={durations} />
      </section>
    </div>
    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-gray-800">Detalle por área</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            {report.data.stats.peakHour} pico
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900 border-b border-primary-400/20">Área</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900 border-b border-primary-400/20">Tiempo promedio</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900 border-b border-primary-400/20">Consultas realizadas</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {
              durations.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                  <td class="px-4 py-3 text-sm text-gray-700 font-medium group-hover:text-primary-900">{item.area}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-700 font-bold">{item.consult}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-700 font-bold">{item.consultations}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>

---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Badge } from "@/components/react/primary/Badge";
import StaticCard from "@/components/react/primary/StaticCard";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaArrowsLeftRight, FaClock, FaHourglassHalf } from "react-icons/fa6";

const durations = [
  { area: "Medicina general", consult: "18 min", wait: "12 min", transfer: "4 min" },
  { area: "Pediatria", consult: "22 min", wait: "15 min", transfer: "5 min" },
  { area: "Cardiologia", consult: "28 min", wait: "19 min", transfer: "6 min" },
  { area: "Dermatologia", consult: "16 min", wait: "9 min", transfer: "3 min" },
];
---

<AdminLayout title="Operativos - Tiempos | Admin">
  <div class="space-y-6">
    <a href="/modules/admin/reports/operativos" class="inline-flex items-center gap-2 text-sm text-primary-700 hover:underline">
      <FaArrowLeft size={12} /> Volver a operativos
    </a>

    <header class="space-y-2">
      <h1 class="text-2xl font-bold text-gray-800">Tiempos de atencion</h1>
      <p class="text-gray-500">Duracion real de consulta y espera por especialidad.</p>
    </header>

    <ReportTimeframeFilters client:visible title="Filtro de tiempos" subtitle="Ajusta el corte temporal para revisar duración, espera y transferencia por día, semana, mes o año." />

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <StatsCard title="Espera promedio" value="14 min" trend="1.3%" trendUp={false} color="warning"><FaHourglassHalf slot="icon" size={18} /></StatsCard>
      <StatsCard title="Consulta promedio" value="21 min" trend="0.4%" trendUp={true} color="primary"><FaClock slot="icon" size={18} /></StatsCard>
      <StatsCard title="Transferencia entre areas" value="4.5 min" trend="0.2%" trendUp={false} color="danger"><FaArrowsLeftRight slot="icon" size={18} /></StatsCard>
    </section>

    <StaticCard>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-800">Detalle por area</h2>
          <Badge>Corte diario</Badge>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-primary-300">
            <thead class="bg-primary-300">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Area</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Consulta</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Espera</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Transferencia</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary-300">
              {durations.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors">
                  <td class="px-4 py-3 text-sm text-cool-gray-90">{item.area}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.consult}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.wait}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.transfer}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </StaticCard>
  </div>
</AdminLayout>

---
import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaArrowsLeftRight, FaClock, FaHourglassHalf } from "react-icons/fa6";
import TiemposAreaChart from "@/components/react/admin/TiemposAreaChart";

const durations = [
  { area: "Medicina general", consult: "18 min", wait: "12 min", transfer: "4 min" },
  { area: "Pediatria", consult: "22 min", wait: "15 min", transfer: "5 min" },
  { area: "Cardiologia", consult: "28 min", wait: "19 min", transfer: "6 min" },
  { area: "Dermatologia", consult: "16 min", wait: "9 min", transfer: "3 min" },
];
---

<AdminLayout title="Operativos - Tiempos | Admin">
  <div class="p-6 md:p-8 space-y-8">
    

    <a href="/modules/admin/reports/operativos" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a operativos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Tiempos de atención</h1>
      <p class="text-gray-500 font-medium">Análisis de flujo y tiempos de espera por especialidad médica.</p>
    </header>

    <ReportTimeframeFilters client:visible title="Filtro de tiempos" subtitle="Ajusta el corte temporal para revisar duración, espera y transferencia por día, semana, mes o año." />

    <div class="mt-8">
      <section class="bg-white rounded-xl border border-primary-200 p-8 shadow-sm">
        <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
            <div>
                <h2 class="text-xl font-bold text-gray-800">Curva de Permanencia</h2>
                <p class="text-sm text-gray-500 font-medium">Comparativa visual entre tiempo de consulta y espera.</p>
            </div>
            <div class="flex gap-4 text-[10px] font-black uppercase tracking-widest">
                <span class="flex items-center gap-2 text-blue-600">
                    <span class="w-3 h-3 rounded-full bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.5)]"></span> 
                    Consulta
                </span>
                <span class="flex items-center gap-2 text-red-500">
                    <span class="w-3 h-3 rounded-full bg-red-400 shadow-[0_0_8px_rgba(248,113,113,0.5)]"></span> 
                    Espera
                </span>
            </div>
        </div>
        
        <TiemposAreaChart client:only="react" data={durations} />
      </section>
    </div>
    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-gray-800">Detalle por área</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            Corte semanal
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900 border-b border-primary-400/20">Área</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900 border-b border-primary-400/20">Consulta</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900 border-b border-primary-400/20">Espera</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900 border-b border-primary-400/20">Transferencia</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {
              durations.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                  <td class="px-4 py-3 text-sm text-gray-700 font-medium group-hover:text-primary-900">{item.area}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-700 font-bold">{item.consult}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-700 font-bold">{item.wait}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-700 font-bold">{item.transfer}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>
---
import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaChartLine, FaCircleExclamation, FaMoneyBillTrendUp } from "react-icons/fa6";

const months = [
  { month: "Enero", total: "$9,480", delta: "+1.2%" },
  { month: "Febrero", total: "$10,020", delta: "+5.7%" },
  { month: "Marzo", total: "$11,360", delta: "+13.4%" },
  { month: "Abril", total: "$12,450", delta: "+9.6%" },
];
---

<AdminLayout title="Gastos - Variacion mensual | Admin">
  <div class="p-6 md:p-8 space-y-8">
    
    <a href="/modules/admin/reports/gastos" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a gastos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Variación mensual de egresos</h1>
      <p class="text-gray-500 font-medium">Evolución de gastos para identificar picos y sostenibilidad de costos.</p>
    </header>

    <ReportTimeframeFilters client:visible title="Filtro de variacion" subtitle="Analiza la evolución del gasto por día, semana, mes o año y compara el comportamiento histórico." />

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <StatsCard title="Variacion acumulada" value="+9.6%" trend="2.8%" trendUp={false} color="danger"><FaMoneyBillTrendUp slot="icon" size={18} /></StatsCard>
      <StatsCard title="Mes con mayor pico" value="Marzo" subText="+$1,340 vs Febrero" color="warning"><FaChartLine slot="icon" size={18} /></StatsCard>
      <StatsCard title="Alertas abiertas" value="2" subText="Requiere revision" color="danger"><FaCircleExclamation slot="icon" size={18} /></StatsCard>
    </section>

    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xl font-semibold text-gray-800">Histórico reciente</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            4 meses
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Mes</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Total</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Variación</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {
              months.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                  <td class="px-4 py-3 text-sm text-gray-700 font-medium group-hover:text-primary-900">{item.month}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{item.total}</td>
                  <td class={`px-4 py-3 text-sm text-right font-bold ${item.delta.startsWith('+') ? 'text-red-600' : 'text-emerald-600'}`}>
                    {item.delta}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>
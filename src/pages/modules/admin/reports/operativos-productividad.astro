---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Badge } from "@/components/react/primary/Badge";
import StaticCard from "@/components/react/primary/StaticCard";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaGaugeHigh, FaStethoscope, FaUserDoctor } from "react-icons/fa6";

const doctors = [
  { name: "Dra. Ramos", attended: 22, avgTime: "19 min", saturation: "83%" },
  { name: "Dr. Ledezma", attended: 19, avgTime: "21 min", saturation: "77%" },
  { name: "Dra. Quispe", attended: 24, avgTime: "18 min", saturation: "91%" },
  { name: "Dr. Nuñez", attended: 17, avgTime: "23 min", saturation: "72%" },
];
---

<AdminLayout title="Operativos - Productividad | Admin">
  <div class="space-y-6">
    <a href="/modules/admin/reports/operativos" class="inline-flex items-center gap-2 text-sm text-primary-700 hover:underline">
      <FaArrowLeft size={12} /> Volver a operativos
    </a>

    <header class="space-y-2">
      <h1 class="text-2xl font-bold text-gray-800">Productividad medica</h1>
      <p class="text-gray-500">Rendimiento por profesional para balancear carga asistencial.</p>
    </header>

    <ReportTimeframeFilters client:visible title="Filtro de productividad" subtitle="Compara productividad médica por día, semana, mes o año y ubica picos de saturación." />

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <StatsCard title="Medicos en turno" value="12" trend="0.0%" trendUp={true} color="primary"><FaUserDoctor slot="icon" size={18} /></StatsCard>
      <StatsCard title="Atenciones promedio" value="20" trend="3.1%" trendUp={true} color="success"><FaStethoscope slot="icon" size={18} /></StatsCard>
      <StatsCard title="Saturacion promedio" value="81%" trend="1.7%" trendUp={false} color="warning"><FaGaugeHigh slot="icon" size={18} /></StatsCard>
    </section>

    <StaticCard>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-800">Productividad por medico</h2>
          <Badge>Turno manana</Badge>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-primary-300">
            <thead class="bg-primary-300">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Medico</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Atenciones</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Tiempo prom.</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Saturacion</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary-300">
              {doctors.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors">
                  <td class="px-4 py-3 text-sm text-cool-gray-90">{item.name}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.attended}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.avgTime}</td>
                  <td class="px-4 py-3 text-sm text-right text-cool-gray-60">{item.saturation}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </StaticCard>
  </div>
</AdminLayout>

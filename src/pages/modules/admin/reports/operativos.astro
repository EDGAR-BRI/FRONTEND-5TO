---
export const prerender = true;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ActionCard from "@/components/react/primary/ActionCard";
import { Badge } from "@/components/react/primary/Badge";
import ReportBackendSnapshot from "@/components/react/admin/reports/ReportBackendSnapshot";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import StaticCard from "@/components/react/primary/StaticCard";
import {
	FaArrowRight,
	FaCalendarCheck,
	FaClock,
	FaHospitalUser,
	FaStethoscope,
	FaUserDoctor,
} from "react-icons/fa6";

const concreteReports = [
	{
		title: "Carga y puntualidad de citas",
		description: "Horas de mayor demanda, ausencias y cumplimiento por turno.",
		href: "/modules/admin/reports/operativos-citas",
		badge: "Agenda",
	},
	{
		title: "Tiempos de atencion",
		description: "Duracion por especialidad y tiempo promedio de espera por bloque.",
		href: "/modules/admin/reports/operativos-tiempos",
		badge: "Flujo",
	},
	{
		title: "Productividad medica",
		description: "Atenciones por medico, saturacion y capacidad disponible.",
		href: "/modules/admin/reports/operativos-productividad",
		badge: "Equipo",
	},
];

const slotsByTime = [
	{ slot: "07:00 - 09:00", occupancy: "71%", status: "Normal" },
	{ slot: "09:00 - 11:00", occupancy: "88%", status: "Alto" },
	{ slot: "11:00 - 13:00", occupancy: "93%", status: "Critico" },
	{ slot: "14:00 - 16:00", occupancy: "82%", status: "Alto" },
];
---

<AdminLayout title="Reporte Operativo | Admin">
	<div class="space-y-8">
		<header class="space-y-2">
			<h1 class="text-3xl font-bold text-gray-800">Reporte Operativo</h1>
			<p class="text-gray-500">Seguimiento de capacidad, tiempos y productividad con acceso a reportes detallados.</p>
		</header>

		<ReportTimeframeFilters client:load title="Filtros operativos" subtitle="Agrupa la actividad asistencial por día, semana, mes o año según el nivel de detalle que necesites." />

		<ReportBackendSnapshot client:load scope="operativos" />

		<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
			<StatsCard title="Citas Programadas" value="148" trend="8.2%" trendUp={true} color="primary">
				<FaCalendarCheck slot="icon" size={20} />
			</StatsCard>
			<StatsCard title="Tiempo Promedio" value="23 min" trend="1.1%" trendUp={false} color="warning">
				<FaClock slot="icon" size={20} />
			</StatsCard>
			<StatsCard title="Pacientes Atendidos" value="127" trend="6.4%" trendUp={true} color="success">
				<FaHospitalUser slot="icon" size={20} />
			</StatsCard>
			<StatsCard title="Médicos Activos" value="18" trend="0.0%" trendUp={true} color="primary">
				<FaUserDoctor slot="icon" size={20} />
			</StatsCard>
		</section>


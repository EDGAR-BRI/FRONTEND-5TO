---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaUsers, FaChartPie, FaPercent } from "react-icons/fa6";
import { getExpenseSummary } from "@/lib/services/report/expense.service";

const from = Astro.url.searchParams.get("from") ?? undefined;
const to = Astro.url.searchParams.get("to") ?? undefined;
const period = Astro.url.searchParams.get("period") ?? undefined;
const preset = Astro.url.searchParams.get("preset") ?? undefined;
const expenseSummary = await getExpenseSummary({ from, to });
const filterQuery = new URLSearchParams();
if (from) filterQuery.set("from", from);
if (to) filterQuery.set("to", to);
if (period) filterQuery.set("period", period);
if (preset) filterQuery.set("preset", preset);
const filterSuffix = filterQuery.toString() ? `?${filterQuery.toString()}` : "";
const currency = new Intl.NumberFormat("es-VE", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 2,
});

const payrollData = [
  ...expenseSummary.data.payrollBySpecialty.map((item) => ({
    group: item.specialty,
    amount: currency.format(item.amountUsd),
    tax: currency.format(0),
    net: currency.format(item.amountUsd),
  })),
  ...expenseSummary.data.salaryByRole.map((item) => ({
    group: item.role,
    amount: currency.format(item.amountUsd),
    tax: currency.format(0),
    net: currency.format(item.amountUsd),
  })),
];
---

<AdminLayout title="Gastos - Nómina Contable | Admin">
  <div class="p-6 md:p-8 space-y-8">
    
    <a href={`/modules/admin/reports/gastos${filterSuffix}`} class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a gastos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Nómina y Cargas Sociales</h1>
      <p class="text-gray-500 font-medium">Análisis de gastos de personal y retenciones de ley que afectan la utilidad del ejercicio.</p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatsCard title="Gasto Salarial Bruto" value={currency.format(expenseSummary.data.summary.payrollUsd + expenseSummary.data.summary.salaryAdminUsd)} trend={`${expenseSummary.data.summary.payrollDoctorCount + expenseSummary.data.summary.payrollSalaryCount} registros`} trendUp={true} color="primary">
        <FaUsers slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Pagos a Doctores" value={currency.format(expenseSummary.data.summary.payrollUsd)} subText="Por consultas" color="warning">
        <FaChartPie slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Pagos por Rol" value={currency.format(expenseSummary.data.summary.salaryAdminUsd)} subText="Administrativos / operativos" color="danger">
        <FaPercent slot="icon" size={20} />
      </StatsCard>
    </section>

    <ReportTimeframeFilters client:load title="Corte de Nómina" subtitle="Desglose de honorarios y salarios para conciliación bancaria." initialPeriod={(Astro.url.searchParams.get("period") as "day" | "week" | "month" | "year") ?? "month"} initialPreset={Astro.url.searchParams.get("preset") ?? undefined} />

    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xl font-semibold text-gray-800">Asientos de Nómina por Categoría</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            Resumen Operativo
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Grupo de Personal</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Monto Bruto</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Cargas/Imp.</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Monto Neto</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {
              payrollData.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                  <td class="px-4 py-3 text-sm text-gray-700 font-medium group-hover:text-primary-900">{item.group}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{item.amount}</td>
                  <td class="px-4 py-3 text-sm text-right text-red-600 font-medium">{item.tax}</td>
                  <td class="px-4 py-3 text-sm text-right text-emerald-700 font-black">{item.net}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AdminLayout>

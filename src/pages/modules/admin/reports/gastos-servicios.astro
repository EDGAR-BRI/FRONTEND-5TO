---
export const prerender = true;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import { StatsCard } from "@/components/react/primary/StatsCard";
import { FaArrowLeft, FaClipboardCheck, FaClock, FaHandshakeSimple } from "react-icons/fa6";

const providers = [
  { name: "Medisupply", avgOrder: "$540", onTime: "96%", variation: "+2.1%" },
  { name: "LabStore", avgOrder: "$620", onTime: "89%", variation: "+6.5%" },
  { name: "BioCare", avgOrder: "$470", onTime: "92%", variation: "-1.4%" },
  { name: "Clinix", avgOrder: "$510", onTime: "87%", variation: "+4.3%" },
];
---

<AdminLayout title="Gastos - Proveedores | Admin">
  <div class="p-6 md:p-8 space-y-8">
    
    <a href="/modules/admin/reports/gastos" class="inline-flex items-center gap-2 text-sm font-bold text-primary-700 hover:underline group">
      <FaArrowLeft size={12} className="group-hover:-translate-x-1 transition-transform" /> 
      Volver a gastos
    </a>

    <header class="space-y-2">
      <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Rendimiento de proveedores</h1>
      <p class="text-gray-500 font-medium">Control de costo por orden y nivel de cumplimiento en entregas.</p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatsCard title="Proveedores activos" value="14" trend="0.0%" trendUp={true} color="primary">
        <FaHandshakeSimple slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Cumplimiento promedio" value="91%" trend="1.6%" trendUp={true} color="success">
        <FaClipboardCheck slot="icon" size={20} />
      </StatsCard>
      <StatsCard title="Retraso promedio" value="2.3 dias" trend="0.8%" trendUp={false} color="warning">
        <FaClock slot="icon" size={20} />
      </StatsCard>
    </section>

    <ReportTimeframeFilters client:load title="Filtro de proveedores" subtitle="Consulta rendimiento y puntualidad por día, semana, mes o año para detectar variaciones de abastecimiento." />

    <section class="bg-primary-100 rounded-xl border border-primary-200 p-6 space-y-4 mt-8">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xl font-semibold text-gray-800">Top proveedores</h2>
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-primary-300 text-primary-900 border border-primary-400/20">
            Ordenado por costo
        </span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-primary-300">
          <thead class="bg-primary-300">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-primary-900">Proveedor</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Costo promedio</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Cumplimiento</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-primary-900">Variación</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-300">
            {
              providers.map((item) => (
                <tr class="hover:bg-primary-500/20 transition-colors cursor-default group">
                  <td class="px-4 py-3 text-sm text-gray-700 font-medium group-hover:text-primary-900">{item.name}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{item.avgOrder}</td>
                  <td class="px-4 py-3 text-sm text-right text-gray-800 font-bold">{item.onTime}</td>
                  <td class={`px-4 py-3 text-sm text-right font-bold ${item.variation.startsWith('+') ? 'text-red-600' : 'text-emerald-600'}`}>
                    {item.variation}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

  </div>
</AdminLayout>
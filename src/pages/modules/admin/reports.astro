---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ReportTimeframeFilters from "@/components/react/primary/ReportTimeframeFilters";
import DailyBookPdfButton from "@/components/react/admin/reports/DailyBookPdfButton";
import IncomeStatementPdfButton from "@/components/react/admin/reports/IncomeStatementPdfButton";
import RevenueTimelineChart from "@/components/react/admin/reports/RevenueTimelineChart";
import SpecialtyDemandChart from "@/components/react/admin/reports/SpecialtyDemandChart";

const from = Astro.url.searchParams.get("from") ?? undefined;
const to = Astro.url.searchParams.get("to") ?? undefined;
const period = (Astro.url.searchParams.get("period") as "day" | "week" | "month" | "year" | null) ?? "month";
const preset = Astro.url.searchParams.get("preset") ?? undefined;
---

<AdminLayout title="Reportes y Estadísticas | Admin">
	<div class="p-6 md:p-8 space-y-8">
		<header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
			<div>
				<h1 class="text-3xl font-bold text-gray-800">Reportes Financieros y de Uso</h1>
				<p class="text-gray-500 mt-1">Análisis de rendimiento, ingresos y distribución de pacientes.</p>
			</div>
			<div class="flex flex-col lg:flex-row gap-3 w-full sm:w-auto">
				<DailyBookPdfButton client:load />
				<IncomeStatementPdfButton client:load />
			</div>
		</header>

		<ReportTimeframeFilters
			client:visible
			title="Filtros del centro de reportes"
			subtitle="Filtra el tablero general por día, semana, mes o año antes de revisar ingresos y demanda."
			initialPeriod={period}
			initialPreset={preset ?? undefined}
		/>

		<section class="grid grid-cols-1 xl:grid-cols-3 gap-6 mt-6">
			<div class="xl:col-span-2">
				<RevenueTimelineChart client:load from={from} to={to} period={period} />
			</div>
			<SpecialtyDemandChart client:load from={from} to={to} />
		</section>
	</div>
</AdminLayout>

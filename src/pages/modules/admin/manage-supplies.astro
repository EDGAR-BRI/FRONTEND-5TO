---
export const prerender = true;

import MainLayout from '@/layouts/AdminLayout.astro';
import SuppliesInventoryDashboard from '@/components/react/admin/SuppliesInventoryDashboard';
---

<MainLayout title="Admin | Insumos">
	<section class="p-8 space-y-6">
		<header class="space-y-1">
			<h1 class="text-2xl font-semibold text-primary-800">Gestión de insumos</h1>
			<p class="text-sm text-cool-gray-70">
				Inventario de la clínica: precios y stock.
			</p>
		</header>

		<SuppliesInventoryDashboard forcedType={"INSUMO"} client:only="react" />
	</section>
</MainLayout>

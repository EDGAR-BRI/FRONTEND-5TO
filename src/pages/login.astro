---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import fondo from "@/assets/fondo.avif";
import UserLogo from "@/assets/User.png";
import LoginForm from "@/components/react/auth/LoginForm";
import Logo from "@/components/logo.astro";
---

<Layout>
  <main class="flex flex-row bg-white min-h-screen w-full">
    <section
      class="relative bg-primary-700 w-0 lg:w-3/5 md:w-1/2 flex items-center justify-center overflow-hidden"
    >
      <img
        class="absolute inset-0 w-full h-full object-cover opacity-40"
        src={fondo.src}
        alt="Fondo"
      />
      <div class="absolute inset-0 bg-primary-700/60" aria-hidden="true"></div>
      <div class="z-50 h-72 w-full flex items-center justify-center">
        <Logo logoClass="h-72 w-auto" />
      </div>
    </section>
    <section
      class="lg:w-2/5 md:w-1/2 w-full flex flex-col py-6 px-6 md:py-5 md:px-10 justify-center"
    >
      <header class="flex flex-col gap-2 pt-4 md:pt-0">
        <h2 class="text-xl font-bold">Bienvenido</h2>
        <p class="text-gray-400 text-sm">
          Monitor participant enrollment across all clinical trial sites
        </p>
      </header>
      <main
        class="flex-1 flex flex-col items-center justify-center px-0 md:px-16"
      >
        <div class="w-full max-w-md flex flex-col gap-2">
          <div class="flex items-center justify-center mb-10">
            <img class="w-40 h-auto object-contain" src={UserLogo.src} alt="" />
          </div>
          <LoginForm
            client:load
            className="flex flex-col gap-8 border-b-2 border-b-gray-400 pb-16"
          />
          <footer class="flex flex-col gap-4 items-center">
            <!-- <div class="border-t border-gray-400 w-full"></div> -->
            <a class="text-gray-400 font-bold text-sm" href=""
              >¿Olvidaste tu contraseña?</a
            >
            <a class="text-gray-400 font-bold text-sm" href="/register"
              >¿No tienes una cuenta?</a
            >
          </footer>
        </div>
      </main>
    </section>
  </main>
</Layout>

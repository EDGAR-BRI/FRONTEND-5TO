---
import Layout from "@/layouts/Layout.astro";
import Input from "@/components/astro/Input.astro";
import clinica from "@/assets/clinica.png";
import UserLogo from "@/assets/User.png";
---

<Layout>
    <main class="flex flex-row bg-white h-screen w-screen">
        <section class="bg-blue-500 w-3/5 flex items-center justify-center">
            <img src={clinica.src} alt="Clinica" />
        </section>
        <section class="w-2/5 flex flex-col py-5 px-10 justify">
            <header class="flex flex-col gap-2">
                <h2 class="text-xl font-bold">Bienvenido</h2>
                <p class="text-gray-400 text-sm">
                    Monitor participant enrollment across all clinical trial
                    sites
                </p>
            </header>
            <main class="flex-1 flex flex-col items-center justify-center">
                <div class="w-full max-w-md flex flex-col gap-2">
                    <div class="flex items-center justify-center mb-10">
                        <img class="w-40" src={UserLogo.src} alt="" />
                    </div>
                    <form
                        class="flex flex-col gap-8 border-b-2 border-b-gray-400 pb-16"
                        action=""
                    >
                        <Input
                            placeholder="Usuario"
                            type="text"
                            name="usuario"
                            id="usuario"
                        />
                        <Input
                            placeholder="Contraseña"
                            type="password"
                            name="contraseña"
                            id="contraseña"
                        />
                        <button
                            class="bg-blue-500 text-white mt-2 p-2 rounded-sm"
                            type="submit">Login</button
                        >
                    </form>
                    <footer class="flex flex-col gap-4 items-center">
                        <!-- <div class="border-t border-gray-400 w-full"></div> -->
                        <a class="text-gray-400 font-bold text-sm" href=""
                            >¿Olvidaste tu contraseña?</a
                        >
                        <a class="text-gray-400 font-bold text-sm" href=""
                            >¿No tienes una cuenta?</a
                        >
                    </footer>
                </div>
            </main>
        </section>
    </main>
</Layout>

---

<ReceptionistLayout title="Gestión de Pagos – Recepción">
  <div class="p-4 sm:p-6 lg:p-8 space-y-6 animate-fade-in w-full min-w-0 overflow-x-hidden">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="overview" class="text-primary-500 hover:text-primary-700 text-body-xs font-medium transition-colors">
            <i class="fa-solid fa-arrow-left mr-1"></i>Dashboard
          </a>
          <span class="text-cool-gray-30">/</span>
          <span class="text-body-xs text-cool-gray-50">Pagos</span>
        </div>
        <h1 class="text-heading-4 text-primary-800">
          <i class="fa-solid fa-dollar-sign text-primary-500 mr-2"></i>
          Gestión de Pagos
        </h1>
        <p class="text-body-s text-cool-gray-50 mt-0.5">
          Registra y monitorea los ingresos del día.
        </p>
      </div>

      <PaymentAction client:load />
    </div>

    <PaymentsTable client:only="react" payments={payments} />

  </div>
</ReceptionistLayout>
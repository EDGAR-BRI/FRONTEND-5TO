  { id: 'PAY-003', patient: 'Marta Sánchez',      time: '10:15 AM', method: 'Tarjeta',       amount: 55.00,  currency: 'USD', status: 'Pendiente',  doctor: 'Dra. Patricia Mora' },
  { id: 'PAY-004', patient: 'Roberto Fuentes',    time: '11:00 AM', method: 'Efectivo',       amount: 40.00,  currency: 'USD', status: 'Completado', doctor: 'Dr. Héctor Torres'  },
  { id: 'PAY-005', patient: 'Carmen López',       time: '11:45 AM', method: 'Transferencia', amount: 80.00,  currency: 'USD', status: 'Completado', doctor: 'Dra. Valentina Ríos'},

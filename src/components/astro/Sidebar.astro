---
import SidebarMenu from "@/components/astro/SidebarMenu.astro";
import type { MenuItems } from "@/types/MenuItemsTypes";
import clinica from "@/assets/clinica.svg";
import { FaArrowRightFromBracket } from "react-icons/fa6";

interface Props {
    menuItems: MenuItems[];
    currentPath: string;
    businessName?: string;
}

const { menuItems, currentPath } = Astro.props;
---

<aside
    id="app-sidebar"
    class="fixed left-0 h-full w-64 bg-primary-700/95 text-primary-100 border-r border-primary-800/70 backdrop-blur-sm z-40 transform transition-transform duration-300 ease-in-out pt-4 overflow-hidden -translate-x-full lg:translate-x-0 flex flex-col shadow-2xl shadow-primary-900/20"
>   
    <a href="/" class="flex items-center justify-center mb-6"   >
        <img src={clinica.src} alt="Logo de la clínica" class="h-30 w-auto mx-auto mb-6" />
    </a>

    <div class="flex-1 overflow-y-auto pb-6">
        <SidebarMenu menuItems={menuItems} currentPath={currentPath} />
    </div>

    <div class="shrink-0 p-4 border-t border-primary-800/70 bg-primary-800/70">
        <a
            href="/logout"
            class={`flex items-center gap-3 px-4 py-3 rounded-md transition-colors group ${
                currentPath === "/logout"
                    ? "bg-primary-800 text-white border-l-2 border-primary-300"
                    : "text-primary-100 hover:bg-primary-800/90 hover:text-white border-l-2 border-transparent"
            }`}
        >
            <FaArrowRightFromBracket
                className={`text-lg transition-colors ${
                    currentPath === "/logout"
                        ? "text-primary-300"
                        : "text-primary-100 group-hover:text-primary-300"
                }`}
            />
            <span class="font-semibold text-sm tracking-wide">
                Cerrar sesión
            </span>
        </a>
    </div>
</aside>

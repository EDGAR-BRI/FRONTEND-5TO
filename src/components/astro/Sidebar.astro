---
import SidebarMenu from "@/components/astro/SidebarMenu.astro";
import type { MenuItems } from "@/types/MenuItemsTypes";
import clinica from "@/assets/clinica.svg";

interface Props {
    menuItems: MenuItems[];
    currentPath: string;
    businessName?: string;
}

const { menuItems, currentPath } = Astro.props;
---

<aside
    id="app-sidebar"
    class="fixed left-0  h-full w-64 bg-primary-700 border-cool-gray-80 z-40 transform transition-transform duration-300 ease-in-out pt-4 overflow-y-auto -translate-x-full lg:translate-x-0"
>   
    <a href="/" class="flex items-center justify-center mb-6"   >
        <img src={clinica.src} alt="Logo de la clínica" class="h-30 w-auto mx-auto mb-6" />
    </a>

    <SidebarMenu menuItems={menuItems} currentPath={currentPath} />

    <div
        class="mt-auto p-4 border-t border-primary-400 absolute bottom-0 w-full"
    >
        <a
            href="/logout"
            class={`flex items-center gap-3 px-4 py-3 rounded-md transition-colors group ${
                currentPath === "/logout"
                       ? "bg-primary-800 text-white border-l-2 border-primary-600"
                    : "text-primary-100 hover:bg-cool-gray-90 hover:text-white"
            }`}
        >
            <i
                class={`fa-solid fa-arrow-right-from-bracket text-lg transition-colors ${
                    currentPath === "/logout"
                           ? "text-primary-600"
                           : "text-primary-100 group-hover:text-primary-600"
                }`}></i>
            <span class="font-semibold text-sm tracking-wide">
                Cerrar sesión
            </span>
        </a>
    </div>
</aside>

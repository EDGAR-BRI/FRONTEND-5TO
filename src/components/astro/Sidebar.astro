---
import SidebarMenu from "@/components/astro/SidebarMenu.astro";
import type { MenuItems } from "@/types/MenuItemsTypes";

interface Props {
    menuItems: MenuItems[];
    currentPath: string;
    businessName?: string;
}

const { menuItems, currentPath } = Astro.props;
---

<aside
    id="app-sidebar"
    class="fixed left-0 top-16 h-[calc(100vh-4rem)] rounded-r-2xl w-64 bg-cool-gray-100 border-r border-cool-gray-80 z-40 transform transition-transform duration-300 ease-in-out pt-4 overflow-y-auto -translate-x-full lg:translate-x-0"
>
    <SidebarMenu menuItems={menuItems} currentPath={currentPath} />

    <div
        class="mt-auto p-4 border-t border-cool-gray-80 absolute bottom-0 w-full"
    >
        <a
            href="/logout"
            class={`flex items-center gap-3 px-4 py-3 rounded-md transition-colors group ${
                currentPath === "/logout"
                    ? "bg-primary-90/50 text-white border-l-2 border-primary-60"
                    : "text-cool-gray-30 hover:bg-cool-gray-90 hover:text-white"
            }`}
        >
            <i
                class={`fa-solid fa-arrow-right-from-bracket text-lg transition-colors ${
                    currentPath === "/logout"
                        ? "text-primary-60"
                        : "text-cool-gray-40 group-hover:text-primary-60"
                }`}></i>
            <span class="font-medium text-sm tracking-wide">
                Cerrar sesión
            </span>
        </a>
    </div>
</aside>

---
import type { IconType } from "react-icons";
import { FaBars, FaHouse, FaMagnifyingGlass, FaPlus, FaUsers } from "react-icons/fa6";

const navItems: { label: string; href: string; icon: IconType }[] = [
	{ label: "Home", href: "/dashboard", icon: FaHouse },
	{ label: "Network", href: "/users", icon: FaUsers },
	{ label: "Create", href: "/create", icon: FaPlus },
	{ label: "Search", href: "/search", icon: FaMagnifyingGlass },
	{ label: "Menu", href: "/menu", icon: FaBars }, // Triggers sidebar or menu page
];

const currentPath = Astro.url.pathname;
---

<nav
    class="fixed bottom-0 left-0 w-full bg-primary-100 border-t border-cool-gray-80 lg:hidden z-50 pb-safe"
>
    <div class="flex justify-around items-center h-16 px-2">
        {
            navItems.map((item) => {
                const isActive =
                    currentPath === item.href ||
                    (item.href !== "/dashboard" &&
                        currentPath.startsWith(item.href));

                // Special handling for Menu
                if (item.label === "Menu") {
                    const Icon = item.icon;
                    return (
                        <button
                            onclick="document.dispatchEvent(new CustomEvent('toggle-sidebar'))"
                            class="flex flex-col items-center justify-center w-full h-full space-y-1 text-cool-gray-40 hover:text-cool-gray-20"
                        >
						<Icon className="h-6 w-6" />
                            <span class="text-[10px] font-medium">
                                {item.label}
                            </span>
                        </button>
                    );
                }

                const Icon = item.icon;

                return (
                    <a
                        href={item.href}
                        data-astro-prefetch="hover"
                        class:list={[
                            "flex flex-col items-center justify-center w-full h-full space-y-1",
                            isActive
                                   ? "text-primary-600"
                                : "text-cool-gray-40 hover:text-cool-gray-20",
                        ]}
                    >
					<Icon className="h-6 w-6" />
                        <span class="text-[10px] font-medium">
                            {item.label}
                        </span>
                    </a>
                );
            })
        }
    </div>
</nav>

<style>
    .pb-safe {
        padding-bottom: env(safe-area-inset-bottom);
    }
</style>

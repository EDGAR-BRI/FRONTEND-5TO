---
// src/components/astro/DoctorProfile.astro
const { doctor } = Astro.props;
---

<div class="space-y-6">
  <section
    class="flex flex-col items-center p-6 bg-primary-100 rounded-xl border border-primary-200 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary-500 hover:shadow-md hover:shadow-primary-500/30 hover:bg-primary-50/30 mb-4"
  >
    <div class="relative group">
      <div
        class="size-32 rounded-full border-4 border-primary-100 p-1 bg-white overflow-hidden"
      >
        <div
          id="profile-preview"
          class="w-full h-full rounded-full bg-cover bg-center shadow-inner flex items-center justify-center bg-primary-50 transition-opacity group-hover:opacity-90"
          style={doctor.photo ? `background-image: url('${doctor.photo}')` : ""}
        >
          {
            !doctor.photo && (
              <i
                id="user-icon"
                class="fa-solid fa-user-doctor text-4xl text-primary-300"
              />
            )
          }
        </div>
      </div>

      <label
        for="photo-upload"
        class="absolute bottom-1 right-1 bg-primary-700 text-white p-2 rounded-full shadow-lg border-2 border-white hover:bg-primary-800 transition-all cursor-pointer hover:scale-110 active:scale-95"
      >
        <i class="fa-solid fa-camera text-xs"></i>
      </label>

      <input type="file" id="photo-upload" accept="image/*" class="hidden" />
    </div>

    <div class="mt-4 text-center">
      <h2 class="text-2xl font-bold text-gray-900">{doctor.name}</h2>
      <p class="text-primary-700 font-semibold">{doctor.specialty}</p>
      <div
        class="flex items-center justify-center gap-2 mt-2 text-gray-500 text-sm"
      >
        <i class="fa-solid fa-location-dot text-xs text-primary-500"></i>
        <span>{doctor.clinic}</span>
      </div>
    </div>
  </section>

  <section class="space-y-4">
    <h3
      class="text-base font-bold flex items-center gap-2 text-primary-800 px-1 uppercase tracking-tight"
    >
      <i class="fa-solid fa-address-book"></i>
      Datos de Contacto
    </h3>
    <div
      class="bg-primary-100 rounded-xl shadow-sm border border-primary-200 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary-500 hover:shadow-md hover:shadow-primary-500/30 hover:bg-primary-50/30 divide-y divide-primary-50/50"
    >
      <div class="p-4 flex items-center gap-4">
        <div
          class="size-10 rounded-lg bg-primary-50 flex items-center justify-center text-primary-700"
        >
          <i class="fa-solid fa-envelope"></i>
        </div>
        <div class="flex-1">
          <p
            class="text-[10px] text-gray-400 uppercase font-bold tracking-wider"
          >
            Correo Electrónico
          </p>
          <p class="text-sm font-medium text-gray-900">{doctor.email}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="pt-4">
    <button
      id="save-profile"
      class="w-full bg-primary-700 hover:bg-primary-800 text-white font-bold py-4 rounded-xl shadow-lg shadow-primary-200 transition-all flex items-center justify-center gap-2"
    >
      <i class="fa-solid fa-floppy-disk"></i>
      Guardar Cambios
    </button>
  </div>
</div>

<script>
  // Lógica para manejar la selección de imagen desde la PC
  const fileInput = document.getElementById("photo-upload") as HTMLInputElement;
  const preview = document.getElementById("profile-preview");
  const userIcon = document.getElementById("user-icon");

  fileInput?.addEventListener("change", (e) => {
    const target = e.target as HTMLInputElement;
    const file = target.files?.[0];

    if (file && preview) {
      const reader = new FileReader();

      reader.onload = (event) => {
        // Cambiamos el fondo del div por la imagen seleccionada
        preview.style.backgroundImage = `url('${event.target?.result}')`;
        // Ocultamos el icono de usuario si existe
        if (userIcon) userIcon.style.display = "none";
      };

      reader.readAsDataURL(file);
    }
  });

  // Evento opcional para el botón guardar
  document.getElementById("save-profile")?.addEventListener("click", () => {
    const file = fileInput?.files?.[0];
    if (file) {
      console.log("Listo para subir archivo:", file.name);
      alert(`Imagen "${file.name}" lista para procesar.`);
    } else {
      alert("No has cambiado la foto todavía.");
    }
  });
</script>

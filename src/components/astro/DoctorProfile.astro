---
// src/components/astro/DoctorProfile.astro
const { doctor } = Astro.props;
---

<div class="space-y-6">
  <section class="flex flex-col items-center p-6 bg-white rounded-xl border border-primary-100 shadow-sm mb-4">
    <div class="relative group">
      <div class="size-32 rounded-full border-4 border-primary-100 p-1 bg-white">
        <div 
          class="w-full h-full rounded-full bg-cover bg-center shadow-inner overflow-hidden flex items-center justify-center bg-primary-50"
          style={doctor.photo ? `background-image: url('${doctor.photo}')` : ''}
        >
          {!doctor.photo && <i class="fa-solid fa-user-doctor text-4xl text-primary-300"></i>}
        </div>
      </div>
      <button class="absolute bottom-1 right-1 bg-primary-700 text-white p-2 rounded-full shadow-lg border-2 border-white hover:bg-primary-800 transition-colors">
        <i class="fa-solid fa-camera text-xs"></i>
      </button>
    </div>
    
    <div class="mt-4 text-center">
      <h2 class="text-2xl font-bold text-gray-900">{doctor.name}</h2>
      <p class="text-primary-700 font-semibold">{doctor.specialty}</p>
      <div class="flex items-center justify-center gap-2 mt-2 text-gray-500 text-sm">
        <i class="fa-solid fa-location-dot text-xs text-primary-500"></i>
        <span>{doctor.clinic}</span>
      </div>
    </div>
  </section>

  <section class="space-y-4">
    <h3 class="text-base font-bold flex items-center gap-2 text-primary-800 px-1 uppercase tracking-tight">
      <i class="fa-solid fa-address-book"></i>
      Datos de Contacto
    </h3>
    <div class="bg-white rounded-xl shadow-sm border border-primary-100 divide-y divide-primary-50">
      <div class="p-4 flex items-center gap-4">
        <div class="size-10 rounded-lg bg-primary-50 flex items-center justify-center text-primary-700">
          <i class="fa-solid fa-envelope"></i>
        </div>
        <div class="flex-1">
          <p class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Correo Electrónico</p>
          <p class="text-sm font-medium text-gray-900">{doctor.email}</p>
        </div>
      </div>
      <div class="p-4 flex items-center gap-4">
        <div class="size-10 rounded-lg bg-primary-50 flex items-center justify-center text-primary-700">
          <i class="fa-solid fa-phone"></i>
        </div>
        <div class="flex-1">
          <p class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Teléfono</p>
          <p class="text-sm font-medium text-gray-900">{doctor.phone}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="pt-4 space-y-3">
    <button class="w-full bg-primary-700 hover:bg-primary-800 text-white font-bold py-4 rounded-xl shadow-lg shadow-primary-200 transition-all flex items-center justify-center gap-2">
      <i class="fa-solid fa-user-pen"></i>
      Guardar Cambios
    </button>
    <button class="w-full border border-red-200 text-red-600 font-medium py-3 rounded-xl hover:bg-red-50 transition-all">
      Cerrar Sesión
    </button>
  </div>
</div>
---
import type { MenuItems } from "@/types/MenuItemsTypes";
import { FaChevronDown } from "react-icons/fa6";

interface Props {
    menuItems: MenuItems[];
    currentPath: string;
}

const { menuItems, currentPath } = Astro.props;

const isPathActive = (targetPath?: string) => {
    if (!targetPath) return false;
    return currentPath === targetPath || currentPath.startsWith(`${targetPath}/`);
};
---

<nav class="px-4 space-y-1">
    {
        menuItems.map((item) => {
            const hasActiveSubItem =
                item.subItems?.some((subItem) => {
                    return isPathActive(subItem.href);
                }) ?? false;

            return (
            <div>
                {item.subItems ? (
                    <details class="group" open={hasActiveSubItem}>
                        <summary
                            class:list={[
                                "w-full flex items-center justify-between px-4 py-3 rounded-md transition-colors cursor-pointer list-none",
                                hasActiveSubItem
                                    ? "bg-primary-800 text-white border-l-2 border-primary-600"
                                    : "text-primary-100 hover:bg-primary-800 hover:text-primary-100 group-hover:text-white",
                            ]}
                        >
                            <div class="flex items-center gap-3">
                                {(() => {
                                    const Icon = item.icon;
                                    if (!Icon || typeof Icon === "string") return null;
                                    return (
                                        <Icon
                                            className={`text-lg transition-colors ${
                                                hasActiveSubItem
                                                    ? "text-primary-600"
                                                    : "text-primary-100 group-hover:text-primary-600"
                                            }`}
                                        />
                                    );
                                })()}
                                <span class="font-medium text-sm tracking-wide">
                                    {item.label}
                                </span>
                            </div>
                            <FaChevronDown
                                class:list={[
                                    "h-4 w-4 transition-transform duration-200 group-open:rotate-180",
                                ]}
                            />
                        </summary>
                        <div class="pl-4 mt-1 space-y-1 border-l-2 border-cool-gray-80 ml-6 sidebar-dropdown-content">
                            {item.subItems.map((subItem) => (
                                <a
                                    href={subItem.href}
                                    class={`flex items-center gap-3 px-4 py-2 text-xs rounded-md transition-colors ${
                                        isPathActive(subItem.href)
                                               ? "text-primary-600 bg-primary-900/20"
                                            : "text-primary-100 hover:text-primary-100 hover:bg-cool-gray-80"
                                    }`}
                                >
								{(() => {
									const Icon = subItem.icon;
									if (!Icon || typeof Icon === "string") return null;
									return <Icon className="text-sm" />;
								})()}
                                    <span>{subItem.label}</span>
                                </a>
                            ))}
                        </div>
                    </details>
                ) : (
                    <div>
                        <a
                            href={item.href}
                            class={`flex items-center gap-6 px-4 py-3 rounded-md transition-colors group ${
                                isPathActive(item.href)
                                       ? "bg-primary-800 text-white border-l-2 border-primary-600"
                                    : "text-primary-100 hover:bg-cool-gray-90 hover:text-white"
                            }`}
                        >
                        {(() => {
                            const Icon = item.icon;
                            if (!Icon || typeof Icon === "string") return null;
                            return (
                                <Icon
                                    className={`text-lg transition-colors ${
                                        isPathActive(item.href)
                                            ? "text-primary-600"
                                            : "text-primary-100 group-hover:text-primary-600"
                                    }`}
                                />
                            );
                        })()}
                            <span class="font-semibold text-sm tracking-wide">
                                {item.label}
                            </span>
                        </a>
                    </div>
                )}
            </div>
        )})
    }
</nav>

<style>
    summary::-webkit-details-marker {
        display: none;
    }
</style>

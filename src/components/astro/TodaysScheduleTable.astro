---
import { getScheduleOverview } from "@/lib/services/scheduling/appointment/appointment.service";
import { ToggleAgendaRows } from "@/components/react/receptionist/ToggleAgendaRows";

const agenda = await getScheduleOverview({ range: "hoy" });

function formatTime(isoString: string): string {
    return isoString.slice(11, 16);
}
function getStatusClass(status: string) {
    switch (status.toUpperCase()) {
        case "REALIZADA":
            return "bg-green-100 text-success border-green-200";
        case "CONFIRMADA":
            return "bg-yellow-100 text-warning border-yellow-200";
        case "SIN CONFIRMAR":
        case "CANCELADA":
            return "bg-cool-gray-10 text-cool-gray-60 border-cool-gray-30";
        default:
            return "bg-cool-gray-10 text-cool-gray-60 border-cool-gray-30";
    }
}
agenda.sort(
    (a, b) => new Date(a.date_time).getTime() - new Date(b.date_time).getTime(),
);
---

<div class="overflow-x-auto">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-heading-6 text-primary-800">Agenda de hoy</h2>
        <a
            href="schedules"
            class="text-body-xs font-medium text-primary-600 hover:underline"
            >Ver todo</a
        >
    </div>
    <table class="w-full text-sm">
        <thead>
            <tr
                class="text-body-xs text-cool-gray-50 border-b border-primary-100"
            >
                <th class="py-2 px-2 text-left font-medium">Hora</th>
                <th class="py-2 px-2 text-left font-medium">Paciente</th>
                <th class="py-2 px-2 text-left font-medium">Especialidad</th>
                <th class="py-2 px-2 text-right font-medium">Estado</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-primary-50">
            {
                agenda.length === 0 ? (
                    <tr>
                        <td colspan="4" class="text-center py-4">
                            <p class="text-body-s text-cool-gray-50">
                                No se han registrado citas hoy.
                            </p>
                        </td>
                    </tr>
                ) : (
                    agenda.map((item, index) => (
                        <tr
                            class={`text-body-s hover:bg-primary-50/50 transition-colors agenda-row${index >= 7 ? " hidden" : ""}`}
                            data-index={index}
                        >
                            <td class="py-3 px-2 font-medium text-primary-700">
                                {formatTime(item.date_time)}
                            </td>
                            <td class="py-3 px-2 text-primary-800">
                                {item.patient.name
                                    ? item.patient.name
                                    : item.patient.user
                                        ? item.patient.user.name
                                        : "No registrado"}
                            </td>
                            <td class="py-3 px-2 text-cool-gray-60">
                                {item.doctor.specialty.name}
                            </td>
                            <td class="py-3 px-2 text-right">
                                <span
                                    class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${getStatusClass(item.status.name)}`}
                                >
                                    {item.status.name.toUpperCase()}
                                </span>
                            </td>
                        </tr>
                    ))
                )
            }
        </tbody>
    </table>
    <ToggleAgendaRows total={agenda.length} client:load />
</div>

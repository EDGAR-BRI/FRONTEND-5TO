---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "@/components/astro/Sidebar.astro";
import BottomNavbar from "@/components/astro/BottomNavbar.astro";
const { title } = Astro.props;

const menuItems = [
	{
		label: "Dashboard General",
		href: `overview`,
		icon: "fa-solid fa-house",
	},
	{
		label: "Gestionar usuarios",
		href: `manage-users`,
		icon: "fa-solid fa-users",
	},
	{
		label: "Gestión de insumos y servicios",
		href: `manage-supplies`,
		icon: "fa-solid fa-boxes-stacked",
	},
	{
		label: "Gestión de gastos e ingresos",
		href: `manage-expenses`,
		icon: "fa-solid fa-money-bill-wave",
	},
	{
		label: "Reportes y estadísticas",
		href: `reports`,
		icon: "fa-solid fa-chart-line",
	},
	{
		label: "Configuración",
		href: `settings`,
		icon: "fa-solid fa-gear",
	},
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
			integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
		<ClientRouter />
	</head>
	<body
		class="bg-primary-100 font-sans antialiased relative overflow-x-hidden"
	>
		<!-- Main Wrapper: Padded on left for desktop sidebar -->
		<div
			id="main-content"
			class="min-h-[calc(100vh-4rem)] flex flex-col lg:pl-64 transition-[padding] duration-300"
		>
			<Sidebar menuItems={menuItems} currentPath={currentPath} />
			<div class="flex-1 pb-16 lg:pb-0">
				<!-- Bottom padding for mobile navbar -->
				<slot />
			</div>
		</div>

		<BottomNavbar />
	</body>
</html>

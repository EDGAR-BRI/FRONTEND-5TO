---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "@/components/astro/Sidebar.astro";
import BottomNavbar from "@/components/astro/BottomNavbar.astro";
const { title } = Astro.props;

const menuItems = [
	{
		label: "Dashboard General",
		href: `overview`,
		icon: "fa-solid fa-house",
	},
	{
		label: "Agendar cita",
		href: `schedule-appointment`,
		icon: "fa-solid fa-calendar-days",
	},
	{
		label: "Historial clínico",
		href: `history`,
		icon: "fa-solid fa-file-medical",
	},
	{
		label: "Perfil",
		href: `profile`,
		icon: "fa-solid fa-user-doctor",
	},
];
	const quickActions = [
	{ label: 'Agendar cita', icon: 'fa-solid fa-calendar-plus', href: 'schedule-appointment', color: 'from-primary-500 to-primary-700' },
	{ label: 'Historial clínico', icon: 'fa-solid fa-file-medical', href: 'history', color: 'from-teal-500 to-teal-700' },
	{ label: 'Mi perfil', icon: 'fa-solid fa-user-pen', href: 'profile', color: 'from-violet-500 to-violet-700' },
	{ label: 'Documentos', icon: 'fa-solid fa-folder-open', href: 'history', color: 'from-orange-400 to-orange-600' },
	];
	const alerts = [
  { type: 'allergy', label: 'Penicilina', icon: 'fa-solid fa-triangle-exclamation', color: 'bg-red-100 text-error border-red-200' },
  { type: 'condition', label: 'Hipertensión', icon: 'fa-solid fa-heart-pulse', color: 'bg-yellow-100 text-yellow-800 border-yellow-200' },
];
const currentPath = Astro.url.pathname;

---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
			integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
		<ClientRouter />
	</head>
	<body
		class="bg-primary-100 font-sans antialiased relative overflow-x-hidden"
	>
		<div
			id="main-content"
			class="min-h-[calc(100vh-4rem)] flex flex-col lg:pl-64 transition-[padding] duration-300"
		>
			<Sidebar menuItems={menuItems} currentPath={currentPath} />
			<div class="flex-1 pb-16 lg:pb-0">
				<slot />
			</div>
		</div>

		<BottomNavbar />
	</body>
</html>

---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "@/components/astro/Sidebar.astro";
import MobileSidebarDrawer from "@/components/astro/MobileSidebarDrawer.astro";
import { FaCalendarDays, FaFileMedical, FaHouse, FaUserDoctor, FaUsers } from "react-icons/fa6";
const { title } = Astro.props;

const menuItems = [
	{
		label: "Dashboard General",
		href: "/modules/pacient/overview",
		icon: FaHouse,
	},
	{
		label: "Agendar cita",
		href: "/modules/pacient/schedule-appointment",
		icon: FaCalendarDays,
	},
	{
		label: "Historial clínico",
		href: "/modules/pacient/history",
		icon: FaFileMedical,
	},
	{
		label: "Perfil",
		href: "/modules/pacient/profile",
		icon: FaUserDoctor,
	}
];
const currentPath = Astro.url.pathname;

---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body
		class="bg-primary-100 font-sans antialiased relative overflow-x-hidden"
	>
		<div
			id="main-content"
			class="min-h-[calc(100vh-4rem)] flex flex-col lg:pl-64 transition-[padding] duration-300 pt-16 lg:pt-0"
		>
			<Sidebar menuItems={menuItems} currentPath={currentPath} />
			<div class="flex-1 pb-8 lg:pb-0">
				<slot />
			</div>
		</div>

		<MobileSidebarDrawer menuItems={menuItems} currentPath={currentPath} title="Paciente" />
	</body>
</html>

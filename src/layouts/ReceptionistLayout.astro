---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "@/components/astro/Sidebar.astro";
import MobileSidebarDrawer from "@/components/astro/MobileSidebarDrawer.astro";
import {
	FaCalendarCheck,
	FaCalendarDays,
	FaClock,
	FaCreditCard,
	FaFileInvoiceDollar,
	FaHouse,
	FaListCheck,
	FaUserPlus,
} from "react-icons/fa6";
const { title } = Astro.props;
const { receptionist_id } = Astro.params;

const menuItems = [
	{
		label: "Dashboard",
		href: `overview`,
		icon: FaHouse,
	},
	{
		label: "Citas",
		icon: FaCalendarDays,
		subItems: [
			{
				label: "Registro de citas",
				href: `appointments`,
				icon: FaListCheck,
			},
			{
				label: "Registrar paciente",
				href: `register-patient`,
				icon: FaUserPlus,
			},
		],
	},
	{
		label: "Facturas",
		href: `invoice`,
		icon: FaFileInvoiceDollar,
	},
	{
	icon: FaClock,
    label: 'Horarios',
    href: '#',
    subItems: [
	  { label: 'Vista global', href: `/modules/receptionist/${receptionist_id}/schedules`, icon: FaCalendarCheck },
	  { label: 'Configurar ciclos', href: `/modules/receptionist/${receptionist_id}/manage-schedules`, icon: FaClock },
    ]
  },
];

const currentPath = Astro.url.pathname;

---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body
		class="bg-primary-100 font-sans antialiased relative overflow-x-hidden"
	>
		<!-- Main Wrapper: Padded on left for desktop sidebar -->
		<div
			id="main-content"
			class="min-h-[calc(100vh-4rem)] flex flex-col lg:pl-64 transition-[padding] duration-300 pt-16 lg:pt-0"
		>
			<Sidebar menuItems={menuItems} currentPath={currentPath} />
			<div class="flex-1 pb-8 lg:pb-0">
				<!-- Bottom padding for mobile navbar -->
				<slot />
			</div>
		</div>

		<MobileSidebarDrawer menuItems={menuItems} currentPath={currentPath} title="Recepción" />
	</body>
</html>

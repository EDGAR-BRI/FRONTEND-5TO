---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "@/components/astro/Sidebar.astro";
import BottomNavbar from "@/components/astro/BottomNavbar.astro";
import { FaCalendarDays, FaHouse, FaUserDoctor } from "react-icons/fa6";
const { title } = Astro.props;

const menuItems = [
	{
		label: "Dashboard General",
		href: `overview`,
		icon: FaHouse,
	},
	{
		label: "Agendas",
		href: `schedule`,
		icon: FaCalendarDays,
	},
	{
		label: "Perfil",
		href: `profile`,
		icon: FaUserDoctor,
	},
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body
		class="bg-primary-100 font-sans antialiased relative overflow-x-hidden"
	>
		<!-- Main Wrapper: Padded on left for desktop sidebar -->
		<div
			id="main-content"
			class="min-h-[calc(100vh-4rem)] flex flex-col lg:pl-64 transition-[padding] duration-300"
		>
			<Sidebar menuItems={menuItems} currentPath={currentPath} />
			<div class="flex-1 pb-16 lg:pb-0">
				<!-- Bottom padding for mobile navbar -->
				<slot />
			</div>
		</div>

		<BottomNavbar />
	</body>
</html>

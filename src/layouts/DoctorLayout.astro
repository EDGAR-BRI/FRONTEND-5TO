---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "@/components/astro/Sidebar.astro";
import MobileSidebarDrawer from "@/components/astro/MobileSidebarDrawer.astro";
import { FaCalendarDays, FaHouse, FaUserDoctor, FaChartLine, FaUsers, FaFileMedical, FaStethoscope, FaDollarSign } from "react-icons/fa6";
const { title } = Astro.props;
const { doctor_id = "1" } = Astro.params;

const baseUrl = `/modules/doctor/${doctor_id}`;

const menuItems = [
	{
		label: "Dashboard General",
		href: `${baseUrl}/overview`,
		icon: FaHouse,
	},
	{
		label: "Agendas",
		href: `${baseUrl}/schedule`,
		icon: FaCalendarDays,
	},
	{
		label: "Pacientes",
		href: `${baseUrl}/patients`,
		icon: FaUsers,
	},
	{
		label: "Reportes",
		icon: FaChartLine,
		subItems: [
			// { label: "Clínicos", href: `${baseUrl}/reports/clinical`, icon: FaStethoscope },
			{ label: "Financieros", href: `${baseUrl}/reports/finance`, icon: FaDollarSign },
			{ label: "Citas", href: `${baseUrl}/reports/appointments`, icon: FaCalendarDays },
		]
	},
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body
		class="bg-primary-100 font-sans antialiased relative overflow-x-hidden"
	>
		<!-- Main Wrapper: Padded on left for desktop sidebar -->
		<div
			id="main-content"
			class="min-h-[calc(100vh-4rem)] flex flex-col lg:pl-75 lg:pr-8  transition-[padding] duration-300 pt-16 lg:pt-0"
		>
			<Sidebar menuItems={menuItems} currentPath={currentPath} />
			<div class="flex-1 pb-8 lg:pb-0">
				<!-- Bottom padding for mobile navbar -->
				<slot />
			</div>
		</div>

		<MobileSidebarDrawer menuItems={menuItems} currentPath={currentPath} title="Doctor" />
	</body>
</html>

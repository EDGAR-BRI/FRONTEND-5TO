{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],

  "compilerOptions": {
    "@/pages/*": ["src/pages/*"],
    "@/components/*": ["src/components/*"],
    "@/layouts/*": ["src/layouts/*"],
    "@/styles/*": ["src/styles/*"],
    "@/assets/*": ["src/assets/*"],
    "@/utils/*": ["src/utils/*"]
    
  }
}
